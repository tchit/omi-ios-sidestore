+import 'package:flutter/foundation.dart';
+
+import 'package:omi/backend/schema/bt_device/bt_device.dart';
+
+/// Plaud NotePin S (série 882) : reconnaissance, fiche et textes (2026-10-08).
+///
+/// Le NotePin S est lié à l'app Plaud. Son protocole (portVersion 20) exige un échange d'ouverture chiffré
+/// dont seuls les serveurs de Plaud délivrent le matériel ; il n'a répondu à aucune commande en clair du
+/// connecteur d'Omi (appareil de Mike, 2026-10-08). Omi ne s'y connecte donc pas et ne lui envoie rien.
+///
+/// Reconnaissance par le nom (« Plaud NotePin S - Find My » relevé sur l'iPhone de Mike) et, si le nom ne
+/// suffit pas, par la caractéristique « modèle » du service Localiser lue à la connexion (6AA50003 =
+/// « Plaud NotePin S » chez Mike). Les données fabricant 0x005D (numéro de série en 882, portVersion ≥ 20)
+/// ne sont pas utilisées : elles ne remontent pas jusqu'à Dart (BlePeripheral ne porte que uuid, nom, rssi et
+/// services) et leur décodage ne repose que sur un relevé tiers, avec deux lectures du numéro qui divergent.
+class PlaudNotePinS {
+  PlaudNotePinS._();
+
+  static const String modele = 'Plaud NotePin S';
+  static const String fabricant = 'PLAUD';
+
+  /// Valeur inconnue selon la convention de BtDevice (affichée « Inconnu » par l'app), plutôt qu'un « 1.0.0 »
+  /// écrit en dur : la version réelle n'est pas lisible sans l'échange chiffré.
+  static const String inconnu = 'Unknown';
+
+  /// Service « informations d'accessoire » du réseau Localiser : lecture seule, sans échange d'ouverture.
+  static const String serviceLocaliserUuid = '87290102-3c51-43b1-a1a9-11b9dc38478b';
+  static const String caracteristiqueModeleUuid = '6aa50003-6352-4d57-a7b4-003a416fbb0b';
+
+  // « NotePin S », « NotePin-S », « NOTEPINS »… mais ni « NotePin », ni « NOTEPIN-S12 » (suffixe d'un autre
+  // appareil), ni « NotePin Smart ».
+  static final RegExp _motif = RegExp(r'notepin[\s_\-]*s(?![a-z0-9])', caseSensitive: false);
+
+  /// Le texte (nom publié, modèle lu) désigne-t-il un NotePin S ?
+  static bool texteDesigne(String? texte) => texte != null && _motif.hasMatch(texte);
+
+  // Appareils reconnus par 6AA50003 alors que leur nom ne le disait pas : la connexion suivante est refusée
+  // sans repasser par une liaison radio (mémoire du processus seulement).
+  static final Set<String> _reconnus = <String>{};
+
+  static void memoriser(String identifiant) {
+    if (identifiant.isNotEmpty) _reconnus.add(identifiant);
+  }
+
+  @visibleForTesting
+  static void oublierTout() => _reconnus.clear();
+
+  static bool estNotePinS(BtDevice? appareil) {
+    if (appareil == null || appareil.type != DeviceType.plaud) return false;
+    return texteDesigne(appareil.name) || texteDesigne(appareil.modelNumber) || _reconnus.contains(appareil.id);
+  }
+
+  /// Fiche d'un NotePin S mémorisé : remplace le modèle et le firmware écrits en dur par l'ancien connecteur
+  /// (« PLAUD NotePin », « 1.0.0 »). Tout autre appareil est rendu tel quel.
+  static BtDevice ficheHonnete(BtDevice appareil) {
+    if (!estNotePinS(appareil)) return appareil;
+    return appareil.copyWith(
+      modelNumber: modele,
+      firmwareRevision: inconnu,
+      hardwareRevision: inconnu,
+      manufacturerName: fabricant,
+    );
+  }
+
+  /// Avertissement montré au choix de l'appareil (aucune connexion n'est tentée).
+  static const String titre = "Plaud NotePin S : lié à l'app Plaud";
+  static const String message = "Ce Plaud NotePin S est lié à l'app Plaud. Son Bluetooth exige un échange chiffré "
+      "propre à Plaud : Omi ne peut ni recevoir son son en direct ni relever ses enregistrements.\n\n"
+      "Omi ne s'y connecte donc pas et ne lui envoie rien.\n\n"
+      "Exportez les enregistrements depuis l'app Plaud. Pour enregistrer dans Omi, utilisez le micro de l'iPhone.";
+
+  /// Carte de la page de l'appareil, à la place de « non connecté ».
+  static const String titreFiche = "Lié à l'app Plaud";
+  static const String messageFiche = "Omi ne se connecte pas au NotePin S : son Bluetooth est chiffré et réservé à "
+      "l'app Plaud. Exportez les enregistrements depuis l'app Plaud ; pour enregistrer dans Omi, utilisez le micro "
+      "de l'iPhone.";
+}
