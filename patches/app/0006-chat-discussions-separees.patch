+
+/// What Past chats asks the chat to do once the sheet has closed.
+sealed class ChatHistoryChoice {
+  const ChatHistoryChoice();
+}
+
+class ChatHistoryNewChat extends ChatHistoryChoice {
+  const ChatHistoryNewChat();
+}
+
+class ChatHistoryOpenChat extends ChatHistoryChoice {
+  const ChatHistoryOpenChat(this.session);
+  final ChatSessionSummary session;
+}
+
+/// Opens Past chats. Reading the list never changes the open thread; only a choice does.
+Future<void> showChatHistory(BuildContext context, MessageProvider provider, {VoidCallback? onSwitched}) async {
+  final choice = await showOmiSheet<ChatHistoryChoice>(
+    context: context,
+    title: context.l10n.pastChats,
+    padding: EdgeInsets.zero,
+    builder: (_) => ChatHistoryList(provider: provider),
+  );
+  if (choice == null || !context.mounted) return;
+  await applyChatHistoryChoice(context, provider, choice, onSwitched: onSwitched);
+}
+
+/// Starts or opens a chat. A refused switch (a reply still streaming) says why; a failed read keeps
+/// the current thread and its draft.
+Future<void> applyChatHistoryChoice(BuildContext context, MessageProvider provider, ChatHistoryChoice choice,
+    {VoidCallback? onSwitched}) async {
+  final l10n = context.l10n;
+  if (!provider.canSwitchChat) {
+    OmiFeedback.info(context, l10n.chatSwitchBusy);
+    return;
+  }
+  OmiHaptics.selection();
+  final opened = switch (choice) {
+    ChatHistoryNewChat() => provider.startFreshChat(),
+    ChatHistoryOpenChat(:final session) => await provider.openChatSession(session),
+  };
+  if (opened) {
+    onSwitched?.call();
+  } else if (context.mounted) {
+    OmiFeedback.error(context, l10n.somethingWentWrong);
+  }
+}
+
+/// Namespace of the « Discussion d'origine » id (omi-local/insights_regles.py, ESPACE_ORIGINE). It is not an
+/// RFC 4122 variant, so the uuid package refuses it: the name-based id (Python's uuid5) is computed here.
+const _originChatNamespace = '6f6d692d636c6f6e652d6f726967696e';
+
+String _originChatId(String uid) {
+  final namespace = [
+    for (var i = 0; i < _originChatNamespace.length; i += 2) int.parse(_originChatNamespace.substring(i, i + 2), radix: 16)
+  ];
+  final hash = sha1.convert([...namespace, ...utf8.encode('discussion-origine:$uid')]).bytes.sublist(0, 16);
+  hash[6] = (hash[6] & 0x0f) | 0x50;
+  hash[8] = (hash[8] & 0x3f) | 0x80;
+  final hex = hash.map((b) => b.toRadixString(16).padLeft(2, '0')).join();
+  return '${hex.substring(0, 8)}-${hex.substring(8, 12)}-${hex.substring(12, 16)}-${hex.substring(16, 20)}-${hex.substring(20)}';
+}
+
+/// The « Discussion d'origine »: the former single chat thread, filed by the clone's migration under a
+/// fixed id per account (uuid5 of « discussion-origine:<uid> ») and that title. Deleting it removes the
+/// whole old thread, so its confirmation says so with the message count.
+bool isOriginChat(ChatSessionSummary session, {String? uid}) {
+  final owner = uid ?? SharedPreferencesUtil().uid;
+  if (owner.isNotEmpty && session.id == _originChatId(owner)) {
+    return true;
+  }
+  return session.title.trim() == "Discussion d'origine" || session.title.trim() == 'Discussion d’origine';
+}
+
+/// New chat first, then every saved chat newest first, grouped by day. Long-press deletes.
+class ChatHistoryList extends StatefulWidget {
+  const ChatHistoryList({super.key, required this.provider});
+  final MessageProvider provider;
+
+  @override
+  State<ChatHistoryList> createState() => _ChatHistoryListState();
+}
+
+class _ChatHistoryListState extends State<ChatHistoryList> {
+  static const _pageSize = 50;
+  final List<ChatSessionSummary> _sessions = [];
+  int _offset = 0;
+  bool _loading = true;
+  bool _hasMore = false;
+  ApiProblem? _problem;
+
+  MessageProvider get _provider => widget.provider;
+
+  @override
+  void initState() {
+    super.initState();
+    _load();
+  }
+
+  Future<void> _load() async {
+    setState(() {
+      _loading = true;
+      _problem = null;
+    });
+    final result = await _provider.chatSessionsApi.list(offset: _offset, limit: _pageSize);
+    if (!mounted) return;
+    setState(() {
+      _loading = false;
+      switch (result) {
+        case ApiSuccess(:final data, :final rejectedRows):
+          final known = _sessions.map((s) => s.id).toSet();
+          _sessions.addAll(data.where((s) => known.add(s.id)));
+          final received = data.length + rejectedRows;
+          _offset += received;
+          _hasMore = received == _pageSize;
+        case ApiFailure(:final problem):
+          _problem = problem;
+      }
+    });
+  }
+
+  String _title(BuildContext context, ChatSessionSummary session) =>
+      session.hasTitle ? session.title.trim() : context.l10n.untitledChat;
+
+  Future<void> _confirmDelete(ChatSessionSummary session) async {
+    final l10n = context.l10n;
+    final origin = isOriginChat(session);
+    final confirmed = await showOmiConfirm(
+      context,
+      title: origin ? l10n.deleteOriginChatQuestion : l10n.deleteChatQuestion,
+      message: origin ? l10n.deleteOriginChatMessage(session.messageCount) : l10n.deleteChatMessage,
+      confirmLabel: l10n.deleteChat,
+      destructive: true,
+    );
+    if (!confirmed || !mounted) return;
+    if (!_provider.canSwitchChat) {
+      OmiFeedback.info(context, l10n.chatSwitchBusy);
+      return;
+    }
+    final deleted = await _provider.deleteChatSession(session.id);
+    if (!mounted) return;
+    if (deleted) {
+      setState(() => _sessions.removeWhere((s) => s.id == session.id));
+    } else {
+      OmiFeedback.error(context, l10n.somethingWentWrong);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = context.l10n;
+    final maxHeight = MediaQuery.sizeOf(context).height * 0.72;
+    return ConstrainedBox(
+      constraints: BoxConstraints(maxHeight: maxHeight),
+      child: ListenableBuilder(
+        listenable: _provider,
+        builder: (context, _) {
+          final dates = OmiDateFormat.of(context);
+          final children = <Widget>[
+            _HistoryRow(
+              key: const Key('chat_history_new'),
+              icon: Icons.add_comment_outlined,
+              title: l10n.newChat,
+              subtitle: l10n.startFresh,
+              onTap: () => Navigator.of(context).pop(const ChatHistoryNewChat()),
+            ),
+          ];
+          // The server lists chats by their last message, newest first (its order is kept).
+          String? day;
+          for (final session in _sessions) {
+            final header = dates.dayHeader(session.updatedAt);
+            if (header != day) {
+              day = header;
+              children.add(Padding(
+                padding: const EdgeInsets.fromLTRB(OmiSpacing.md, OmiSpacing.md, OmiSpacing.md, OmiSpacing.xxs),
+                child: Text(header, style: OmiType.footnote.copyWith(color: OmiColors.textTertiary)),
+              ));
+            }
+            final title = _title(context, session);
+            children.add(_HistoryRow(
+              key: Key('chat_history_${session.id}'),
+              icon: Icons.chat_bubble_outline_rounded,
+              title: title,
+              subtitle: dates.time(session.updatedAt),
+              selected: session.id == _provider.chatSessionId && !_provider.isFreshChat,
+              onTap: () => Navigator.of(context).pop(ChatHistoryOpenChat(session)),
+              onLongPress: () => showOmiRowMenu(context, title: title, actions: [
+                OmiMenuAction(
+                  icon: Icons.delete_outline,
+                  label: l10n.deleteChat,
+                  isDestructive: true,
+                  onSelected: () => _confirmDelete(session),
+                ),
+              ]),
+            ));
+          }
+          if (_loading) {
+            children.add(const Padding(
+              padding: EdgeInsets.all(OmiSpacing.lg),
+              child: Center(child: OmiSpinner(size: OmiSpinnerSize.small)),
+            ));
+          } else if (_problem != null) {
+            children.add(OmiErrorState(message: l10n.somethingWentWrong, onRetry: _load));
+          } else if (_hasMore) {
+            children.add(TextButton(key: const Key('chat_history_more'), onPressed: _load, child: Text(l10n.showMore)));
+          } else if (_sessions.isEmpty) {
+            children.add(Padding(
+              padding: const EdgeInsets.all(OmiSpacing.lg),
+              child: Text(
+                l10n.noPastChats,
+                textAlign: TextAlign.center,
+                style: OmiType.footnote.copyWith(color: OmiColors.textTertiary),
+              ),
+            ));
+          }
+          return ListView(
+            shrinkWrap: true,
+            padding: const EdgeInsets.only(bottom: OmiSpacing.md),
+            children: children,
+          );
+        },
+      ),
+    );
+  }
+}
+
+class _HistoryRow extends StatelessWidget {
+  const _HistoryRow({
+    super.key,
+    required this.icon,
+    required this.title,
+    required this.subtitle,
+    required this.onTap,
+    this.onLongPress,
+    this.selected = false,
+  });
+
+  final IconData icon;
+  final String title;
+  final String subtitle;
+  final VoidCallback onTap;
+  final VoidCallback? onLongPress;
+  final bool selected;
+
+  @override
+  Widget build(BuildContext context) {
+    return Semantics(
+      button: true,
+      selected: selected,
+      child: InkWell(
+        onTap: onTap,
+        onLongPress: onLongPress,
+        child: ConstrainedBox(
+          constraints: const BoxConstraints(minHeight: 52),
+          child: Padding(
+            padding: const EdgeInsets.symmetric(horizontal: OmiSpacing.md, vertical: OmiSpacing.xs),
+            child: Row(children: [
+              ExcludeSemantics(child: Icon(icon, size: 20, color: OmiColors.textTertiary)),
+              const SizedBox(width: OmiSpacing.md),
+              Expanded(
+                child: Column(
+                  crossAxisAlignment: CrossAxisAlignment.start,
+                  mainAxisSize: MainAxisSize.min,
+                  children: [
+                    Text(title, maxLines: 2, overflow: TextOverflow.ellipsis, style: OmiType.callout),
+                    const SizedBox(height: 2),
+                    Text(subtitle, style: OmiType.footnote.copyWith(color: OmiColors.textTertiary)),
+                  ],
+                ),
+              ),
+              if (selected) ...[
+                const SizedBox(width: OmiSpacing.xs),
+                ExcludeSemantics(child: Icon(Icons.check_rounded, size: 20, color: OmiColors.textPrimary)),
+              ],
+            ]),
+          ),
+        ),
+      ),
+    );
+  }
+}
