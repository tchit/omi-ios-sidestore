+  Future<bool> openChatForConversation(String conversationId) async {
+    if (!canSwitchChat) return false;
+    final prefs = SharedPreferencesUtil();
+    final known = prefs.chatForConversation(conversationId);
+    if (known.isEmpty) return isFreshChat && messages.isEmpty ? true : startFreshChat();
+    if (known == chatSessionId && !isFreshChat && (appProvider?.selectedChatAppId ?? '').isEmpty) return true;
