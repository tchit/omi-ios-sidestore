+    final epoch = _historyEpoch;
+    isLoadingMessages = true;
+    historyProblem = null;
+    notifyListeners();
+    final found = await chatSessionsApi.get(known);
+    if (_historyDisposed) return false;
+    // Superseded by the reader's own later choice (New chat, Past chats, a send): that choice stands and
+    // already settled the loading state; there is nothing to open and nothing to report.
+    if (epoch != _historyEpoch) return true;
