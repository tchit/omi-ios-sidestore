+  /// The discussion last used to ask about each conversation (conversation id → session id), so
+  /// Ask Omi from a conversation resumes it instead of the open chat. Bounded, newest kept.
+  static const int _chatsByConversationMax = 200;
+
+  String chatForConversation(String conversationId) => _chatsByConversation()[conversationId] ?? '';
+
+  /// Records [sessionId] for [conversationId]; an empty [sessionId] forgets the conversation.
+  /// [onlyIfUnknown] keeps an existing entry (used when learning from older messages).
+  void setChatForConversation(String conversationId, String sessionId, {bool onlyIfUnknown = false}) {
+    if (conversationId.isEmpty) return;
+    final map = _chatsByConversation();
+    if (onlyIfUnknown && map.containsKey(conversationId)) return;
+    if (map[conversationId] == sessionId) return;
+    map.remove(conversationId);
+    if (sessionId.isNotEmpty) map[conversationId] = sessionId;
+    while (map.length > _chatsByConversationMax) {
+      map.remove(map.keys.first);
+    }
+    _saveOwnedChatValue('chatsByConversation', jsonEncode(map));
+  }
+
+  /// Forgets every conversation that pointed to [sessionId] (a deleted discussion).
+  void forgetChatForConversations(String sessionId) {
+    final map = _chatsByConversation();
+    final before = map.length;
+    map.removeWhere((_, value) => value == sessionId);
+    if (map.length != before) _saveOwnedChatValue('chatsByConversation', jsonEncode(map));
+  }
+
+  Map<String, String> _chatsByConversation() {
+    final raw = _ownedChatValue('chatsByConversation');
+    if (raw.isEmpty) return <String, String>{};
+    try {
+      final decoded = jsonDecode(raw);
+      if (decoded is! Map) return <String, String>{};
+      return {
+        for (final entry in decoded.entries)
+          if (entry.key is String && entry.value is String) entry.key as String: entry.value as String,
+      };
+    } catch (_) {
+      return <String, String>{};
+    }
+  }
+
+  // Chat thread choices belong to one account; another sign-in never inherits them.
+  String _ownedChatValue(String key) {
+    final raw = getString(key);
+    final owner = uid;
+    if (owner.isEmpty || !raw.startsWith('$owner|')) return '';
+    return raw.substring(owner.length + 1);
+  }
+
+  void _saveOwnedChatValue(String key, String value) {
+    final owner = uid;
+    if (owner.isEmpty) return;
+    saveString(key, '$owner|$value');
+  }
+
