@@ -0,0 +1,173 @@
+import 'package:flutter/material.dart';
+
+import 'package:provider/provider.dart';
+
+import 'package:omi/backend/schema/summary_version.dart';
+import 'package:omi/l10n/app_localizations.dart';
+import 'package:omi/pages/conversation_detail/conversation_detail_provider.dart';
+import 'package:omi/ui/ui.dart';
+import 'package:omi/utils/l10n_extensions.dart';
+import 'package:omi/widgets/extensions/string.dart';
+
+/// Le nom à montrer pour [choice] : notes d'Omi, ou le modèle de résumé (nom gardé, sinon catalogue de l'app).
+String summaryChoiceName(SummaryChoice choice, ConversationDetailProvider provider, AppLocalizations l10n) {
+  if (choice.kind == 'omi') return l10n.summaryVersionsOmiNotes;
+  final name = choice.appName ?? provider.findAppById(choice.appId)?.name;
+  return (name == null || name.trim().isEmpty) ? l10n.summaryVersionsUnknownApp : name.decodeString;
+}
+
+/// Quand : l'heure de production, ou « antérieur au … » pour un résumé d'avant l'historique.
+String? summaryChoiceWhen(SummaryChoice choice, OmiDateFormat dates, AppLocalizations l10n) {
+  final created = choice.createdAt;
+  if (created != null) return dates.timestamp(created.toLocal());
+  final recorded = choice.recordedAt;
+  if (recorded != null) return l10n.summaryVersionsBefore(dates.timestamp(recorded.toLocal()));
+  return null;
+}
+
+/// Ouvre le menu des résumés de la conversation ouverte. Rend la ligne choisie (null : menu fermé sans choix).
+Future<SummaryChoice?> showSummaryVersionsSheet(BuildContext context) {
+  return showOmiSheet<SummaryChoice>(
+    context: context,
+    title: context.l10n.summaryVersionsTitle,
+    padding: EdgeInsets.zero,
+    builder: (_) => const SummaryVersionsSheet(),
+  );
+}
+
+class SummaryVersionsSheet extends StatelessWidget {
+  const SummaryVersionsSheet({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    final dates = OmiDateFormat.of(context);
+    final l10n = context.l10n;
+    return Consumer<ConversationDetailProvider>(
+      builder: (context, provider, _) {
+        final choices = provider.summaryChoices();
+        final displayed = provider.displayedSummaryChoiceKey;
+        return ConstrainedBox(
+          constraints: BoxConstraints(maxHeight: MediaQuery.sizeOf(context).height * 0.7),
+          child: ListView.separated(
+            shrinkWrap: true,
+            itemCount: choices.length,
+            separatorBuilder: (_, __) =>
+                Divider(height: 1, thickness: 0.5, color: OmiColors.border, indent: 16, endIndent: 16),
+            itemBuilder: (context, index) {
+              final choice = choices[index];
+              final selected = choice.key == displayed;
+              final when = summaryChoiceWhen(choice, dates, l10n);
+              final details = [if (when != null) when, if (choice.isCurrent) l10n.summaryVersionsCurrent].join(' · ');
+              final preview = choice.content.replaceAll(RegExp(r'[#*_>`]'), '').replaceAll(RegExp(r'\s+'), ' ').trim();
+              return ListTile(
+                key: Key('summary_choice_${choice.key}'),
+                contentPadding: const EdgeInsets.symmetric(horizontal: 16, vertical: 2),
+                title: Text(
+                  summaryChoiceName(choice, provider, l10n),
+                  style: OmiType.callout.copyWith(fontWeight: selected ? FontWeight.w600 : FontWeight.w500),
+                ),
+                subtitle: Column(
+                  crossAxisAlignment: CrossAxisAlignment.start,
+                  children: [
+                    if (details.isNotEmpty)
+                      Text(details, style: OmiType.footnote.copyWith(color: OmiColors.textSecondary)),
+                    Text(
+                      preview,
+                      maxLines: 2,
+                      overflow: TextOverflow.ellipsis,
+                      style: OmiType.footnote.copyWith(color: OmiColors.textTertiary),
+                    ),
+                  ],
+                ),
+                trailing: selected ? Icon(Icons.check_rounded, color: OmiColors.textPrimary, size: 20) : null,
+                selected: selected,
+                onTap: () {
+                  OmiHaptics.selection();
+                  provider.selectSummaryChoice(choice);
+                  Navigator.of(context).pop(choice);
+                },
+              );
+            },
+          ),
+        );
+      },
+    );
+  }
+}
+
+/// La flèche à côté de « Résumé » : visible dès qu'il y a plus d'un résumé à lire, ou une seule version gardée
+/// quand le résumé actuel est vide (jamais de version inatteignable). [onChosen] : une ligne a été choisie dans le
+/// menu (l'onglet Résumé s'affiche alors, même si la flèche a été touchée depuis Transcription).
+class SummaryVersionsArrow extends StatelessWidget {
+  const SummaryVersionsArrow({super.key, this.onChosen});
+
+  final VoidCallback? onChosen;
+
+  /// Le menu a quelque chose à offrir que l'onglet ne montre pas déjà.
+  static bool hasChoices(List<SummaryChoice> choices) =>
+      choices.length > 1 || choices.any((choice) => !choice.isCurrent);
+
+  @override
+  Widget build(BuildContext context) {
+    final visible = context.select<ConversationDetailProvider, bool>(
+      (provider) => hasChoices(provider.summaryChoices()),
+    );
+    if (!visible) return const SizedBox.shrink();
+    return Semantics(
+      button: true,
+      label: context.l10n.summaryVersionsOpen,
+      excludeSemantics: true,
+      child: GestureDetector(
+        key: const Key('conversation_summary_versions'),
+        behavior: HitTestBehavior.opaque,
+        onTap: () async {
+          OmiHaptics.selection();
+          final chosen = await showSummaryVersionsSheet(context);
+          if (chosen != null) onChosen?.call();
+        },
+        child: const Padding(
+          padding: EdgeInsetsDirectional.only(start: 2, end: 6, top: 10, bottom: 10),
+          child: Icon(Icons.keyboard_arrow_down_rounded, size: 20),
+        ),
+      ),
+    );
+  }
+}
+
+/// Au-dessus d'un résumé choisi dans le menu : lequel, quand, et le retour à l'actuel.
+class SummaryVersionBanner extends StatelessWidget {
+  const SummaryVersionBanner({super.key, required this.choice});
+
+  final SummaryChoice choice;
+
+  @override
+  Widget build(BuildContext context) {
+    final provider = context.read<ConversationDetailProvider>();
+    final l10n = context.l10n;
+    final when = summaryChoiceWhen(choice, OmiDateFormat.of(context), l10n);
+    final label = [summaryChoiceName(choice, provider, l10n), if (when != null) when].join(' · ');
+    return Padding(
+      padding: const EdgeInsets.only(top: OmiSpacing.xs, bottom: OmiSpacing.sm),
+      child: Row(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Expanded(
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                Text(label, style: OmiType.footnote.copyWith(fontWeight: FontWeight.w600)),
+                if (!choice.isCurrent)
+                  Text(l10n.summaryVersionsReadOnly, style: OmiType.footnote.copyWith(color: OmiColors.textTertiary)),
+              ],
+            ),
+          ),
+          OmiButton.tertiary(
+            label: l10n.summaryVersionsBackToCurrent,
+            size: OmiButtonSize.compact,
+            onPressed: () => provider.clearSummaryChoice(),
+          ),
+        ],
+      ),
+    );
+  }
+}
