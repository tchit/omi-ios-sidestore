diff --git a/app/lib/backend/schema/summary_version.dart b/app/lib/backend/schema/summary_version.dart
new file mode 100644
index 0000000000..c2d946d13d
--- /dev/null
+++ b/app/lib/backend/schema/summary_version.dart
@@ -0,0 +1,205 @@
+/// Clone local : les résumés gardés d'une conversation (`summary_history` côté serveur).
+///
+/// Changer de modèle de résumé ou retraiter remplaçait l'ancien résumé ; le serveur les garde maintenant
+/// tous, et l'app laisse choisir lequel lire depuis la flèche à côté de « Résumé ». Fichier en Dart pur (sans
+/// Flutter) pour être testé seul.
+class SummaryVersion {
+  final String id;
+
+  /// `omi` (notes d'Omi) ou `app` (un modèle de résumé).
+  final String kind;
+  final String? appId;
+  final String? appName;
+  final String? title;
+  final String content;
+
+  /// Heure de production ; null pour un résumé produit avant l'historique (archivé à [recordedAt]).
+  final DateTime? createdAt;
+  final DateTime recordedAt;
+
+  const SummaryVersion({
+    required this.id,
+    required this.kind,
+    required this.content,
+    required this.recordedAt,
+    this.appId,
+    this.appName,
+    this.title,
+    this.createdAt,
+  });
+
+  /// Null pour une entrée illisible : un historique abîmé ne doit jamais empêcher d'ouvrir la conversation.
+  static SummaryVersion? tryParse(Object? json) {
+    if (json is! Map) return null;
+    final id = json['id'];
+    final kind = json['kind'];
+    final content = json['content'];
+    final recordedAt = _date(json['recorded_at']);
+    if (id is! String || (kind != 'omi' && kind != 'app') || content is! String || recordedAt == null) {
+      return null;
+    }
+    return SummaryVersion(
+      id: id,
+      kind: kind as String,
+      content: content,
+      recordedAt: recordedAt,
+      appId: json['app_id'] is String ? json['app_id'] as String : null,
+      appName: json['app_name'] is String ? json['app_name'] as String : null,
+      title: json['title'] is String ? json['title'] as String : null,
+      createdAt: _date(json['created_at']),
+    );
+  }
+
+  static List<SummaryVersion> parseList(Object? json) {
+    if (json is! List) return const [];
+    return json.map(tryParse).whereType<SummaryVersion>().toList();
+  }
+
+  Map<String, dynamic> toJson() => {
+    'id': id,
+    'kind': kind,
+    'app_id': appId,
+    'app_name': appName,
+    'title': title,
+    'content': content,
+    'created_at': createdAt?.toUtc().toIso8601String(),
+    'recorded_at': recordedAt.toUtc().toIso8601String(),
+  };
+
+  static DateTime? _date(Object? value) => value is String ? DateTime.tryParse(value) : null;
+}
+
+enum SummaryChoiceSource { currentApp, currentOmi, history }
+
+/// Une ligne du menu des résumés : un résumé actuel de la conversation ou une version gardée.
+class SummaryChoice {
+  final String key;
+  final SummaryChoiceSource source;
+
+  /// `omi` ou `app`.
+  final String kind;
+  final String? appId;
+  final String? appName;
+  final String? title;
+  final String content;
+
+  /// Heure de production quand elle est connue.
+  final DateTime? createdAt;
+
+  /// Pour une version gardée : quand elle est entrée dans l'historique.
+  final DateTime? recordedAt;
+
+  /// Pour un résultat d'app actuel : sa place dans `apps_results`.
+  final int? resultIndex;
+
+  const SummaryChoice({
+    required this.key,
+    required this.source,
+    required this.kind,
+    required this.content,
+    this.appId,
+    this.appName,
+    this.title,
+    this.createdAt,
+    this.recordedAt,
+    this.resultIndex,
+  });
+
+  bool get isCurrent => source != SummaryChoiceSource.history;
+}
+
+const String currentOmiChoiceKey = 'current:omi';
+String currentAppChoiceKey(int index) => 'current:app:$index';
+String historyChoiceKey(String id) => 'version:$id';
+
+/// Le menu : d'abord les résumés actuels dans l'ordre où l'app les préfère (résultat d'app, puis notes d'Omi),
+/// puis les versions gardées, de la plus récente à la plus ancienne. Une version identique à un résumé actuel
+/// n'est pas répétée : elle lui donne seulement son heure de production.
+List<SummaryChoice> buildSummaryChoices({
+  required List<({String? appId, String content})> currentAppResults,
+  required String currentOmiNotes,
+  String? currentTitle,
+  required List<SummaryVersion> history,
+}) {
+  String id(String kind, String? appId, String content) => '$kind\u0000${appId ?? ''}\u0000${content.trim()}';
+  final historyById = <String, SummaryVersion>{};
+  for (final version in history) {
+    historyById.putIfAbsent(id(version.kind, version.appId, version.content), () => version);
+  }
+
+  final choices = <SummaryChoice>[];
+  final currentIds = <String>{};
+  for (var index = 0; index < currentAppResults.length; index++) {
+    final result = currentAppResults[index];
+    final content = result.content.trim();
+    if (content.isEmpty) continue;
+    final key = id('app', result.appId, content);
+    if (!currentIds.add(key)) continue;
+    final known = historyById[key];
+    choices.add(
+      SummaryChoice(
+        key: currentAppChoiceKey(index),
+        source: SummaryChoiceSource.currentApp,
+        kind: 'app',
+        appId: result.appId,
+        appName: known?.appName,
+        content: content,
+        createdAt: known?.createdAt,
+        resultIndex: index,
+      ),
+    );
+  }
+  final notes = currentOmiNotes.trim();
+  if (notes.isNotEmpty) {
+    final key = id('omi', null, notes);
+    currentIds.add(key);
+    choices.add(
+      SummaryChoice(
+        key: currentOmiChoiceKey,
+        source: SummaryChoiceSource.currentOmi,
+        kind: 'omi',
+        title: currentTitle,
+        content: notes,
+        createdAt: historyById[key]?.createdAt,
+      ),
+    );
+  }
+
+  // Le serveur range l'historique du plus ancien au plus récent ; à heure égale (un résumé archivé et celui qui
+  // le remplace sont inscrits ensemble), cet ordre départage.
+  final kept = <({int order, SummaryVersion version})>[];
+  for (var order = 0; order < history.length; order++) {
+    final version = history[order];
+    final key = id(version.kind, version.appId, version.content);
+    if (version.content.trim().isNotEmpty && currentIds.add(key)) kept.add((order: order, version: version));
+  }
+  kept.sort((a, b) {
+    final byTime = (b.version.createdAt ?? b.version.recordedAt).compareTo(a.version.createdAt ?? a.version.recordedAt);
+    return byTime != 0 ? byTime : b.order.compareTo(a.order);
+  });
+  for (final entry in kept) {
+    final version = entry.version;
+    choices.add(
+      SummaryChoice(
+        key: historyChoiceKey(version.id),
+        source: SummaryChoiceSource.history,
+        kind: version.kind,
+        appId: version.appId,
+        appName: version.appName,
+        title: version.title,
+        content: version.content.trim(),
+        createdAt: version.createdAt,
+        recordedAt: version.recordedAt,
+      ),
+    );
+  }
+  return choices;
+}
+
+/// Clone local : [json] avec le `summary_history` de [raw] (la même conversation lue telle que le serveur l'a
+/// envoyée), quand un passage par le schéma généré l'a perdu. Une ligne brute d'une autre conversation ne
+/// donne rien.
+Map<String, dynamic> withSummaryHistory(Map<String, dynamic> json, Object? raw) {
+  if (raw is! Map || raw['id'] != json['id'] || raw['summary_history'] is! List) return json;
+  return {...json, 'summary_history': raw['summary_history']};
+}
