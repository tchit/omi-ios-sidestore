+// Clone local : choisir un résumé gardé depuis l'onglet Transcription affiche l'onglet Résumé (0007).
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:provider/provider.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+import 'package:omi/backend/preferences.dart';
+import 'package:omi/backend/schema/conversation.dart';
+import 'package:omi/backend/schema/structured.dart';
+import 'package:omi/backend/schema/summary_version.dart';
+import 'package:omi/l10n/app_localizations.dart';
+import 'package:omi/pages/conversation_detail/conversation_detail_provider.dart';
+import 'package:omi/pages/conversation_detail/widgets/conversation_detail_tabs.dart';
+import 'package:omi/providers/conversation_provider.dart';
+
+ServerConversation _conversation({String overview = 'Les notes d’Omi actuelles.'}) => ServerConversation(
+      id: 'conv-1',
+      createdAt: DateTime(2026, 10, 9, 9).toUtc(),
+      structured: Structured('Point avec Arnaud', overview),
+      summaryHistory: [
+        SummaryVersion(
+          id: 'v1',
+          kind: 'app',
+          appId: 'meeting-notes',
+          appName: 'Compte rendu de réunion',
+          content: 'Le compte rendu demandé hier.',
+          createdAt: DateTime.utc(2026, 10, 8, 18),
+          recordedAt: DateTime.utc(2026, 10, 9, 8),
+        ),
+      ],
+    );
+
+class _Host extends StatefulWidget {
+  const _Host({required this.taps});
+  final List<int> taps;
+
+  @override
+  State<_Host> createState() => _HostState();
+}
+
+class _HostState extends State<_Host> with SingleTickerProviderStateMixin {
+  late final TabController controller = TabController(length: 2, vsync: this, initialIndex: 1);
+
+  @override
+  void dispose() {
+    controller.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) => Scaffold(
+        body: Column(children: [
+          ConversationDetailTabs(controller: controller, onTap: widget.taps.add),
+          Expanded(
+            child: TabBarView(controller: controller, children: const [Text('summary page'), Text('transcript page')]),
+          ),
+        ]),
+      );
+}
+
+void main() {
+  setUp(() async {
+    SharedPreferences.setMockInitialValues({});
+    await SharedPreferencesUtil.init();
+  });
+
+  Future<(ConversationDetailProvider, List<int>)> pump(WidgetTester tester,
+      {Locale locale = const Locale('en'), ServerConversation? conversation}) async {
+    final provider = ConversationDetailProvider();
+    addTearDown(provider.dispose);
+    conversation ??= _conversation();
+    provider.selectedDate = conversationLocalDayKey(conversation.createdAt);
+    provider.setCachedConversation(conversation);
+    final taps = <int>[];
+    await tester.pumpWidget(ChangeNotifierProvider<ConversationDetailProvider>.value(
+      value: provider,
+      child: MaterialApp(
+        localizationsDelegates: AppLocalizations.localizationsDelegates,
+        supportedLocales: AppLocalizations.supportedLocales,
+        locale: locale,
+        home: _Host(taps: taps),
+      ),
+    ));
+    await tester.pumpAndSettle();
+    return (provider, taps);
+  }
+
+  TabController controllerOf(WidgetTester tester) => tester.state<_HostState>(find.byType(_Host)).controller;
+
+  testWidgets('choosing a kept summary from the Transcript tab shows it in the Summary tab', (tester) async {
+    final (provider, taps) = await pump(tester);
+    expect(find.text('transcript page'), findsOneWidget);
+    await tester.tap(find.byKey(const Key('conversation_summary_versions')));
+    await tester.pumpAndSettle();
+    expect(find.text('Summaries'), findsOneWidget);
+    await tester.tap(find.byKey(Key('summary_choice_${historyChoiceKey('v1')}')));
+    await tester.pumpAndSettle();
+    expect(controllerOf(tester).index, 0);
+    expect(taps, [0], reason: 'counts as an explicit tab choice, so no automatic switch overrides it');
+    expect(find.text('summary page'), findsOneWidget);
+    expect(provider.getSummarySelection().isArchived, isTrue);
+    expect(provider.getSummarySelection().content, 'Le compte rendu demandé hier.');
+  });
+
+  testWidgets('closing the menu without a choice stays on Transcript', (tester) async {
+    final (provider, taps) = await pump(tester);
+    await tester.tap(find.byKey(const Key('conversation_summary_versions')));
+    await tester.pumpAndSettle();
+    await tester.tapAt(const Offset(5, 5));
+    await tester.pumpAndSettle();
+    expect(controllerOf(tester).index, 1);
+    expect(taps, isEmpty);
+    expect(provider.getSummarySelection().isArchived, isFalse);
+  });
+
+  testWidgets('the menu speaks French', (tester) async {
+    await pump(tester, locale: const Locale('fr'));
+    expect(find.byWidgetPredicate((w) => w is Semantics && w.properties.label == 'Choisir un résumé'), findsOneWidget);
+    await tester.tap(find.byKey(const Key('conversation_summary_versions')));
+    await tester.pumpAndSettle();
+    expect(find.text('Résumés'), findsOneWidget);
+    expect(find.text('Notes d’Omi'), findsOneWidget);
+    expect(find.text('Compte rendu de réunion'), findsOneWidget);
+  });
+
+  testWidgets('an empty current summary with a single kept version still offers the arrow (never unreachable)',
+      (tester) async {
+    final (provider, _) = await pump(tester, conversation: _conversation(overview: ''));
+    expect(provider.summaryChoices(), hasLength(1));
+    expect(find.byKey(const Key('conversation_summary_versions')), findsOneWidget);
+    await tester.tap(find.byKey(const Key('conversation_summary_versions')));
+    await tester.pumpAndSettle();
+    await tester.tap(find.byKey(Key('summary_choice_${historyChoiceKey('v1')}')));
+    await tester.pumpAndSettle();
+    expect(provider.getSummarySelection().content, 'Le compte rendu demandé hier.');
+  });
+
+  testWidgets('a single current summary and nothing kept: no arrow', (tester) async {
+    final provider = ConversationDetailProvider();
+    addTearDown(provider.dispose);
+    final conversation = ServerConversation(
+        id: 'conv-2',
+        createdAt: DateTime(2026, 10, 9, 9).toUtc(),
+        structured: Structured('Seul', 'Les notes.'));
+    provider.selectedDate = conversationLocalDayKey(conversation.createdAt);
+    provider.setCachedConversation(conversation);
+    final taps = <int>[];
+    await tester.pumpWidget(ChangeNotifierProvider<ConversationDetailProvider>.value(
+      value: provider,
+      child: MaterialApp(
+        localizationsDelegates: AppLocalizations.localizationsDelegates,
+        supportedLocales: AppLocalizations.supportedLocales,
+        home: _Host(taps: taps),
+      ),
+    ));
+    await tester.pumpAndSettle();
+    expect(find.byKey(const Key('conversation_summary_versions')), findsNothing);
+  });
+}
