@@ -0,0 +1,136 @@
+// Clone local : menu des résumés (actuels + versions gardées par le serveur dans summary_history).
+import 'package:flutter_test/flutter_test.dart';
+
+import 'package:omi/backend/schema/summary_version.dart';
+
+SummaryVersion version(
+  String id,
+  String kind,
+  String content, {
+  String? appId,
+  String? appName,
+  DateTime? createdAt,
+  required DateTime recordedAt,
+}) {
+  return SummaryVersion(
+    id: id,
+    kind: kind,
+    content: content,
+    appId: appId,
+    appName: appName,
+    createdAt: createdAt,
+    recordedAt: recordedAt,
+  );
+}
+
+void main() {
+  final t1 = DateTime.utc(2026, 10, 9, 8);
+  final t2 = DateTime.utc(2026, 10, 9, 9);
+  final t3 = DateTime.utc(2026, 10, 9, 10);
+
+  group('SummaryVersion.parseList', () {
+    test('reads the server shape and skips unreadable entries', () {
+      final parsed = SummaryVersion.parseList([
+        {
+          'id': 'a',
+          'kind': 'app',
+          'app_id': 'x',
+          'app_name': 'Modèle X',
+          'content': 'Résumé',
+          'created_at': '2026-10-09T08:00:00Z',
+          'recorded_at': '2026-10-09T08:00:00Z',
+        },
+        {'id': 'b', 'kind': 'omi', 'content': 'Notes', 'created_at': null, 'recorded_at': '2026-10-09T09:00:00Z'},
+        {'id': 'c', 'kind': 'autre', 'content': 'x', 'recorded_at': '2026-10-09T09:00:00Z'},
+        {'id': 'd', 'kind': 'app', 'content': 'sans date'},
+        'abîmé',
+      ]);
+      expect(parsed.map((v) => v.id), ['a', 'b']);
+      expect(parsed.first.appName, 'Modèle X');
+      expect(parsed.first.createdAt, t1);
+      expect(parsed.last.createdAt, isNull);
+      expect(SummaryVersion.parseList(null), isEmpty);
+      expect(SummaryVersion.parseList({'id': 'a'}), isEmpty);
+    });
+
+    test('round-trips through toJson (local cache)', () {
+      final original = version('a', 'app', 'R', appId: 'x', createdAt: t1, recordedAt: t2);
+      final again = SummaryVersion.tryParse(original.toJson())!;
+      expect([again.id, again.kind, again.appId, again.content], ['a', 'app', 'x', 'R']);
+      expect(again.createdAt, t1);
+      expect(again.recordedAt, t2);
+    });
+  });
+
+  group('buildSummaryChoices', () {
+    test('current app result first, then Omi notes, then kept versions newest first', () {
+      final choices = buildSummaryChoices(
+        currentAppResults: [(appId: 'b', content: 'Résumé B')],
+        currentOmiNotes: 'Notes',
+        currentTitle: 'Courses',
+        history: [
+          version('1', 'app', 'Résumé A', appId: 'a', recordedAt: t1),
+          version('2', 'app', 'Résumé C', appId: 'c', createdAt: t2, recordedAt: t2),
+          version('3', 'app', 'Résumé B', appId: 'b', appName: 'Modèle B', createdAt: t3, recordedAt: t3),
+        ],
+      );
+      expect(choices.map((c) => c.key), ['current:app:0', 'current:omi', 'version:2', 'version:1']);
+      // Le résumé actuel garde son heure de production et son nom grâce à l'historique.
+      expect(choices.first.createdAt, t3);
+      expect(choices.first.appName, 'Modèle B');
+      expect(choices.first.isCurrent, isTrue);
+      expect(choices[2].isCurrent, isFalse);
+    });
+
+    test('an archived summary and its replacement recorded together keep their order', () {
+      final choices = buildSummaryChoices(
+        currentAppResults: const [],
+        currentOmiNotes: 'Notes',
+        history: [
+          version('old', 'app', 'Ancien', appId: 'a', recordedAt: t2),
+          version('new', 'app', 'Nouveau', appId: 'b', createdAt: t2, recordedAt: t2),
+        ],
+      );
+      expect(choices.map((c) => c.key), ['current:omi', 'version:new', 'version:old']);
+    });
+
+    test('a single summary gives a single choice (no arrow)', () {
+      final choices = buildSummaryChoices(
+        currentAppResults: [(appId: 'a', content: '  ')],
+        currentOmiNotes: 'Notes',
+        history: [version('1', 'omi', ' Notes ', createdAt: t1, recordedAt: t1)],
+      );
+      expect(choices.map((c) => c.key), ['current:omi']);
+      expect(choices.single.createdAt, t1);
+    });
+
+    test('same text from another model stays a separate choice', () {
+      final choices = buildSummaryChoices(
+        currentAppResults: [(appId: 'a', content: 'Pareil')],
+        currentOmiNotes: '',
+        history: [version('1', 'app', 'Pareil', appId: 'b', recordedAt: t1)],
+      );
+      expect(choices.map((c) => c.key), ['current:app:0', 'version:1']);
+    });
+  });
+
+  group('withSummaryHistory (recherche)', () {
+    final history = [
+      {'id': 'a', 'kind': 'omi', 'content': 'Notes', 'recorded_at': '2026-10-09T08:00:00Z'}
+    ];
+
+    test('takes the kept summaries back from the raw search row of the same conversation', () {
+      final json = withSummaryHistory({'id': 'c1', 'title': 'x'}, {'id': 'c1', 'summary_history': history});
+      expect(json['summary_history'], history);
+      expect(json['title'], 'x');
+    });
+
+    test('ignores another conversation, a missing history and an unreadable row', () {
+      final json = {'id': 'c1'};
+      expect(withSummaryHistory(json, {'id': 'c2', 'summary_history': history}), same(json));
+      expect(withSummaryHistory(json, {'id': 'c1'}), same(json));
+      expect(withSummaryHistory(json, {'id': 'c1', 'summary_history': 'broken'}), same(json));
+      expect(withSummaryHistory(json, null), same(json));
+    });
+  });
+}
