+                ],
+              ),
+            ],
+            'besoins': [],
+            'propositions_possibles': [
+              _element('e2', 'Proposer un essai de deux semaines.', origin: 'omi', quote: 'un essai de deux semaines'),
+            ],
+            'a_suivre': [],
+          },
+        _ => {
+            'ce_qui_s_est_passe': [_element('f1', 'On a parlé de l’école calmement.')],
+            'ce_qui_a_marche': [],
+            'la_prochaine_fois': [],
+          },
+      };
+
+  static const _labels = {
+    'angles': 'angles',
+    'besoins': 'besoins',
+    'propositions_possibles': 'propositions possibles',
+    'a_suivre': 'à suivre',
+    'ce_qui_s_est_passe': "ce qui s'est passé",
+    'ce_qui_a_marche': 'ce qui a marché',
+    'la_prochaine_fois': 'la prochaine fois',
+  };
+
+  Map<String, dynamic> _resume(String id) {
+    final count = _sections(id).values.expand((e) => e).where((e) => !removedElements.contains(e['id'])).length;
+    return {
+      'id': id,
+      'titre': id == 'arnaud' ? 'Arnaud' : 'Mon fils',
+      'gabarit': id == 'arnaud' ? 'pro' : 'proche',
+      'alias': [],
+      'statut': archived.contains(id) ? 'archive' : 'actif',
+      'version': 3,
+      'maj': id == 'arnaud' ? '2026-10-09T18:30:00+00:00' : '2026-10-02T08:00:00+00:00',
+      'nb_elements': count,
+    };
+  }
+
+  Map<String, dynamic> _detail(String id) => {
+        ..._resume(id),
+        'sections': [
+          for (final entry in _sections(id).entries)
+            {
+              'cle': entry.key,
+              'nom': _labels[entry.key],
+              'elements': entry.value.where((e) => !removedElements.contains(e['id'])).toList(),
+            },
+        ],
+      };
+
+  static http.Response _json(Object body, [int status = 200]) =>
+      http.Response(jsonEncode(body), status, headers: {'content-type': 'application/json; charset=utf-8'});
+
+  Future<http.Response> send(ApiRequest request) async {
+    requests.add(request);
+    final segments = Uri.parse(request.url).pathSegments;
+    if (request.method == 'GET' && segments.length == 3) {
+      if (failList) return _json({'detail': 'boom'}, 500);
+      return _json({
+        'dossiers': [
+          for (final id in ['arnaud', 'fils'])
+            if (!archived.contains(id)) _resume(id)
+        ],
+      });
+    }
+    final id = segments[3];
+    if (request.method == 'GET') return _json(_detail(id));
+    if (request.method == 'DELETE' && segments.length == 6) {
+      if (goneElements.contains(segments[5])) return _json({'detail': 'Element not found'}, 404);
+      removedElements.add(segments[5]);
+      return _json({'status': 'ok', 'deja_retire': false, 'dossier': _detail(id)});
+    }
+    if (request.method == 'DELETE') {
+      archived.add(id);
+      return _json({'status': 'ok', 'deja_retire': false, 'dossier': _resume(id)});
+    }
+    return _json({'detail': 'Not Found'}, 404);
+  }
+}
