diff --git a/app/lib/pages/insights/insight_dossier_page.dart b/app/lib/pages/insights/insight_dossier_page.dart
new file mode 100644
index 0000000000..f7b0d2d475
--- /dev/null
+++ b/app/lib/pages/insights/insight_dossier_page.dart
@@ -0,0 +1,433 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+
+import 'package:omi/backend/http/api/insights.dart';
+import 'package:omi/backend/http/api_result.dart';
+import 'package:omi/backend/schema/insight_dossier.dart';
+import 'package:omi/pages/insights/insight_labels.dart';
+import 'package:omi/pages/insights/insight_sources.dart';
+import 'package:omi/ui/ui.dart';
+import 'package:omi/utils/l10n_extensions.dart';
+
+/// Clone local : appui long sur un dossier (ligne de la liste ou en-tête du dossier) : « Retirer », confirmé,
+/// puis retiré sur le serveur (archivé, sujet refusé). Vrai quand le dossier est retiré.
+Future<bool> showInsightDossierMenu(BuildContext context, InsightsApi api, InsightDossierSummary dossier) async {
+  final removed = Completer<bool>();
+  await showOmiRowMenu(context, title: dossier.title, actions: [
+    OmiMenuAction(
+      icon: Icons.remove_circle_outline_rounded,
+      label: context.l10n.insightRemove,
+      isDestructive: true,
+      onSelected: () => removed.complete(_confirmRemoveDossier(context, api, dossier)),
+    ),
+  ]);
+  return removed.isCompleted ? await removed.future : false;
+}
+
+Future<bool> _confirmRemoveDossier(BuildContext context, InsightsApi api, InsightDossierSummary dossier) async {
+  final l10n = context.l10n;
+  final confirmed = await showOmiConfirm(
+    context,
+    title: l10n.insightRemoveDossierQuestion,
+    message: l10n.insightRemoveDossierMessage,
+    confirmLabel: l10n.insightRemove,
+    destructive: true,
+  );
+  if (!confirmed || !context.mounted) return false;
+  final result = await api.removeDossier(dossier.id);
+  if (!context.mounted) return false;
+  // Déjà retiré ailleurs (404 ou deja_retire) : il n'a plus sa place dans la liste non plus.
+  final removed = switch (result) {
+    ApiSuccess() => true,
+    ApiFailure(:final problem) => problem.kind == ApiProblemKind.notFound,
+  };
+  if (removed) {
+    OmiHaptics.success();
+    OmiFeedback.confirm(context, l10n.insightRemoved);
+  } else {
+    OmiFeedback.error(context, l10n.somethingWentWrong);
+  }
+  return removed;
+}
+
+/// Clone local : un dossier d'Insights en entier. Les sections du gabarit dans l'ordre (même vides), chaque
+/// élément avec sa citation exacte, la « piste d'Omi » marquée par un libellé, et ses sources (la discussion du
+/// chat, les conversations citées) ouvrables. Appui long : retirer un élément ou le dossier. Aucun bouton
+/// « Garder » : Omi décide seul de ce qui entre.
+class InsightDossierPage extends StatefulWidget {
+  const InsightDossierPage({super.key, required this.summary, this.api, this.sources = const InsightSourceOpener()});
+
+  /// La ligne de la liste : titre affiché pendant le chargement.
+  final InsightDossierSummary summary;
+  final InsightsApi? api;
+  final InsightSourceOpener sources;
+
+  @override
+  State<InsightDossierPage> createState() => _InsightDossierPageState();
+}
+
+class _InsightDossierPageState extends State<InsightDossierPage> {
+  late final InsightsApi _api = widget.api ?? InsightsApi();
+  InsightDossier? _dossier;
+  ApiProblem? _problem;
+
+  @override
+  void initState() {
+    super.initState();
+    unawaited(_load());
+  }
+
+  /// [reportFailure] : tirer pour rafraîchir dit qu'une relecture a échoué (le dossier affiché reste).
+  Future<void> _load({bool reportFailure = false}) async {
+    final result = await _api.get(widget.summary.id);
+    if (!mounted) return;
+    final shown = _dossier != null;
+    setState(() {
+      switch (result) {
+        case ApiSuccess(:final data):
+          _dossier = data;
+          _problem = null;
+        case ApiFailure(:final problem):
+          // Un dossier retiré entre-temps ne se montre plus ; une autre panne garde ce qui est affiché.
+          if (problem.kind == ApiProblemKind.notFound) _dossier = null;
+          _problem = problem;
+      }
+    });
+    if (reportFailure && shown && _dossier != null && result is ApiFailure) {
+      OmiFeedback.error(context, context.l10n.insightsLoadError);
+    }
+  }
+
+  Future<void> _showElementMenu(InsightElement element) => showOmiRowMenu(context, title: element.text, actions: [
+        OmiMenuAction(
+          icon: Icons.remove_circle_outline_rounded,
+          label: context.l10n.insightRemove,
+          isDestructive: true,
+          onSelected: () => unawaited(_removeElement(element)),
+        ),
+      ]);
+
+  Future<void> _removeElement(InsightElement element) async {
+    final dossier = _dossier;
+    if (dossier == null) return;
+    final l10n = context.l10n;
+    final confirmed = await showOmiConfirm(
+      context,
+      title: l10n.insightRemoveElementQuestion,
+      message: l10n.insightRemoveElementMessage,
+      confirmLabel: l10n.insightRemove,
+      destructive: true,
+    );
+    if (!confirmed || !mounted) return;
+    final result = await _api.removeElement(dossier.id, element.id);
+    if (!mounted) return;
+    switch (result) {
+      case ApiSuccess(:final data):
+        OmiHaptics.success();
+        setState(() => _dossier = data.dossier);
+        OmiFeedback.confirm(context, l10n.insightRemoved);
+      case ApiFailure(:final problem) when problem.kind == ApiProblemKind.notFound:
+        // L'élément (ou son dossier) n'existe déjà plus : rien à retirer, ce n'est pas une panne ; relire
+        // montre l'état réel.
+        OmiFeedback.info(context, l10n.insightElementGone);
+        unawaited(_load());
+      case ApiFailure():
+        OmiFeedback.error(context, l10n.somethingWentWrong);
+    }
+  }
+
+  Future<void> _showDossierMenu(InsightDossierSummary summary) async {
+    final removed = await showInsightDossierMenu(context, _api, summary);
+    if (removed && mounted) Navigator.of(context).pop(true);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final title = _dossier?.summary.title ?? widget.summary.title;
+    return Scaffold(
+      backgroundColor: OmiColors.surface0,
+      appBar: AppBar(
+        backgroundColor: OmiColors.surface0,
+        leading: const OmiBackButton(),
+        title: Text(title, style: OmiType.headline, overflow: TextOverflow.ellipsis),
+      ),
+      body: _body(context),
+    );
+  }
+
+  Widget _body(BuildContext context) {
+    final l10n = context.l10n;
+    final dossier = _dossier;
+    if (dossier == null) {
+      final problem = _problem;
+      if (problem == null) return const OmiLoadingState();
+      if (problem.kind == ApiProblemKind.notFound) {
+        return OmiEmptyState(icon: Icons.folder_off_outlined, title: l10n.insightDossierGone);
+      }
+      return OmiErrorState(message: l10n.insightsLoadError, onRetry: _load);
+    }
+    final dates = OmiDateFormat.of(context);
+    final summary = dossier.summary;
+    final children = <Widget>[
+      _InsightDossierHeader(
+        summary: summary,
+        meta:
+            insightDossierMeta(l10n, template: summary.template, updatedAt: summary.updatedAt, formatDate: dates.date),
+        onLongPress: () => unawaited(_showDossierMenu(summary)),
+      ),
+    ];
+    for (final section in dossier.visibleSections) {
+      children
+        ..add(const SizedBox(height: OmiSpacing.xl))
+        ..add(OmiSectionHeader(insightSectionLabel(l10n, section.key, section.name)));
+      if (section.elements.isEmpty) {
+        children.add(Padding(
+          padding: const EdgeInsets.symmetric(horizontal: OmiSpacing.xxs),
+          child: Text(l10n.insightSectionEmpty, style: OmiType.subhead.copyWith(color: OmiColors.textTertiary)),
+        ));
+      }
+      for (final (index, element) in section.elements.indexed) {
+        if (index > 0) children.add(const SizedBox(height: OmiSpacing.xs));
+        children.add(InsightElementCard(
+          element: element,
+          onLongPress: () => unawaited(_showElementMenu(element)),
+          onOpenChat: (id) => unawaited(widget.sources.openChat(context, id)),
+          onOpenConversation: (id) => unawaited(widget.sources.openConversation(context, id)),
+        ));
+      }
+    }
+    return RefreshIndicator(
+      onRefresh: () => _load(reportFailure: true),
+      child: ListView(
+        key: ValueKey('insight_dossier_${dossier.id}'),
+        physics: const AlwaysScrollableScrollPhysics(),
+        padding: EdgeInsets.fromLTRB(
+            OmiSpacing.md, OmiSpacing.xs, OmiSpacing.md, OmiSpacing.xxl + MediaQuery.viewPaddingOf(context).bottom),
+        children: children,
+      ),
+    );
+  }
+}
+
+class _InsightDossierHeader extends StatelessWidget {
+  const _InsightDossierHeader({required this.summary, required this.meta, required this.onLongPress});
+
+  final InsightDossierSummary summary;
+  final String meta;
+  final VoidCallback onLongPress;
+
+  @override
+  Widget build(BuildContext context) {
+    return GestureDetector(
+      key: const ValueKey('insight_dossier_header'),
+      behavior: HitTestBehavior.opaque,
+      onLongPress: onLongPress,
+      child: Padding(
+        padding: const EdgeInsets.symmetric(horizontal: OmiSpacing.xxs),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            Semantics(header: true, child: Text(summary.title, style: OmiType.title2)),
+            const SizedBox(height: OmiSpacing.xxs),
+            Row(
+              children: [
+                ExcludeSemantics(
+                  child: Icon(insightTemplateIcon(summary.template), size: 16, color: OmiColors.textSecondary),
+                ),
+                const SizedBox(width: OmiSpacing.xxs + 2),
+                Expanded(child: Text(meta, style: OmiType.footnote.copyWith(color: OmiColors.textSecondary))),
+              ],
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+}
+
+/// Un élément d'un dossier : son texte, la citation exacte du message d'où il vient, la « piste d'Omi » quand
+/// l'idée vient d'Omi, et ses sources. Appui long : le retirer.
+class InsightElementCard extends StatelessWidget {
+  const InsightElementCard({
+    super.key,
+    required this.element,
+    required this.onLongPress,
+    required this.onOpenChat,
+    required this.onOpenConversation,
+  });
+
+  final InsightElement element;
+  final VoidCallback onLongPress;
+  final ValueChanged<String> onOpenChat;
+  final ValueChanged<String> onOpenConversation;
+
+  @override
+  Widget build(BuildContext context) {
+    final quote = element.quote;
+    return Material(
+      color: OmiColors.surface1,
+      borderRadius: OmiRadius.mdAll,
+      child: InkWell(
+        key: ValueKey('insight_element_${element.id}'),
+        borderRadius: OmiRadius.mdAll,
+        onLongPress: onLongPress,
+        child: Padding(
+          padding: const EdgeInsets.all(OmiSpacing.md),
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              if (element.omiLead) ...[const InsightOmiLeadTag(), const SizedBox(height: OmiSpacing.xs)],
+              Text(element.text, style: OmiType.body),
+              if (quote != null) ...[const SizedBox(height: OmiSpacing.xs), _InsightQuote(quote)],
+              _InsightSourceList(
+                sources: element.sources,
+                onOpenChat: onOpenChat,
+                onOpenConversation: onOpenConversation,
+              ),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+/// « piste d'Omi » : une idée venue d'une réponse d'Omi, pas de Mike. Marquée par une icône et un libellé
+/// (jamais par la seule couleur).
+class InsightOmiLeadTag extends StatelessWidget {
+  const InsightOmiLeadTag({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    final ink = OmiColors.textTertiary;
+    return Container(
+      key: const ValueKey('insight_omi_lead'),
+      padding: const EdgeInsets.symmetric(horizontal: OmiSpacing.xs, vertical: 3),
+      decoration: BoxDecoration(color: OmiColors.chipSurface, borderRadius: OmiRadius.smAll),
+      child: Row(
+        mainAxisSize: MainAxisSize.min,
+        children: [
+          ExcludeSemantics(child: Icon(Icons.auto_awesome_outlined, size: 14, color: ink)),
+          const SizedBox(width: OmiSpacing.xxs),
+          Text(context.l10n.insightOmiLead, style: OmiType.footnote.copyWith(color: ink, fontWeight: FontWeight.w600)),
+        ],
+      ),
+    );
+  }
+}
+
+/// La citation exacte, en retrait derrière un filet.
+class _InsightQuote extends StatelessWidget {
+  const _InsightQuote(this.quote);
+
+  final String quote;
+
+  @override
+  Widget build(BuildContext context) {
+    return Container(
