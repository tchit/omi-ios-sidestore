diff --git a/app/lib/backend/http/api/insights.dart b/app/lib/backend/http/api/insights.dart
new file mode 100644
index 0000000000..4da924bd92
--- /dev/null
+++ b/app/lib/backend/http/api/insights.dart
@@ -0,0 +1,99 @@
+import 'dart:convert';
+
+import 'package:omi/backend/http/api_result.dart';
+import 'package:omi/backend/schema/insight_dossier.dart';
+import 'package:omi/env/env.dart';
+
+/// Clone local : les quatre routes Insights du serveur du clone (lire, retirer). Aucune création : les
+/// dossiers sont écrits par le traitement du clone. Les erreurs restent distinctes d'une liste vide.
+class InsightsApi {
+  InsightsApi({this.send, String? baseUrl}) : _baseUrl = baseUrl;
+  final ApiSend? send;
+  final String? _baseUrl;
+
+  String _url(String path, [Map<String, String> query = const {}]) =>
+      Uri.parse('${_baseUrl ?? Env.apiBaseUrl}$path').replace(queryParameters: query.isEmpty ? null : query).toString();
+
+  String _dossier(String id) => 'v1/insights/dossiers/${Uri.encodeComponent(id)}';
+
+  static Map<String, dynamic> _object(String body) {
+    final decoded = jsonDecode(body);
+    if (decoded is! Map<String, dynamic>) throw const FormatException('Invalid insights answer');
+    return decoded;
+  }
+
+  static Map<String, dynamic> _field(Map<String, dynamic> json, String key) {
+    final value = json[key];
+    if (value is! Map<String, dynamic>) throw const FormatException('Invalid insights answer');
+    return value;
+  }
+
+  /// Les dossiers actifs, le plus récemment mis à jour d'abord. Une ligne illisible est écartée et comptée
+  /// dans [ApiSuccess.rejectedRows].
+  Future<ApiResult<List<InsightDossierSummary>>> list() async {
+    final response = await executeApi<String>(
+      request: ApiRequest(url: _url('v1/insights/dossiers', {'statut': 'actif'}), method: 'GET'),
+      send: send,
+      decode: (body) => body,
+    );
+    switch (response) {
+      case ApiFailure(:final problem):
+        return ApiFailure(problem);
+      case ApiSuccess(:final data):
+        try {
+          final rows = _object(data)['dossiers'];
+          if (rows is! List) return const ApiFailure(ApiProblem(ApiProblemKind.decode));
+          final kept = <InsightDossierSummary>[];
+          var rejected = 0;
+          for (final row in rows) {
+            try {
+              if (row is! Map<String, dynamic>) throw const FormatException('Invalid insight folder');
+              kept.add(InsightDossierSummary.fromJson(row));
+            } on FormatException {
+              rejected++;
+            }
+          }
+          if (kept.isEmpty && rejected > 0) return const ApiFailure(ApiProblem(ApiProblemKind.decode));
+          return ApiSuccess(kept, rejectedRows: rejected);
+        } on FormatException {
+          return const ApiFailure(ApiProblem(ApiProblemKind.decode));
+        }
+    }
+  }
+
+  /// Un dossier en entier ; 404 ([ApiProblemKind.notFound]) s'il n'existe plus.
+  Future<ApiResult<InsightDossier>> get(String id) => executeApi(
+        request: ApiRequest(url: _url(_dossier(id)), method: 'GET'),
+        send: send,
+        decode: (body) => InsightDossier.fromJson(_object(body)),
+      );
+
+  /// Retire un élément (statut « retiré », texte refusé à l'avenir). Rend le dossier à jour.
+  Future<ApiResult<InsightRemoval<InsightDossier>>> removeElement(String dossierId, String elementId) => executeApi(
+        request: ApiRequest(
+          url: _url('${_dossier(dossierId)}/elements/${Uri.encodeComponent(elementId)}'),
+          method: 'DELETE',
+        ),
+        send: send,
+        decode: (body) {
+          final json = _object(body);
+          return InsightRemoval(
+            alreadyRemoved: json['deja_retire'] == true,
+            dossier: InsightDossier.fromJson(_field(json, 'dossier')),
+          );
+        },
+      );
+
+  /// Retire (archive) un dossier : il quitte la liste et son sujet ne sera plus recréé.
+  Future<ApiResult<InsightRemoval<InsightDossierSummary>>> removeDossier(String id) => executeApi(
+        request: ApiRequest(url: _url(_dossier(id)), method: 'DELETE'),
+        send: send,
+        decode: (body) {
+          final json = _object(body);
+          return InsightRemoval(
+            alreadyRemoved: json['deja_retire'] == true,
+            dossier: InsightDossierSummary.fromJson(_field(json, 'dossier')),
+          );
+        },
+      );
+}
diff --git a/app/lib/backend/schema/insight_dossier.dart b/app/lib/backend/schema/insight_dossier.dart
new file mode 100644
index 0000000000..e8b189e04a
--- /dev/null
+++ b/app/lib/backend/schema/insight_dossier.dart
@@ -0,0 +1,232 @@
+/// Clone local : Insights v1, les dossiers vivants qu'Omi tient à partir des discussions du chat.
+///
+/// Formes rendues par les routes du serveur du clone (`/v1/insights/dossiers…`). Les dossiers sont écrits par
+/// le traitement du clone ; l'app les lit et ne peut que retirer (un élément ou un dossier). Dart pur (sans
+/// Flutter) pour être testé seul. Lecture tolérante : un élément, une section ou une source illisible est
+/// écarté sans cacher le reste ; seul un dossier sans id ni titre est refusé ([FormatException]).
+library;
+
+/// Les gabarits connus ; un autre nom reste affiché tel quel.
+const insightTemplates = ['pro', 'proche', 'soin', 'theme'];
+
+class InsightSessionSource {
+  const InsightSessionSource({required this.id, this.title, required this.available});
+
+  final String id;
+  final String? title;
+
+  /// False : la discussion a été supprimée ou ne se lit plus.
+  final bool available;
+
+  static InsightSessionSource? tryParse(Object? json) {
+    if (json is! Map) return null;
+    final id = _string(json['id']);
+    if (id == null) return null;
+    return InsightSessionSource(id: id, title: _string(json['titre']), available: json['disponible'] == true);
+  }
+}
+
+class InsightConversationSource {
+  const InsightConversationSource({required this.id, this.title, this.date, required this.available});
+
+  final String id;
+  final String? title;
+  final DateTime? date;
+
+  /// False : la conversation a été supprimée ou ne se lit plus.
+  final bool available;
+
+  static InsightConversationSource? tryParse(Object? json) {
+    if (json is! Map) return null;
+    final id = _string(json['id']);
+    if (id == null) return null;
+    return InsightConversationSource(
+      id: id,
+      title: _string(json['titre']),
+      date: _date(json['date']),
+      available: json['disponible'] == true,
+    );
+  }
+}
+
+class InsightSources {
+  const InsightSources({this.messages = const [], this.session, this.conversations = const []});
+
+  /// Le champ `id` des messages du chat d'où vient l'élément.
+  final List<String> messages;
+  final InsightSessionSource? session;
+  final List<InsightConversationSource> conversations;
+
+  static InsightSources parse(Object? json) {
+    if (json is! Map) return const InsightSources();
+    final messages = json['messages'];
+    final conversations = json['conversations'];
+    return InsightSources(
+      messages: messages is List ? messages.whereType<String>().toList() : const [],
+      session: InsightSessionSource.tryParse(json['session']),
+      conversations: conversations is List
+          ? conversations.map(InsightConversationSource.tryParse).whereType<InsightConversationSource>().toList()
+          : const [],
+    );
+  }
+}
+
+class InsightElement {
+  const InsightElement({
+    required this.id,
+    required this.text,
+    this.type,
+    required this.origin,
+    required this.omiLead,
+    this.quote,
+    required this.status,
+    this.createdAt,
+    this.revisedAt,
+    this.sources = const InsightSources(),
+  });
+
+  final String id;
+  final String text;
+  final String? type;
+
+  /// `mike` (dit par lui) ou `omi` (venu d'une réponse d'Omi).
+  final String origin;
+
+  /// Une idée venue d'Omi que Mike n'a pas contestée : affichée « piste d'Omi ».
+  final bool omiLead;
+
+  /// Extrait exact du message cité.
+  final String? quote;
+  final String status;
+  final DateTime? createdAt;
+  final DateTime? revisedAt;
+  final InsightSources sources;
+
+  static InsightElement? tryParse(Object? json) {
+    if (json is! Map) return null;
+    final id = _string(json['id']);
+    final text = _string(json['texte']);
+    if (id == null || text == null) return null;
+    final origin = _string(json['origine']) ?? 'mike';
+    return InsightElement(
+      id: id,
+      text: text,
+      type: _string(json['type']),
+      origin: origin,
+      omiLead: json['piste_omi'] is bool ? json['piste_omi'] as bool : origin == 'omi',
+      quote: _string(json['citation']),
+      status: _string(json['statut']) ?? 'actif',
+      createdAt: _date(json['cree']),
+      revisedAt: _date(json['revise']),
+      sources: InsightSources.parse(json['sources']),
+    );
+  }
+}
+
+class InsightSection {
+  const InsightSection({required this.key, required this.name, required this.elements});
+
+  /// Clé fixe (`angles`, `besoins`, …) pour traduire ; [name] est le libellé français du serveur.
+  final String key;
+  final String name;
+  final List<InsightElement> elements;
+
+  static InsightSection? tryParse(Object? json) {
+    if (json is! Map) return null;
+    final name = _string(json['nom']);
+    final key = _string(json['cle']) ?? name;
+    if (key == null) return null;
+    final elements = json['elements'];
+    return InsightSection(
+      key: key,
+      name: name ?? key,
+      elements:
+          elements is List ? elements.map(InsightElement.tryParse).whereType<InsightElement>().toList() : const [],
+    );
+  }
+}
+
+/// Une ligne de la liste (`Resume` côté serveur).
+class InsightDossierSummary {
+  const InsightDossierSummary({
+    required this.id,
+    required this.title,
+    required this.template,
+    this.aliases = const [],
+    required this.status,
+    required this.version,
+    this.updatedAt,
+    required this.elementCount,
+  });
+
+  final String id;
+  final String title;
+
+  /// `pro`, `proche`, `soin` ou `theme`.
+  final String template;
+  final List<String> aliases;
+  final String status;
+  final int version;
+  final DateTime? updatedAt;
+  final int elementCount;
+
+  bool get isActive => status == 'actif';
+
+  /// Throws [FormatException] for a row without id or title.
+  factory InsightDossierSummary.fromJson(Map<String, dynamic> json) {
+    final id = _string(json['id']);
+    final title = _string(json['titre']);
+    if (id == null || title == null) throw const FormatException('Invalid insight folder');
+    final aliases = json['alias'];
+    return InsightDossierSummary(
+      id: id,
+      title: title,
+      template: _string(json['gabarit']) ?? 'theme',
+      aliases: aliases is List ? aliases.whereType<String>().toList() : const [],
+      status: _string(json['statut']) ?? 'actif',
+      version: json['version'] is num ? (json['version'] as num).toInt() : 0,
+      updatedAt: _date(json['maj']),
+      elementCount: json['nb_elements'] is num ? (json['nb_elements'] as num).toInt() : 0,
+    );
+  }
+}
+
+/// Un dossier lu en entier (`Dossier` côté serveur) : sections du gabarit dans l'ordre, même vides.
+class InsightDossier {
+  const InsightDossier({required this.summary, required this.sections});
+
+  final InsightDossierSummary summary;
+  final List<InsightSection> sections;
+
+  String get id => summary.id;
+
+  factory InsightDossier.fromJson(Map<String, dynamic> json) {
+    final sections = json['sections'];
+    return InsightDossier(
+      summary: InsightDossierSummary.fromJson(json),
+      sections:
+          sections is List ? sections.map(InsightSection.tryParse).whereType<InsightSection>().toList() : const [],
+    );
+  }
+
+  /// Seuls les éléments actifs se montrent (le serveur n'envoie déjà qu'eux).
+  List<InsightSection> get visibleSections => [
+        for (final section in sections)
+          InsightSection(
+            key: section.key,
+            name: section.name,
+            elements: section.elements.where((element) => element.status == 'actif').toList(),
+          ),
+      ];
+}
+
+/// Réponse d'un retrait : `deja_retire` quand c'était déjà fait.
+class InsightRemoval<T> {
+  const InsightRemoval({required this.alreadyRemoved, required this.dossier});
+  final bool alreadyRemoved;
+  final T dossier;
+}
+
+String? _string(Object? value) => value is String && value.trim().isNotEmpty ? value : null;
+
+DateTime? _date(Object? value) => value is String ? DateTime.tryParse(value) : null;
