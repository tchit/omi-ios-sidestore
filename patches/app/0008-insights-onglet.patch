+
+/// Clone local : le troisième onglet de l'accueil (Accueil, Tâches, Insights). Les dossiers vivants qu'Omi tient
+/// à partir des discussions du chat, un par personne, relation ou thème, le plus récemment mis à jour d'abord.
+/// Toucher un dossier l'ouvre ; appui long : le retirer. Lecture seule sinon : Omi décide seul de ce qui entre.
+class InsightsPage extends StatefulWidget {
+  const InsightsPage({super.key, this.api, this.sources = const InsightSourceOpener()});
+
+  final InsightsApi? api;
+  final InsightSourceOpener sources;
+
+  @override
+  State<InsightsPage> createState() => InsightsPageState();
+}
+
+class InsightsPageState extends State<InsightsPage> with AutomaticKeepAliveClientMixin {
+  late final InsightsApi _api = widget.api ?? InsightsApi();
+  final ScrollController _scrollController = ScrollController();
+
+  /// Null tant que rien n'a été lu.
+  List<InsightDossierSummary>? _dossiers;
+  ApiProblem? _problem;
+  Future<void>? _loading;
+
+  @override
+  bool get wantKeepAlive => true;
+
+  @override
+  void initState() {
+    super.initState();
+    unawaited(refresh());
+  }
+
+  @override
+  void dispose() {
+    _scrollController.dispose();
+    super.dispose();
+  }
+
+  void scrollToTop() {
+    if (_scrollController.hasClients) {
+      _scrollController.animateTo(0, duration: const Duration(milliseconds: 300), curve: Curves.easeOut);
+    }
+  }
+
+  /// Relit la liste (onglet rouvert, retour d'un dossier, tirer pour rafraîchir). Un échec garde ce qui est
+  /// affiché ; [reportFailure] le dit alors par un message.
+  Future<void> refresh({bool reportFailure = false}) {
+    final running = _loading;
+    if (running != null) return running;
+    final future = _load(reportFailure: reportFailure).whenComplete(() => _loading = null);
+    _loading = future;
+    return future;
+  }
+
+  Future<void> _load({required bool reportFailure}) async {
+    final result = await _api.list();
+    if (!mounted) return;
+    final hadRows = _dossiers != null;
+    setState(() {
+      switch (result) {
+        case ApiSuccess(:final data):
+          _dossiers = data;
+          _problem = null;
+        case ApiFailure(:final problem):
+          _problem = problem;
+      }
+    });
+    if (reportFailure && hadRows && result is ApiFailure) OmiFeedback.error(context, context.l10n.insightsLoadError);
+  }
+
+  Future<void> _open(InsightDossierSummary dossier) async {
+    OmiHaptics.selection();
+    await routeToInsightDossier(context, dossier, api: _api, sources: widget.sources);
+    // Des éléments ont pu être retirés, ou le dossier lui-même.
+    if (mounted) unawaited(refresh());
+  }
+
+  Future<void> _showMenu(InsightDossierSummary dossier) async {
+    final removed = await showInsightDossierMenu(context, _api, dossier);
+    if (!removed || !mounted) return;
+    setState(() => _dossiers = _dossiers?.where((row) => row.id != dossier.id).toList());
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    super.build(context);
+    final l10n = context.l10n;
+    final dossiers = _dossiers;
+    final Widget body;
+    if (dossiers == null) {
+      body = SliverFillRemaining(
+        hasScrollBody: false,
+        child: _problem == null
+            ? const OmiLoadingState()
+            : OmiErrorState(message: l10n.insightsLoadError, onRetry: () => refresh()),
+      );
+    } else if (dossiers.isEmpty) {
+      body = SliverFillRemaining(
+        hasScrollBody: false,
+        child: Padding(
+          padding: const EdgeInsets.only(bottom: 120),
+          child: OmiEmptyState(
+            icon: Icons.lightbulb_outline_rounded,
+            title: l10n.insightsEmptyTitle,
+            message: l10n.insightsEmptyMessage,
+          ),
+        ),
+      );
+    } else {
+      body = SliverPadding(
+        padding: const EdgeInsets.symmetric(horizontal: OmiSpacing.md),
+        sliver: SliverList.separated(
+          itemCount: dossiers.length,
+          separatorBuilder: (_, __) => const SizedBox(height: OmiSpacing.xs),
+          itemBuilder: (context, index) {
+            final dossier = dossiers[index];
+            return InsightDossierRow(
+              dossier: dossier,
+              onTap: () => unawaited(_open(dossier)),
+              onLongPress: () => unawaited(_showMenu(dossier)),
+            );
+          },
+        ),
+      );
+    }
+    return RefreshIndicator(
+      onRefresh: () {
+        OmiHaptics.medium();
+        return refresh(reportFailure: true);
+      },
+      child: CustomScrollView(
+        key: const ValueKey('insights_list'),
+        controller: _scrollController,
+        physics: const AlwaysScrollableScrollPhysics(),
+        slivers: [
+          const SliverPadding(padding: EdgeInsets.only(top: OmiSpacing.xs)),
+          body,
+          SliverPadding(padding: EdgeInsets.only(bottom: homeBottomClearance(context))),
+        ],
+      ),
+    );
+  }
+}
+
+/// Ouvre un dossier par-dessus l'accueil ; se termine quand on en revient.
+Future<void> routeToInsightDossier(
+  BuildContext context,
+  InsightDossierSummary dossier, {
+  InsightsApi? api,
+  InsightSourceOpener sources = const InsightSourceOpener(),
+}) {
+  return routeToPage(context, InsightDossierPage(summary: dossier, api: api, sources: sources));
+}
+
+/// Une ligne de la liste : titre, gabarit (icône et libellé), nombre de notes et date de mise à jour.
+class InsightDossierRow extends StatelessWidget {
+  const InsightDossierRow({super.key, required this.dossier, required this.onTap, required this.onLongPress});
+
+  final InsightDossierSummary dossier;
+  final VoidCallback onTap;
+  final VoidCallback onLongPress;
+
+  @override
+  Widget build(BuildContext context) {
+    final meta = insightDossierMeta(
+      context.l10n,
+      template: dossier.template,
+      count: dossier.elementCount,
+      updatedAt: dossier.updatedAt,
+      formatDate: OmiDateFormat.of(context).date,
+    );
+    return Semantics(
+      button: true,
+      child: Material(
+        color: OmiColors.surface1,
+        borderRadius: OmiRadius.mdAll,
+        child: InkWell(
+          key: ValueKey('insight_dossier_${dossier.id}'),
+          borderRadius: OmiRadius.mdAll,
+          onTap: onTap,
+          onLongPress: onLongPress,
+          child: ConstrainedBox(
+            constraints: const BoxConstraints(minHeight: 64),
+            child: Padding(
+              padding: const EdgeInsets.symmetric(horizontal: OmiSpacing.md, vertical: OmiSpacing.sm),
+              child: Row(
+                children: [
+                  ExcludeSemantics(
+                    child: Icon(insightTemplateIcon(dossier.template), size: 22, color: OmiColors.textSecondary),
+                  ),
+                  const SizedBox(width: OmiSpacing.sm),
+                  Expanded(
+                    child: Column(
+                      crossAxisAlignment: CrossAxisAlignment.start,
+                      mainAxisSize: MainAxisSize.min,
+                      children: [
+                        Text(dossier.title, maxLines: 2, overflow: TextOverflow.ellipsis, style: OmiType.headline),
+                        const SizedBox(height: 2),
+                        Text(meta, style: OmiType.footnote.copyWith(color: OmiColors.textSecondary)),
+                      ],
+                    ),
+                  ),
+                  const SizedBox(width: OmiSpacing.xs),
+                  ExcludeSemantics(child: Icon(Icons.chevron_right_rounded, size: 20, color: OmiColors.textTertiary)),
+                ],
+              ),
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+}
