@@ -0,0 +1,80 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+
+import 'package:provider/provider.dart';
+
+import 'package:omi/backend/http/api/conversations.dart';
+import 'package:omi/backend/http/api_result.dart';
+import 'package:omi/backend/schema/chat_session.dart';
+import 'package:omi/pages/chat/chat_route.dart';
+import 'package:omi/pages/chat/page.dart';
+import 'package:omi/pages/conversation_detail/page.dart';
+import 'package:omi/providers/message_provider.dart';
+import 'package:omi/ui/ui.dart';
+import 'package:omi/utils/l10n_extensions.dart';
+import 'package:omi/utils/other/temp.dart';
+
+/// Clone local : ouvre la source d'un élément d'Insights (la discussion du chat d'où il vient, ou une
+/// conversation citée). Remplaçable dans les tests.
+class InsightSourceOpener {
+  const InsightSourceOpener({this.openChat = openInsightChat, this.openConversation = openInsightConversation});
+
+  final Future<void> Function(BuildContext context, String sessionId) openChat;
+  final Future<void> Function(BuildContext context, String conversationId) openConversation;
+}
+
+/// Rouvre la discussion [sessionId] dans le chat, comme un choix de « Discussions passées ». Refusé pendant une
+/// réponse en cours ; une discussion supprimée depuis le dit.
+Future<void> openInsightChat(BuildContext context, String sessionId) async {
+  final provider = context.read<MessageProvider>();
+  final l10n = context.l10n;
+  if (!provider.canSwitchChat) {
+    OmiFeedback.info(context, l10n.chatSwitchBusy);
+    return;
+  }
+  // La discussion est lue avant d'ouvrir le chat : à l'ouverture, un chat vide relirait l'ancien fil.
+  final found = await _whileLoading<ApiResult<ChatSessionSummary>>(context, () async {
+    final result = await provider.chatSessionsApi.get(sessionId);
+    if (result is! ApiSuccess<ChatSessionSummary>) return result;
+    final opened = await provider.openChatSession(result.data);
+    return opened ? result : const ApiFailure(ApiProblem(ApiProblemKind.rejected));
+  });
+  if (!context.mounted) return;
+  switch (found) {
+    case ApiSuccess():
+      unawaited(openChatSheet(context, const ChatPage(isPivotBottom: false)));
+    case ApiFailure(:final problem):
+      OmiFeedback.error(
+          context, problem.kind == ApiProblemKind.notFound ? l10n.insightSourceUnavailable : l10n.somethingWentWrong);
+  }
+}
+
+/// Ouvre la conversation [conversationId] ; supprimée ou verrouillée, le dit.
+Future<void> openInsightConversation(BuildContext context, String conversationId) async {
+  final l10n = context.l10n;
+  final found = await _whileLoading(context, () => getConversationByIdResult(conversationId));
+  if (!context.mounted) return;
+  final conversation = found.item;
+  if (conversation != null) {
+    unawaited(routeToPage(context, ConversationDetailPage(conversation: conversation)));
+  } else {
+    OmiFeedback.error(context, found.ok ? l10n.conversationNotFoundOrDeleted : l10n.somethingWentWrong);
+  }
+}
+
+/// Un indicateur d'attente au-dessus de la page pendant [work] (comme l'ouverture d'une conversation depuis un
+/// récap).
+Future<T> _whileLoading<T>(BuildContext context, Future<T> Function() work) async {
+  final navigator = Navigator.of(context);
+  unawaited(showDialog<void>(
+    context: context,
+    barrierDismissible: false,
+    builder: (_) => const Center(child: OmiSpinner(size: OmiSpinnerSize.large)),
+  ));
+  try {
+    return await work();
+  } finally {
+    navigator.pop();
+  }
+}
