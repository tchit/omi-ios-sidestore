@@ -0,0 +1,52 @@
+import 'package:flutter/material.dart';
+
+import 'package:omi/l10n/app_localizations.dart';
+
+/// Clone local : libellés traduits des gabarits et des sections d'Insights. Le serveur envoie une clé fixe
+/// (`gabarit`, `cle`) et un nom français ; une clé inconnue garde ce nom.
+String insightTemplateLabel(AppLocalizations l10n, String template) => switch (template) {
+      'pro' => l10n.insightTemplatePro,
+      'proche' => l10n.insightTemplateProche,
+      'soin' => l10n.insightTemplateSoin,
+      'theme' => l10n.insightTemplateTheme,
+      _ => template,
+    };
+
+/// L'icône d'un gabarit ; toujours montrée avec son libellé, jamais seule porteuse du sens.
+IconData insightTemplateIcon(String template) => switch (template) {
+      'pro' => Icons.work_outline_rounded,
+      'proche' => Icons.people_outline_rounded,
+      'soin' => Icons.spa_outlined,
+      _ => Icons.lightbulb_outline_rounded,
+    };
+
+String insightSectionLabel(AppLocalizations l10n, String key, String fallback) => switch (key) {
+      'angles' => l10n.insightSectionAngles,
+      'besoins' => l10n.insightSectionNeeds,
+      'propositions_possibles' => l10n.insightSectionProposals,
+      'a_suivre' => l10n.insightSectionFollowUp,
+      'ce_qui_s_est_passe' => l10n.insightSectionWhatHappened,
+      'ce_qui_a_marche' => l10n.insightSectionWhatWorked,
+      'la_prochaine_fois' => l10n.insightSectionNextTime,
+      'ce_qui_a_compte' => l10n.insightSectionWhatMattered,
+      'comprendre' => l10n.insightSectionUnderstanding,
+      'ce_qui_m_aide' => l10n.insightSectionWhatHelps,
+      'idees' => l10n.insightSectionIdeas,
+      'questions_ouvertes' => l10n.insightSectionOpenQuestions,
+      _ => fallback,
+    };
+
+/// La ligne sous le titre d'un dossier : « Pro · 3 notes · Mis à jour le 9 oct. 2026 ». Sans [count] (en-tête
+/// du dossier, où les notes se voient), le nombre de notes est omis.
+String insightDossierMeta(
+  AppLocalizations l10n, {
+  required String template,
+  required String Function(DateTime) formatDate,
+  DateTime? updatedAt,
+  int? count,
+}) =>
+    [
+      insightTemplateLabel(l10n, template),
+      if (count != null) l10n.insightElementCount(count),
+      if (updatedAt != null) l10n.insightUpdated(formatDate(updatedAt.toLocal())),
+    ].join(' · ');
