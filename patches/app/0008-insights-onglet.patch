+      decoration: BoxDecoration(border: Border(left: BorderSide(color: OmiColors.border, width: 3))),
+      child: Text(
+        quote,
+        style: OmiType.subhead.copyWith(color: OmiColors.textTertiary, fontStyle: FontStyle.italic),
+      ),
+    );
+  }
+}
+
+class _InsightSourceList extends StatelessWidget {
+  const _InsightSourceList({required this.sources, required this.onOpenChat, required this.onOpenConversation});
+
+  final InsightSources sources;
+  final ValueChanged<String> onOpenChat;
+  final ValueChanged<String> onOpenConversation;
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = context.l10n;
+    final dates = OmiDateFormat.of(context);
+    final session = sources.session;
+    final chips = <Widget>[
+      if (session != null)
+        _InsightSourceChip(
+          key: ValueKey('insight_source_chat_${session.id}'),
+          icon: Icons.chat_bubble_outline_rounded,
+          label: session.title ?? l10n.untitledChat,
+          available: session.available,
+          onTap: () => onOpenChat(session.id),
+        ),
+      for (final conversation in sources.conversations)
+        _InsightSourceChip(
+          key: ValueKey('insight_source_conversation_${conversation.id}'),
+          icon: Icons.graphic_eq_rounded,
+          label: conversation.title ??
+              (conversation.date != null ? dates.date(conversation.date!.toLocal()) : l10n.untitledConversation),
+          available: conversation.available,
+          onTap: () => onOpenConversation(conversation.id),
+        ),
+    ];
+    if (chips.isEmpty) return const SizedBox.shrink();
+    return Padding(
+      padding: const EdgeInsets.only(top: OmiSpacing.sm),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Text(l10n.insightSources, style: OmiType.footnote.copyWith(color: OmiColors.textTertiary)),
+          const SizedBox(height: OmiSpacing.xxs),
+          Wrap(spacing: OmiSpacing.xs, runSpacing: OmiSpacing.xs, children: chips),
+        ],
+      ),
+    );
+  }
+}
+
+/// Une source : touchée, elle ouvre la discussion ou la conversation. Supprimée depuis, elle reste listée (on
+/// voit d'où venait l'élément) avec « N'est plus disponible », et ne s'ouvre pas.
+class _InsightSourceChip extends StatelessWidget {
+  const _InsightSourceChip({
+    super.key,
+    required this.icon,
+    required this.label,
+    required this.available,
+    required this.onTap,
+  });
+
+  final IconData icon;
+  final String label;
+  final bool available;
+  final VoidCallback onTap;
+
+  @override
+  Widget build(BuildContext context) {
+    final ink = available ? OmiColors.textPrimary : OmiColors.textTertiary;
+    final text = available ? label : '$label · ${context.l10n.insightSourceUnavailable}';
+    final content = ConstrainedBox(
+      constraints: const BoxConstraints(minHeight: 36, maxWidth: 280),
+      child: Padding(
+        padding: const EdgeInsets.symmetric(horizontal: OmiSpacing.sm, vertical: OmiSpacing.xxs),
+        child: Row(
+          mainAxisSize: MainAxisSize.min,
+          children: [
+            ExcludeSemantics(child: Icon(available ? icon : Icons.link_off_rounded, size: 16, color: ink)),
+            const SizedBox(width: 6),
+            Flexible(
+              child: Text(text,
+                  maxLines: 1, overflow: TextOverflow.ellipsis, style: OmiType.footnote.copyWith(color: ink)),
+            ),
+          ],
+        ),
+      ),
+    );
+    return Semantics(
+      button: available,
+      enabled: available,
+      child: Material(
+        color: OmiColors.chipSurface,
+        shape: const StadiumBorder(),
+        clipBehavior: Clip.antiAlias,
+        child: available ? InkWell(onTap: onTap, child: content) : content,
+      ),
+    );
+  }
+}
