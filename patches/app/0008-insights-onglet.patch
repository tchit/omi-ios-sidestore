+  Map<String, List<Map<String, dynamic>>> _sections(String id) => switch (id) {
+        'arnaud' => {
+            'angles': [
+              _element(
+                'e1',
+                'Lui parler du budget avant la démo.',
+                quote: 'parler du budget avant la démo',
