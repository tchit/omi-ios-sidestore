+      expect(Uri.parse(requests.single.url).path, '/v1/conversations/c1/corrections');
+      expect(jsonDecode(requests.single.body), {'id': 'corr-1', 'texte': "C'est Pascal, pas Thomas Pascal."});
+      final data = (result as ApiSuccess<ConversationCorrectionResult>).data;
