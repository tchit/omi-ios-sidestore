+// Clone local : « Corriger le résumé » (0009) — API, bilan en une ligne, messages d'échec, fournisseur, et versions
+// gardées (une version dont seul le titre a été corrigé reste atteignable).
+import 'dart:convert';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:shared_preferences/shared_preferences.dart';
+
+import 'package:omi/backend/http/api/conversation_corrections.dart';
