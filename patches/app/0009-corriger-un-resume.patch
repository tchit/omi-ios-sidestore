+      expect(correctionProblemMessage(fr, const ApiProblem(ApiProblemKind.rejected, statusCode: 400)),
+          'Écrivez ce qui est faux, en 1000 caractères au plus.');
+    });
+  });
+
+  group('kept versions after a correction', () {
+    test('a title-only correction keeps the old title reachable; the newest same text is the current one', () {
+      final choices = buildSummaryChoices(
+        currentAppResults: const [],
+        currentOmiNotes: 'Mike a revu Pascal.',
+        currentTitle: 'Déjeuner avec Pascal',
+        history: [
+          version('v0', 'omi', 'Mike a revu Pascal.', title: 'Déjeuner avec Thomas Pascal', recordedAt: _t1),
+          version('v1', 'omi', 'Mike a revu Pascal.',
+              title: 'Déjeuner avec Pascal', createdAt: _t1, recordedAt: _t1, correctionId: 'corr-1'),
+        ],
+      );
+      expect(choices.map((c) => c.key), ['current:omi', 'version:v0']);
+      expect(choices.first.correctionId, 'corr-1');
+      expect(choices.first.createdAt, _t1);
+      expect(choices.last.title, 'Déjeuner avec Thomas Pascal');
+    });
+
+    test('a hand-written title never turns the current notes into a duplicate version', () {
+      final choices = buildSummaryChoices(
+        currentAppResults: const [],
+        currentOmiNotes: 'Notes',
+        currentTitle: 'Mon titre à moi',
+        history: [version('v1', 'omi', 'Notes', title: 'Titre généré', createdAt: _t0, recordedAt: _t0)],
+      );
+      expect(choices.map((c) => c.key), ['current:omi']);
+    });
+
+    test('correction_id is read and kept through the local cache', () {
+      final parsed = SummaryVersion.tryParse({
+        'id': 'a',
+        'kind': 'app',
+        'content': 'R',
+        'recorded_at': '2026-10-10T18:30:00Z',
+        'correction_id': 'corr-1',
+      })!;
+      expect(parsed.correctionId, 'corr-1');
+      expect(SummaryVersion.tryParse(parsed.toJson())!.correctionId, 'corr-1');
+      expect(SummaryVersion.tryParse({...parsed.toJson()}..remove('correction_id'))!.correctionId, isNull);
+    });
+  });
+
+  group('ConversationDetailProvider.correctSummary', () {
+    setUp(() async {
+      SharedPreferences.setMockInitialValues({});
+      await SharedPreferencesUtil.init();
+    });
+
+    ServerConversation current() => ServerConversation(
+          id: 'c1',
+          createdAt: _t0,
+          status: ConversationStatus.completed,
+          structured: Structured('Déjeuner avec Thomas Pascal', 'Mike a revu Thomas Pascal.'),
+        );
+
+    ConversationDetailProvider detail(ConversationCorrectionCall call) {
+      final provider = ConversationDetailProvider(correctSummary: call)
+        ..selectedDate = conversationLocalDayKey(_t0)
+        ..setCachedConversation(current());
+      addTearDown(provider.dispose);
+      return provider;
+    }
+
+    test('a success shows the corrected conversation and the current summary', () async {
+      final sent = <(String, String, String)>[];
+      final provider = detail((conversationId, {required id, required text}) async {
+        sent.add((conversationId, id, text));
+        return ApiSuccess(ConversationCorrectionResult.decode(answer()));
+      });
+      expect(provider.summaryChoices(), hasLength(1));
+      final result = await provider.correctSummary("  C'est Pascal.  ", correctionId: 'corr-1');
+      expect(result, isA<ApiSuccess<ConversationCorrectionResult>>());
+      expect(sent, [('c1', 'corr-1', "C'est Pascal.")]);
+      expect(provider.conversation.structured.title, 'Déjeuner avec Pascal');
+      expect(provider.getSummarySelection().content, 'Mike a revu Pascal.');
+      expect(provider.summaryChoices().map((c) => c.key), ['current:omi', 'version:v-old']);
+      expect(provider.correctingSummary, isFalse);
+    });
+
+    test('a failure changes nothing on the page', () async {
+      final provider = detail((conversationId, {required id, required text}) async =>
+          const ApiFailure(ApiProblem(ApiProblemKind.server, statusCode: 502)));
+      final result = await provider.correctSummary('x', correctionId: 'corr-1');
+      expect(result, isA<ApiFailure<ConversationCorrectionResult>>());
+      expect(provider.conversation.structured.title, 'Déjeuner avec Thomas Pascal');
+      expect(provider.correctingSummary, isFalse);
+    });
+
+    test('a second send while one is running is refused, not sent twice', () async {
+      var calls = 0;
+      final provider = detail((conversationId, {required id, required text}) async {
+        calls++;
+        await Future<void>.delayed(const Duration(milliseconds: 10));
+        return ApiSuccess(ConversationCorrectionResult.decode(answer()));
+      });
+      final first = provider.correctSummary('x', correctionId: 'corr-1');
+      expect(provider.correctingSummary, isTrue);
+      final second = await provider.correctSummary('x', correctionId: 'corr-1');
+      expect(second, isA<ApiFailure<ConversationCorrectionResult>>());
+      await first;
+      expect(calls, 1);
+    });
+  });
+}
