+import 'package:omi/providers/conversation_provider.dart' show conversationLocalDayKey;
+
+final _t0 = DateTime.utc(2026, 10, 10, 9);
+final _t1 = DateTime.utc(2026, 10, 10, 18, 30);
+
+Map<String, dynamic> conversationJson({String title = 'Déjeuner avec Pascal', List<Map<String, dynamic>>? history}) => {
+      'id': 'c1',
+      'created_at': '2026-10-10T09:00:00Z',
+      'started_at': '2026-10-10T09:00:00Z',
+      'finished_at': '2026-10-10T10:00:00Z',
+      'status': 'completed',
+      'structured': {'title': title, 'overview': 'Mike a revu Pascal.', 'emoji': '🎬', 'category': 'personal'},
+      'transcript_segments': [],
+      'apps_results': [],
+      'summary_history': history ??
+          [
+            {
+              'id': 'v-old',
+              'kind': 'omi',
+              'title': 'Déjeuner avec Thomas Pascal',
+              'content': 'Mike a revu Thomas Pascal.',
+              'created_at': null,
+              'recorded_at': '2026-10-10T18:30:00Z',
+            },
+            {
+              'id': 'v-new',
+              'kind': 'omi',
+              'title': 'Déjeuner avec Pascal',
