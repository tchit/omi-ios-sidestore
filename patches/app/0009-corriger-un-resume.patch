+++ b/app/lib/backend/http/api/conversation_corrections.dart
@@ -0,0 +1,102 @@
+import 'dart:convert';
+
+import 'package:omi/backend/http/api_result.dart';
+import 'package:omi/backend/schema/conversation.dart';
+import 'package:omi/env/env.dart';
+
+/// Clone local : « Corriger le résumé » — POST /v1/conversations/{id}/corrections.
+///
+/// L'utilisateur écrit ce qui est faux ; le serveur corrige, dans cette conversation seulement, le titre, les notes
+/// d'Omi, les résumés d'apps et les souvenirs qui en sont tirés, garde chaque ancienne version (flèche des résumés)
+/// et rend ce qu'il a réellement changé. [id] rend l'envoi rejouable sans rien refaire (même id → même résultat).
+class ConversationCorrectionsApi {
+  ConversationCorrectionsApi({this.send, String? baseUrl}) : _baseUrl = baseUrl;
+  final ApiSend? send;
+  final String? _baseUrl;
+
+  /// Même limite que le serveur.
+  static const int maxLength = 1000;
+
+  Future<ApiResult<ConversationCorrectionResult>> correct(String conversationId,
+          {required String id, required String text}) =>
+      executeApi(
+        request: ApiRequest(
+          url: '${_baseUrl ?? Env.apiBaseUrl}v1/conversations/${Uri.encodeComponent(conversationId)}/corrections',
+          method: 'POST',
+          body: jsonEncode({'id': id, 'texte': text}),
+        ),
+        send: send,
+        decode: ConversationCorrectionResult.decode,
+      );
+}
+
+/// Ce que la correction a réellement changé (écritures validées par le serveur).
+class ConversationCorrectionSummary {
+  const ConversationCorrectionSummary({
+    this.title = false,
+    this.notes = false,
+    this.appSummaries = 0,
+    this.memories = 0,
+    this.facts = 0,
+    this.refused = 0,
+    this.memoriesSkipped = 0,
+  });
+
+  final bool title;
+  final bool notes;
+  final int appSummaries;
+  final int memories;
+  final int facts;
+
+  /// Passages proposés mais pas trouvés tels quels (rien n'a été réécrit à leur place).
+  final int refused;
+
+  /// Souvenirs de la conversation au-delà des 30 plus récents : pas relus par Omi.
+  final int memoriesSkipped;
+
+  /// Rien n'a été remplacé : la correction est seulement enregistrée (elle servira aux prochains résumés).
+  bool get nothingReplaced => !title && !notes && appSummaries == 0 && memories == 0 && facts == 0;
+
+  static int _count(Object? value) => value is int && value > 0 ? value : 0;
+
+  factory ConversationCorrectionSummary.fromJson(Map<String, dynamic> json) => ConversationCorrectionSummary(
+        title: json['titre'] == true,
+        notes: json['notes'] == true,
+        appSummaries: _count(json['resumes_apps']),
+        memories: _count(json['souvenirs']),
+        facts: _count(json['faits']),
+        refused: _count(json['refuses']),
+        memoriesSkipped: _count(json['souvenirs_ignores']),
+      );
+}
+
+class ConversationCorrectionResult {
+  const ConversationCorrectionResult({required this.conversation, required this.summary, this.alreadyApplied = false});
+
+  final ServerConversation conversation;
+  final ConversationCorrectionSummary summary;
+
+  /// Le même envoi avait déjà été appliqué (réseau coupé puis renvoyé) : rien n'a été refait.
+  final bool alreadyApplied;
+
+  static ConversationCorrectionResult decode(String body) {
+    final json = jsonDecode(body);
+    if (json is! Map<String, dynamic>) throw const FormatException('Invalid correction answer');
+    final conversation = json['conversation'];
+    final summary = json['bilan'];
+    if (conversation is! Map<String, dynamic> || summary is! Map<String, dynamic>) {
+      throw const FormatException('Invalid correction answer');
+    }
+    try {
+      return ConversationCorrectionResult(
+        conversation: ServerConversation.fromJson(conversation),
+        summary: ConversationCorrectionSummary.fromJson(summary),
+        alreadyApplied: json['deja_appliquee'] == true,
+      );
+    } on FormatException {
+      rethrow;
+    } catch (_) {
+      throw const FormatException('Invalid conversation in correction answer');
+    }
+  }
+}
