+              'recorded_at': '2026-10-10T18:30:00Z',
+              'correction_id': 'corr-1',
+            },
+          ],
+    };
+
+String answer({Map<String, dynamic>? bilan, bool replay = false}) => jsonEncode({
+      'conversation': conversationJson(),
+      'bilan': bilan ?? {'titre': true, 'notes': true, 'resumes_apps': 0, 'souvenirs': 1, 'faits': 0, 'refuses': 0},
+      'deja_appliquee': replay,
+    });
+
+SummaryVersion version(String id, String kind, String content,
+        {String? title, String? appId, DateTime? createdAt, required DateTime recordedAt, String? correctionId}) =>
+    SummaryVersion(
+      id: id,
+      kind: kind,
+      content: content,
+      title: title,
+      appId: appId,
+      createdAt: createdAt,
+      recordedAt: recordedAt,
+      correctionId: correctionId,
+    );
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  final fr = lookupAppLocalizations(const Locale('fr'));
