+import 'package:flutter/material.dart';
+import 'package:provider/provider.dart';
+import 'package:uuid/uuid.dart';
+
+import 'package:omi/backend/http/api/conversation_corrections.dart';
+import 'package:omi/backend/http/api_result.dart';
+import 'package:omi/backend/schema/conversation.dart';
+import 'package:omi/l10n/app_localizations.dart';
+import 'package:omi/pages/conversation_detail/conversation_detail_provider.dart';
+import 'package:omi/pages/conversation_detail/conversation_summary_selection.dart';
+import 'package:omi/providers/connectivity_provider.dart';
+import 'package:omi/ui/ui.dart';
+import 'package:omi/utils/l10n_extensions.dart';
+
+/// Clone local : « Corriger le résumé ». Un bouton discret sous le résumé ouvre une feuille où l'utilisateur écrit ce
+/// qui est faux (« C'est Pascal, pas Thomas Pascal. ») ; Omi corrige cette conversation (titre, résumés, souvenirs
+/// qui en viennent), l'ancienne version reste dans le menu des résumés, et une ligne dit ce qui a changé.
+class SummaryCorrectionButton extends StatelessWidget {
+  const SummaryCorrectionButton({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    final busy = context.select<ConversationDetailProvider, bool>((p) => p.correctingSummary);
+    return Align(
+      alignment: AlignmentDirectional.centerStart,
+      child: Padding(
+        padding: const EdgeInsets.only(top: OmiSpacing.xs),
+        child: OmiButton.tertiary(
+          key: const Key('conversation_summary_correct'),
+          label: context.l10n.summaryCorrect,
+          icon: Icons.edit_note_rounded,
+          size: OmiButtonSize.compact,
+          onPressed: busy ? null : () => openSummaryCorrection(context),
+        ),
+      ),
+    );
+  }
+}
+
+/// Le bouton s'affiche sous le résumé actuel d'une conversation traitée, pas sous une ancienne version lue depuis le
+/// menu des résumés, ni pendant l'édition du texte du résumé.
+bool offersSummaryCorrection(ServerConversation? conversation, ConversationSummarySelection selection,
+    {bool editing = false}) {
+  return conversation != null &&
+      !conversation.discarded &&
+      !editing &&
+      conversation.status == ConversationStatus.completed &&
+      !selection.isArchived;
+}
+
+/// Ouvre la feuille ; après un envoi réussi, dit en une ligne ce qui a été corrigé.
+Future<void> openSummaryCorrection(BuildContext context) async {
+  final connectivity = context.read<ConnectivityProvider?>();
+  if (connectivity != null && !connectivity.isConnected) {
+    ConnectivityProvider.showNoInternetDialog(context);
+    return;
+  }
+  final provider = context.read<ConversationDetailProvider>();
+  final result = await showOmiEditSheet<ConversationCorrectionResult>(
+    context: context,
+    builder: (_) => ChangeNotifierProvider<ConversationDetailProvider>.value(
+      value: provider,
+      child: const SummaryCorrectionSheet(),
+    ),
+  );
+  if (result == null || !context.mounted) return;
+  final line = describeCorrection(context.l10n, result.summary);
+  if (result.summary.nothingReplaced) {
+    OmiFeedback.info(context, line);
+  } else {
+    OmiFeedback.confirm(context, line);
+  }
+}
+
+/// La ligne affichée après l'envoi : « Corrigé : résumé, titre, 1 souvenir », ou que rien n'a été trouvé.
+String describeCorrection(AppLocalizations l10n, ConversationCorrectionSummary summary) {
+  final line = _describeChanges(l10n, summary);
+  final skipped = summary.memoriesSkipped;
+  return skipped > 0 ? '$line · ${l10n.summaryCorrectPartSkipped(skipped)}' : line;
+}
+
+String _describeChanges(AppLocalizations l10n, ConversationCorrectionSummary summary) {
+  if (summary.nothingReplaced) return l10n.summaryCorrectNothingFound;
+  final parts = [
+    if (summary.notes) l10n.summaryCorrectPartNotes,
+    if (summary.title) l10n.summaryCorrectPartTitle,
+    if (summary.appSummaries > 0) l10n.summaryCorrectPartApps(summary.appSummaries),
+    if (summary.memories > 0) l10n.summaryCorrectPartMemories(summary.memories),
+    if (summary.facts > 0) l10n.summaryCorrectPartFacts(summary.facts),
+  ];
+  return l10n.summaryCorrectDone(parts.join(', '));
+}
+
+/// Pourquoi l'envoi a échoué, en mots (jamais par la seule couleur : une icône accompagne le texte).
+String correctionProblemMessage(AppLocalizations l10n, ApiProblem problem) {
+  return switch (problem.kind) {
+    // 502 seulement : le modèle n'a pas répondu, rien n'a été écrit. Toute autre erreur serveur peut suivre des
+    // écritures validées : renvoyer le même envoi est sûr (le serveur ne refait rien).
+    ApiProblemKind.server when problem.statusCode == 502 => l10n.summaryCorrectModelFailed,
+    ApiProblemKind.server => l10n.summaryCorrectRetry,
+    ApiProblemKind.notFound => l10n.summaryCorrectGone,
+    ApiProblemKind.transport ||
+    ApiProblemKind.authTransient ||
+    ApiProblemKind.rateLimited =>
+      l10n.summaryCorrectNetwork,
+    ApiProblemKind.unprocessable => l10n.summaryCorrectInvalid,
+    ApiProblemKind.rejected when problem.statusCode == 409 => l10n.summaryCorrectBusy,
+    ApiProblemKind.rejected when problem.statusCode == 400 => l10n.summaryCorrectInvalid,
+    _ => l10n.somethingWentWrong,
+  };
+}
+
+class SummaryCorrectionSheet extends StatefulWidget {
+  const SummaryCorrectionSheet({super.key});
+
+  @override
+  State<SummaryCorrectionSheet> createState() => _SummaryCorrectionSheetState();
+}
+
+class _SummaryCorrectionSheetState extends State<SummaryCorrectionSheet> {
+  final TextEditingController _controller = TextEditingController();
+  bool _sending = false;
+  String? _error;
+
+  /// L'id de l'envoi : le même texte renvoyé après un échec garde le même id (le serveur ne refait rien) ; un texte
+  /// changé est une autre correction.
+  String? _correctionId;
+  String? _sentText;
+
+  String get _text => _controller.text.trim();
+
+  @override
+  void dispose() {
+    _controller.dispose();
+    super.dispose();
+  }
+
+  Future<void> _send() async {
+    final text = _text;
+    if (text.isEmpty || text.length > ConversationCorrectionsApi.maxLength || _sending) return;
+    if (_sentText != text) {
+      _correctionId = const Uuid().v4();
+      _sentText = text;
+    }
+    FocusScope.of(context).unfocus();
+    setState(() {
+      _sending = true;
+      _error = null;
+    });
+    final provider = context.read<ConversationDetailProvider>();
+    final result = await provider.correctSummary(text, correctionId: _correctionId!);
+    if (!mounted) return;
+    switch (result) {
+      case ApiSuccess(:final data):
+        OmiHaptics.success();
+        Navigator.of(context).pop(data);
+      case ApiFailure(:final problem):
+        setState(() {
+          _sending = false;
+          _error = correctionProblemMessage(context.l10n, problem);
+        });
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = context.l10n;
+    final canSend = !_sending && _text.isNotEmpty && _text.length <= ConversationCorrectionsApi.maxLength;
+    return OmiEditSheet(
+      title: l10n.summaryCorrect,
+      isDirty: _text.isNotEmpty,
+      enabled: !_sending,
+      child: SingleChildScrollView(
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          crossAxisAlignment: CrossAxisAlignment.stretch,
+          children: [
+            Text(l10n.summaryCorrectIntro, style: OmiType.footnote.copyWith(color: OmiColors.textSecondary)),
+            const SizedBox(height: OmiSpacing.md),
+            TextField(
+              key: const ValueKey('summary_correction_field'),
+              controller: _controller,
+              enabled: !_sending,
+              autofocus: true,
+              minLines: 3,
+              maxLines: 6,
+              maxLength: ConversationCorrectionsApi.maxLength,
+              keyboardType: TextInputType.multiline,
+              textInputAction: TextInputAction.newline,
+              textCapitalization: TextCapitalization.sentences,
+              onChanged: (_) => setState(() => _error = null),
+              // Lisible en thème clair comme en sombre : texte et fond viennent de la palette (jamais en dur).
+              style: OmiType.callout.copyWith(color: OmiColors.textPrimary, height: 1.4),
+              cursorColor: OmiColors.accent,
+              decoration: InputDecoration(
+                labelText: l10n.summaryCorrectLabel,
+                hintText: l10n.summaryCorrectHint,
+                alignLabelWithHint: true,
+                floatingLabelBehavior: FloatingLabelBehavior.always,
+                labelStyle: OmiType.subhead.copyWith(color: OmiColors.textSecondary),
+                floatingLabelStyle: OmiType.subhead.copyWith(color: OmiColors.textSecondary),
+                hintStyle: OmiType.callout.copyWith(color: OmiColors.textSecondary),
+                counterStyle: OmiType.footnote.copyWith(color: OmiColors.textSecondary),
+                filled: true,
+                fillColor: OmiColors.surface2,
+                contentPadding: const EdgeInsets.all(OmiSpacing.sm),
+                border: const OutlineInputBorder(borderRadius: OmiRadius.smAll, borderSide: BorderSide.none),
+              ),
+            ),
+            if (_sending) ...[
+              const SizedBox(height: OmiSpacing.sm),
+              Semantics(
+                liveRegion: true,
+                child: Row(
+                  key: const Key('summary_correction_sending'),
+                  children: [
+                    const OmiSpinner(size: OmiSpinnerSize.small),
+                    const SizedBox(width: OmiSpacing.xs),
+                    Expanded(
+                      child: Text(
+                        l10n.summaryCorrectSending,
+                        style: OmiType.footnote.copyWith(color: OmiColors.textSecondary),
+                      ),
+                    ),
+                  ],
+                ),
+              ),
+            ],
+            if (_error case final error?) ...[
+              const SizedBox(height: OmiSpacing.sm),
+              Semantics(
+                liveRegion: true,
+                child: Row(
+                  key: const Key('summary_correction_error'),
+                  crossAxisAlignment: CrossAxisAlignment.start,
+                  children: [
+                    Icon(Icons.error_outline_rounded, size: 18, color: OmiColors.textPrimary),
+                    const SizedBox(width: OmiSpacing.xs),
+                    Expanded(child: Text(error, style: OmiType.footnote.copyWith(color: OmiColors.textPrimary))),
+                  ],
+                ),
+              ),
+            ],
+            const SizedBox(height: OmiSpacing.md),
+            Row(
+              children: [
+                Expanded(
+                  child: OmiButton.secondary(
+                    label: l10n.cancel,
+                    onPressed: _sending ? null : () => Navigator.of(context).pop(),
+                    expand: true,
+                  ),
+                ),
+                const SizedBox(width: OmiSpacing.sm),
+                Expanded(
+                  child: OmiButton(
+                    key: const Key('summary_correction_send'),
+                    label: l10n.summaryCorrectSend,
+                    onPressed: canSend ? _send : null,
+                    isLoading: _sending,
+                    expand: true,
+                  ),
+                ),
+              ],
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+}
