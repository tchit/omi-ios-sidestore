+      }
+    });
+
+    test('the summary reads tolerantly', () {
+      final summary = ConversationCorrectionSummary.fromJson({'titre': 'oui', 'souvenirs': -2, 'faits': 2});
+      expect(summary.title, isFalse);
+      expect(summary.memories, 0);
+      expect(summary.facts, 2);
+      expect(summary.nothingReplaced, isFalse);
+      expect(ConversationCorrectionSummary.fromJson({}).nothingReplaced, isTrue);
+    });
+  });
+
+  group('one line after sending', () {
+    test('says what was corrected, in French and in English', () {
+      const summary = ConversationCorrectionSummary(title: true, notes: true, memories: 1);
+      expect(describeCorrection(fr, summary), 'Corrigé : résumé, titre, 1 souvenir');
+      expect(describeCorrection(en, summary), 'Corrected: summary, title, 1 memory');
+      expect(
+        describeCorrection(fr, const ConversationCorrectionSummary(appSummaries: 2, memories: 3, facts: 1)),
+        'Corrigé : 2 résumés d’apps, 3 souvenirs, 1 fait ajouté',
+      );
+    });
+
+    test('memories beyond the 30 most recent are said, never hidden', () {
+      expect(describeCorrection(fr, const ConversationCorrectionSummary(notes: true, memoriesSkipped: 12)),
+          'Corrigé : résumé · 12 souvenirs plus anciens non relus');
+      expect(ConversationCorrectionSummary.fromJson({'souvenirs_ignores': 3}).memoriesSkipped, 3);
+    });
+
+    test('a correction that replaced nothing says it is kept', () {
+      expect(describeCorrection(fr, const ConversationCorrectionSummary(refused: 2)),
+          'Correction enregistrée ; aucun passage à remplacer trouvé.');
+    });
+
+    test('each failure says why in words', () {
+      expect(correctionProblemMessage(fr, const ApiProblem(ApiProblemKind.server, statusCode: 502)),
+          'Omi n’a pas pu relire la conversation ; rien n’a été modifié. Réessayez.');
+      // Un 500 ou un 503 peut suivre des écritures validées : jamais « rien n'a été modifié ».
+      for (final status in [500, 503]) {
+        expect(correctionProblemMessage(fr, ApiProblem(ApiProblemKind.server, statusCode: status)),
+            'Omi n’a pas pu terminer. Réessayez : la correction ne sera pas appliquée deux fois.');
+      }
+      expect(correctionProblemMessage(fr, const ApiProblem(ApiProblemKind.rejected, statusCode: 409)),
+          'La conversation change en ce moment. Réessayez dans un instant.');
+      expect(correctionProblemMessage(fr, const ApiProblem(ApiProblemKind.transport)),
