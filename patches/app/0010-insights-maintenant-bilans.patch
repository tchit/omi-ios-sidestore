@@ -0,0 +1,550 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+
+import 'package:omi/backend/http/api/insights.dart';
+import 'package:omi/backend/http/api_result.dart';
+import 'package:omi/backend/schema/insight_maintenant_bilan.dart';
+import 'package:omi/pages/conversation_detail/widgets/conversation_markdown_widget.dart';
+import 'package:omi/pages/insights/insight_labels.dart';
+import 'package:omi/pages/insights/insight_now_card.dart';
+import 'package:omi/pages/insights/insight_sources.dart';
+import 'package:omi/ui/ui.dart';
+import 'package:omi/utils/l10n_extensions.dart';
+import 'package:omi/utils/other/temp.dart';
+
+/// Clone local : la carte « Bilan » de l'onglet Insights, le plus récent (titre, période, nombre d'essais).
+/// La toucher ouvre le bilan, où les précédents se choisissent par la flèche.
+class InsightBilanCard extends StatelessWidget {
+  const InsightBilanCard({super.key, required this.bilan, required this.onTap});
+
+  final InsightBilanSummary bilan;
+  final VoidCallback onTap;
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = context.l10n;
+    return Semantics(
+      button: true,
+      child: Material(
+        color: OmiColors.surface1,
+        borderRadius: OmiRadius.mdAll,
+        child: InkWell(
+          key: const ValueKey('insight_bilan_card'),
+          borderRadius: OmiRadius.mdAll,
+          onTap: onTap,
+          child: ConstrainedBox(
+            constraints: const BoxConstraints(minHeight: 64),
+            child: Padding(
+              padding: const EdgeInsets.symmetric(horizontal: OmiSpacing.md, vertical: OmiSpacing.sm),
+              child: Row(
+                children: [
+                  ExcludeSemantics(
+                    child: Icon(Icons.auto_stories_outlined, size: 22, color: OmiColors.textTertiary),
+                  ),
+                  const SizedBox(width: OmiSpacing.sm),
+                  Expanded(
+                    child: Column(
+                      crossAxisAlignment: CrossAxisAlignment.start,
+                      mainAxisSize: MainAxisSize.min,
+                      children: [
+                        Text(
+                          l10n.insightBilanLatest,
+                          style: OmiType.footnote.copyWith(color: OmiColors.textTertiary, fontWeight: FontWeight.w600),
+                        ),
+                        const SizedBox(height: 2),
+                        Text(
+                          insightBilanTitle(l10n, bilan),
+                          maxLines: 2,
+                          overflow: TextOverflow.ellipsis,
+                          style: OmiType.headline,
+                        ),
+                        const SizedBox(height: 2),
+                        Text(
+                          insightBilanMeta(l10n, OmiDateFormat.of(context), bilan),
+                          style: OmiType.footnote.copyWith(color: OmiColors.textTertiary),
+                        ),
+                      ],
+                    ),
+                  ),
+                  const SizedBox(width: OmiSpacing.xs),
+                  ExcludeSemantics(child: Icon(Icons.chevron_right_rounded, size: 20, color: OmiColors.textTertiary)),
+                ],
+              ),
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+/// Ouvre un bilan par-dessus l'accueil ; [bilans] (le plus récent d'abord) nourrit le choix des précédents. Se
+/// termine quand on en revient.
+Future<void> routeToInsightBilan(
+  BuildContext context,
+  InsightBilanSummary bilan, {
+  List<InsightBilanSummary> bilans = const [],
+  InsightsApi? api,
+  InsightSourceOpener sources = const InsightSourceOpener(),
+}) {
+  return routeToPage(context, InsightBilanPage(initial: bilan, bilans: bilans, api: api, sources: sources));
+}
+
+/// Clone local : un bilan en entier. Ses sections libres (titres choisis par Omi, rendues comme les résumés des
+/// conversations), le suivi des essais du bilan précédent, puis les essais proposés pour la suite, chacun avec son
+/// statut (icône et libellé) et son constat ; les sources s'ouvrent. La flèche à côté du titre choisit un bilan
+/// précédent ; appui long sur le titre : retirer le bilan.
+class InsightBilanPage extends StatefulWidget {
+  const InsightBilanPage({
+    super.key,
+    required this.initial,
+    this.bilans = const [],
+    this.api,
+    this.sources = const InsightSourceOpener(),
+  });
+
+  final InsightBilanSummary initial;
+  final List<InsightBilanSummary> bilans;
+  final InsightsApi? api;
+  final InsightSourceOpener sources;
+
+  @override
+  State<InsightBilanPage> createState() => _InsightBilanPageState();
+}
+
+class _InsightBilanPageState extends State<InsightBilanPage> {
+  late final InsightsApi _api = widget.api ?? InsightsApi();
+  late List<InsightBilanSummary> _bilans = widget.bilans.isEmpty ? [widget.initial] : widget.bilans;
+  late InsightBilanSummary _current = widget.initial;
+  InsightBilan? _bilan;
+  ApiProblem? _problem;
+
+  /// Une réponse arrivée après le choix d'un autre bilan est ignorée.
+  int _request = 0;
+
+  @override
+  void initState() {
+    super.initState();
+    unawaited(_load());
+    unawaited(_refreshList());
+  }
+
+  Future<void> _load({bool reportFailure = false}) async {
+    final request = ++_request;
+    final result = await _api.bilan(_current.id);
+    if (!mounted || request != _request) return;
+    final shown = _bilan != null;
+    setState(() {
+      switch (result) {
+        case ApiSuccess(:final data):
+          _bilan = data;
+          _problem = null;
+        case ApiFailure(:final problem):
+          // Un bilan retiré entre-temps ne se montre plus ; une autre panne garde ce qui est affiché.
+          if (problem.kind == ApiProblemKind.notFound) _bilan = null;
+          _problem = problem;
+      }
+    });
+    if (reportFailure && shown && _bilan != null && result is ApiFailure) {
+      OmiFeedback.error(context, context.l10n.insightBilanLoadError);
+    }
+  }
+
+  /// La liste des bilans pour la flèche (un bilan a pu arriver depuis l'ouverture de l'onglet).
+  Future<void> _refreshList() async {
+    final result = await _api.bilans();
+    if (!mounted) return;
+    if (result case ApiSuccess(:final data) when data.isNotEmpty) setState(() => _bilans = data);
+  }
+
+  Future<void> _choose() async {
+    OmiHaptics.selection();
+    final chosen = await showInsightBilanChooser(context, bilans: _bilans, currentId: _current.id);
+    if (chosen == null || chosen.id == _current.id || !mounted) return;
+    setState(() {
+      _current = chosen;
+      _bilan = null;
+      _problem = null;
+    });
+    await _load();
+  }
+
+  Future<void> _showMenu(InsightBilanSummary bilan) async {
+    final l10n = context.l10n;
+    final chosen = Completer<bool>();
+    await showOmiRowMenu(context, title: insightBilanTitle(l10n, bilan), actions: [
+      OmiMenuAction(
+        icon: Icons.remove_circle_outline_rounded,
+        label: l10n.insightRemove,
+        isDestructive: true,
+        onSelected: () => chosen.complete(true),
+      ),
+    ]);
+    if (!chosen.isCompleted || !mounted) return;
+    final confirmed = await showOmiConfirm(
+      context,
+      title: l10n.insightBilanRemoveQuestion,
+      message: l10n.insightBilanRemoveMessage,
+      confirmLabel: l10n.insightRemove,
+      destructive: true,
+    );
+    if (!confirmed || !mounted) return;
+    final result = await _api.removeBilan(bilan.id);
+    if (!mounted) return;
+    // Déjà retiré ailleurs (404 ou deja_retire) : il n'a plus sa place non plus.
+    final removed = switch (result) {
+      ApiSuccess() => true,
+      ApiFailure(:final problem) => problem.kind == ApiProblemKind.notFound,
+    };
+    if (!removed) {
+      OmiFeedback.error(context, l10n.somethingWentWrong);
+      return;
+    }
+    OmiHaptics.success();
+    OmiFeedback.confirm(context, l10n.insightRemoved);
+    Navigator.of(context).pop(true);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Scaffold(
+      backgroundColor: OmiColors.surface0,
+      appBar: AppBar(
+        backgroundColor: OmiColors.surface0,
+        leading: const OmiBackButton(),
+        title: Text(context.l10n.insightBilanTitle, style: OmiType.headline),
+      ),
+      body: _body(context),
+    );
+  }
+
+  Widget _body(BuildContext context) {
+    final l10n = context.l10n;
+    final bilan = _bilan;
+    if (bilan == null || !bilan.summary.isActive) {
+      final problem = _problem;
+      if (bilan == null && problem == null) return const OmiLoadingState();
+      if (bilan != null || problem!.kind == ApiProblemKind.notFound) {
+        return OmiEmptyState(icon: Icons.event_busy_outlined, title: l10n.insightBilanGone);
+      }
+      return OmiErrorState(message: l10n.insightBilanLoadError, onRetry: _load);
+    }
+    final slivers = <Widget>[
+      SliverPadding(
+        padding: const EdgeInsets.fromLTRB(OmiSpacing.md, OmiSpacing.xs, OmiSpacing.md, 0),
+        sliver: SliverToBoxAdapter(
+          child: _InsightBilanHeader(
+            bilan: bilan.summary,
+            canChoose: _bilans.length > 1,
+            onChoose: () => unawaited(_choose()),
+            onLongPress: () => unawaited(_showMenu(bilan.summary)),
+          ),
+        ),
+      ),
+    ];
+    for (final (index, section) in bilan.sections.indexed) {
+      final title = section.title;
+      slivers.add(SliverPadding(
+        key: ValueKey('insight_bilan_section_$index'),
+        padding: const EdgeInsets.fromLTRB(OmiSpacing.md, OmiSpacing.xl, OmiSpacing.md, 0),
+        sliver: SliverToBoxAdapter(child: title != null ? OmiSectionHeader(title) : const SizedBox.shrink()),
+      ));
+      slivers.add(SliverPadding(
+        padding: const EdgeInsets.symmetric(horizontal: OmiSpacing.md + OmiSpacing.xxs),
+        sliver: ConversationMarkdownSliver(content: section.text),
+      ));
+    }
+    void openChat(String id) => unawaited(widget.sources.openChat(context, id));
+    void openConversation(String id) => unawaited(widget.sources.openConversation(context, id));
+    if (bilan.followUps.isNotEmpty) {
+      slivers.add(_sectionHeader(l10n.insightBilanFollowUpTitle));
+      slivers.add(_cards([
+        for (final (index, followUp) in bilan.followUps.indexed)
+          InsightFollowUpCard(key: ValueKey('insight_follow_up_$index'), followUp: followUp),
+      ]));
+    }
+    if (bilan.trials.isNotEmpty) {
+      slivers.add(_sectionHeader(l10n.insightBilanTrialsTitle));
+      slivers.add(_cards([
+        for (final trial in bilan.trials)
+          InsightTrialCard(trial: trial, onOpenChat: openChat, onOpenConversation: openConversation),
+      ]));
+    }
+    if (bilan.isEmpty) {
+      slivers.add(SliverPadding(
+        padding: const EdgeInsets.fromLTRB(OmiSpacing.md + OmiSpacing.xxs, OmiSpacing.xl, OmiSpacing.md, 0),
+        sliver: SliverToBoxAdapter(
+          child: Text(l10n.insightBilanEmpty, style: OmiType.subhead.copyWith(color: OmiColors.textTertiary)),
+        ),
+      ));
+    }
+    slivers.add(SliverPadding(
+      padding: EdgeInsets.only(bottom: OmiSpacing.xxl + MediaQuery.viewPaddingOf(context).bottom),
+    ));
+    return RefreshIndicator(
+      onRefresh: () => Future.wait([_load(reportFailure: true), _refreshList()]),
+      child: CustomScrollView(
+        key: ValueKey('insight_bilan_${bilan.id}'),
+        physics: const AlwaysScrollableScrollPhysics(),
+        slivers: slivers,
+      ),
+    );
+  }
+
+  Widget _sectionHeader(String title) => SliverPadding(
+        padding: const EdgeInsets.fromLTRB(OmiSpacing.md, OmiSpacing.xl, OmiSpacing.md, 0),
+        sliver: SliverToBoxAdapter(child: OmiSectionHeader(title)),
+      );
+
+  Widget _cards(List<Widget> cards) => SliverPadding(
+        padding: const EdgeInsets.symmetric(horizontal: OmiSpacing.md),
+        sliver: SliverList.separated(
+          itemCount: cards.length,
+          separatorBuilder: (_, __) => const SizedBox(height: OmiSpacing.xs),
+          itemBuilder: (_, index) => cards[index],
+        ),
+      );
+}
