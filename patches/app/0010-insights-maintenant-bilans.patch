+  await tester.pumpAndSettle();
+}
+
+String _lineId(int index) => (_banc()['lignes'] as List)[index]['id'] as String;
+
+double _contrast(Color ink, Color background) {
+  final blended = Color.alphaBlend(ink, background);
+  final a = blended.computeLuminance();
+  final b = background.computeLuminance();
+  return (a > b ? a + 0.05 : b + 0.05) / (a > b ? b + 0.05 : a + 0.05);
+}
+
+Color? _inkOf(RichText text) {
+  Color? ink;
+  text.text.visitChildren((span) {
+    ink = span.style?.color;
+    return ink == null;
+  });
+  return ink;
+}
+
+/// Le fond réel sous un texte : la première surface colorée au-dessus de lui.
+Color _backgroundOf(Element element) {
+  Color? found;
+  element.visitAncestorElements((ancestor) {
+    final widget = ancestor.widget;
+    if (widget is Material && widget.type != MaterialType.transparency && widget.color != null) {
+      found = widget.color;
+    } else if (widget is DecoratedBox) {
+      final decoration = widget.decoration;
+      if (decoration is BoxDecoration && decoration.color != null) found = decoration.color;
+    } else if (widget is Scaffold && widget.backgroundColor != null) {
+      found = widget.backgroundColor;
+    }
+    return found == null;
+  });
+  return found ?? OmiPalette.light.surface0;
+}
+
+/// Tout texte (icônes comprises) d'au moins 4,5:1 sur son fond réel, en thème clair.
+void _expectReadable(WidgetTester tester, {required int atLeast}) {
+  var checked = 0;
+  for (final element in find.byType(RichText).evaluate()) {
+    final text = element.widget as RichText;
+    final ink = _inkOf(text);
+    if (ink == null || ink.a == 0) continue;
+    checked++;
+    final background = _backgroundOf(element);
+    expect(_contrast(ink, background), greaterThanOrEqualTo(4.5),
+        reason: '« ${text.text.toPlainText()} » sur $background');
+  }
+  expect(checked, greaterThanOrEqualTo(atLeast));
+}
