index 0000000000..25ca5018f5
--- /dev/null
+++ b/app/lib/backend/schema/insight_maintenant_bilan.dart
@@ -0,0 +1,344 @@
+/// Clone local : Insights « Maintenant » (le direct : ce qui compte dans l'immédiat) et « Bilans » (la
+/// profondeur : un bilan par période, des sections libres, des essais et leur suivi).
+///
+/// Formes rendues par les routes du serveur du clone (`/v1/insights/maintenant…`, `/v1/insights/bilans…`). Le
+/// contenu est écrit par le traitement du clone ; l'app le lit et ne peut que retirer (une ligne ou un bilan).
+/// Dart pur (sans Flutter) pour être testé seul. Lecture tolérante : une ligne, une section, un essai ou une
+/// source illisible est écarté sans cacher le reste ; un champ inconnu est ignoré. Aucun nombre maximal : le
+/// modèle juge combien de lignes, de sections et d'essais il faut.
+library;
+
+import 'package:omi/backend/schema/insight_dossier.dart';
+
+/// Les natures connues d'une ligne de « Maintenant » ; une autre reste affichée telle quelle (en neutre).
+const insightNatures = ['agir', 'surveiller', 'conseil', 'encourager'];
+
+/// Les statuts connus d'un essai ; un autre reste affiché tel quel (en neutre).
+const insightTrialStatuses = ['propose', 'tente', 'pas_tente', 'inconnu'];
+
+/// Les sources d'une ligne ou d'un essai : discussions du chat et conversations (ouvrables), et deux appuis
+/// sans rien à ouvrir (le planning, le journal).
+class InsightLinkedSources {
+  const InsightLinkedSources({
+    this.messages = const [],
+    this.sessions = const [],
+    this.conversations = const [],
+    this.planning = false,
+    this.journal = false,
+  });
+
+  final List<String> messages;
+  final List<InsightSessionSource> sessions;
+  final List<InsightConversationSource> conversations;
+  final bool planning;
+  final bool journal;
+
+  /// Rien à montrer (les messages seuls ne s'ouvrent pas).
+  bool get isEmpty => sessions.isEmpty && conversations.isEmpty && !planning && !journal;
+
+  /// Ce qui s'ouvre d'un toucher : les discussions et conversations encore là.
+  int get openableCount =>
+      sessions.where((source) => source.available).length + conversations.where((source) => source.available).length;
+
+  static InsightLinkedSources parse(Object? json) {
+    if (json is! Map) return const InsightLinkedSources();
+    final messages = json['messages'];
+    final sessions = json['sessions'];
+    final conversations = json['conversations'];
+    final single = InsightSessionSource.tryParse(json['session']);
+    return InsightLinkedSources(
+      messages: messages is List ? messages.whereType<String>().toList() : const [],
+      sessions: uniqueById([
+        if (sessions is List) ...sessions.map(InsightSessionSource.tryParse).whereType<InsightSessionSource>(),
+        if (single != null) single,
+      ], (source) => source.id),
+      conversations: conversations is List
+          ? uniqueById(
+              conversations.map(InsightConversationSource.tryParse).whereType<InsightConversationSource>(),
+              (source) => source.id,
+            )
+          : const [],
+      planning: json['planning'] == true,
+      journal: json['journal'] == true,
+    );
+  }
+}
+
+/// Une ligne de « Maintenant ».
+class InsightNowLine {
+  const InsightNowLine({
+    required this.id,
+    required this.text,
+    this.nature,
+    this.domain,
+    this.quote,
+    this.heardInConversation = false,
+    this.sources = const InsightLinkedSources(),
+  });
+
+  final String id;
+  final String text;
+
+  /// `agir`, `surveiller`, `conseil`, `encourager`, ou un autre mot choisi par Omi (affiché neutre).
+  final String? nature;
+
+  /// Domaine libre (pro, perso, santé, famille…).
+  final String? domain;
+
+  /// Extrait exact d'où vient la ligne.
+  final String? quote;
+
+  /// Les mots d'un autre que Mike, entendus dans une conversation enregistrée (origine `conversation`).
+  final bool heardInConversation;
+  final InsightLinkedSources sources;
+
+  static InsightNowLine? tryParse(Object? json) {
+    if (json is! Map) return null;
+    final id = _string(json['id']);
+    final text = _string(json['texte']);
+    if (id == null || text == null) return null;
+    final nature = _string(json['nature']);
+    return InsightNowLine(
+      id: id,
+      text: text,
+      nature: nature == null ? null : _known(nature, insightNatures),
+      domain: _string(json['domaine']),
+      quote: _string(json['citation']),
+      heardInConversation:
+          json['dit_par_autre'] is bool ? json['dit_par_autre'] as bool : _string(json['origine']) == 'conversation',
+      sources: InsightLinkedSources.parse(json['sources']),
+    );
+  }
+}
+
+/// « Maintenant » en entier : lignes dans l'ordre choisi par Omi, résumé éventuel, date du dernier point.
+class InsightNow {
+  const InsightNow({this.lines = const [], this.summary, this.updatedAt, this.version = 0});
+
+  static const empty = InsightNow();
+
+  final List<InsightNowLine> lines;
+
+  /// Une phrase qui résume le moment (peut manquer).
+  final String? summary;
+  final DateTime? updatedAt;
+  final int version;
+
+  bool get isEmpty => lines.isEmpty && summary == null;
+
+  factory InsightNow.fromJson(Map<String, dynamic> json) {
+    final lines = json['lignes'];
+    return InsightNow(
+      lines: lines is List
+          ? uniqueById(lines.map(InsightNowLine.tryParse).whereType<InsightNowLine>(), (line) => line.id)
+          : const [],
+      summary: _string(json['resume']),
+      updatedAt: _date(json['maj']),
+      version: _int(json['version']),
+    );
+  }
+
+  /// Sans la ligne [id] (affichage immédiat après un retrait).
+  InsightNow without(String id) => InsightNow(
+        lines: lines.where((line) => line.id != id).toList(),
+        summary: summary,
+        updatedAt: updatedAt,
+        version: version,
+      );
+}
+
+/// La période d'un bilan (l'une ou l'autre borne peut manquer).
+class InsightPeriod {
+  const InsightPeriod({this.start, this.end});
+
+  final DateTime? start;
+  final DateTime? end;
+
+  static InsightPeriod parse(Object? json) {
+    if (json is! Map) return const InsightPeriod();
+    return InsightPeriod(start: _date(json['debut']), end: _date(json['fin']));
+  }
+}
+
+/// Une ligne de la liste des bilans.
+class InsightBilanSummary {
+  const InsightBilanSummary({
+    required this.id,
+    this.title,
+    this.period = const InsightPeriod(),
+    this.updatedAt,
+    this.version = 0,
+    this.status = 'actif',
+    this.trialCount = 0,
+  });
+
+  final String id;
+
+  /// Choisi par Omi ; peut manquer (l'app montre alors « Bilan » et la période).
+  final String? title;
+  final InsightPeriod period;
+  final DateTime? updatedAt;
+  final int version;
+  final String status;
+  final int trialCount;
+
+  bool get isActive => status == 'actif';
+
+  /// Throws [FormatException] for a row without id.
+  factory InsightBilanSummary.fromJson(Map<String, dynamic> json) {
+    final id = _string(json['id']);
+    if (id == null) throw const FormatException('Invalid insight review');
+    return InsightBilanSummary(
+      id: id,
+      title: _string(json['titre']),
+      period: InsightPeriod.parse(json['periode']),
+      updatedAt: _date(json['maj']),
+      version: _int(json['version']),
+      status: _string(json['statut']) ?? 'actif',
+      trialCount: _int(json['nb_essais']),
+    );
+  }
+}
+
+/// Une section libre d'un bilan : un titre choisi par Omi (peut manquer) et du markdown.
+class InsightBilanSection {
+  const InsightBilanSection({this.title, required this.text});
+
+  final String? title;
+  final String text;
+
+  static InsightBilanSection? tryParse(Object? json) {
+    if (json is! Map) return null;
+    final text = _string(json['texte']);
+    if (text == null) return null;
+    return InsightBilanSection(title: _string(json['titre']), text: text);
+  }
+}
+
+/// Un essai concret proposé pour la période suivante.
+class InsightTrial {
+  const InsightTrial({
+    required this.id,
+    required this.text,
+    this.domain,
+    this.status = 'propose',
+    this.outcome,
+    this.sources = const InsightLinkedSources(),
+  });
+
+  final String id;
+  final String text;
+  final String? domain;
+
+  /// `propose`, `tente`, `pas_tente`, `inconnu`, ou un autre mot (affiché neutre).
+  final String status;
+
+  /// Le constat, quand il y en a un.
+  final String? outcome;
+  final InsightLinkedSources sources;
+
+  static InsightTrial? tryParse(Object? json) {
+    if (json is! Map) return null;
+    final id = _string(json['id']);
+    final text = _string(json['texte']);
+    if (id == null || text == null) return null;
+    return InsightTrial(
+      id: id,
+      text: text,
+      domain: _string(json['domaine']),
+      status: _known(_string(json['statut']) ?? 'propose', insightTrialStatuses),
+      outcome: _string(json['constat']),
+      sources: InsightLinkedSources.parse(json['sources']),
+    );
+  }
+}
+
+/// Ce qu'est devenu un essai d'un bilan précédent.
+class InsightTrialFollowUp {
+  const InsightTrialFollowUp({
+    this.trialId,
+    this.bilanId,
+    this.text,
+    this.domain,
+    this.available = false,
+    this.status = 'inconnu',
+    this.outcome,
+  });
+
+  final String? trialId;
+  final String? bilanId;
+
+  /// Le texte de l'essai d'origine (null s'il ne se lit plus).
+  final String? text;
+  final String? domain;
+
+  /// False : le bilan d'origine ne se lit plus (le texte peut venir du suivi lui-même).
+  final bool available;
+  final String status;
+  final String? outcome;
+
+  static InsightTrialFollowUp? tryParse(Object? json) {
+    if (json is! Map) return null;
+    final trialId = _string(json['essai_id']);
+    final text = _string(json['texte']);
+    if (trialId == null && text == null) return null;
+    return InsightTrialFollowUp(
+      trialId: trialId,
+      bilanId: _string(json['bilan_id']),
+      text: text,
+      domain: _string(json['domaine']),
+      available: json['disponible'] == true,
+      status: _known(_string(json['statut']) ?? 'inconnu', insightTrialStatuses),
+      outcome: _string(json['constat']),
+    );
+  }
+}
+
+/// Un bilan lu en entier.
+class InsightBilan {
+  const InsightBilan({
+    required this.summary,
+    this.sections = const [],
+    this.trials = const [],
+    this.followUps = const [],
+  });
+
+  final InsightBilanSummary summary;
+  final List<InsightBilanSection> sections;
+  final List<InsightTrial> trials;
+  final List<InsightTrialFollowUp> followUps;
+
+  String get id => summary.id;
+
+  bool get isEmpty => sections.isEmpty && trials.isEmpty && followUps.isEmpty;
+
+  factory InsightBilan.fromJson(Map<String, dynamic> json) {
+    final sections = json['sections'];
+    final trials = json['essais'];
+    final followUps = json['suivi'];
+    return InsightBilan(
+      summary: InsightBilanSummary.fromJson(json),
+      sections: sections is List
+          ? sections.map(InsightBilanSection.tryParse).whereType<InsightBilanSection>().toList()
+          : const [],
+      trials: trials is List
+          ? uniqueById(trials.map(InsightTrial.tryParse).whereType<InsightTrial>(), (trial) => trial.id)
+          : const [],
+      followUps: followUps is List
+          ? followUps.map(InsightTrialFollowUp.tryParse).whereType<InsightTrialFollowUp>().toList()
+          : const [],
+    );
+  }
+}
+
+/// Une valeur connue écrite autrement (« Agir », « pas tenté ») ramenée à sa clé ; sinon gardée telle quelle.
+String _known(String value, List<String> keys) {
+  final key = value.trim().toLowerCase().replaceAll(RegExp(r'[\s-]+'), '_').replaceAll('é', 'e');
+  return keys.contains(key) ? key : value.trim();
+}
+
+String? _string(Object? value) => value is String && value.trim().isNotEmpty ? value.trim() : null;
+
+DateTime? _date(Object? value) => value is String ? DateTime.tryParse(value) : null;
+
+int _int(Object? value) => value is num ? value.toInt() : 0;
