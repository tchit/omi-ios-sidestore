index 0000000000..f92597a905
--- /dev/null
+++ b/app/lib/pages/insights/insight_now_card.dart
@@ -0,0 +1,364 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+
+import 'package:omi/backend/http/api/insights.dart';
+import 'package:omi/backend/http/api_result.dart';
+import 'package:omi/backend/schema/insight_maintenant_bilan.dart';
+import 'package:omi/pages/insights/insight_dossier_page.dart';
+import 'package:omi/pages/insights/insight_labels.dart';
+import 'package:omi/pages/insights/insight_sources.dart';
+import 'package:omi/ui/ui.dart';
+import 'package:omi/utils/l10n_extensions.dart';
+
+/// Clone local : la carte « Maintenant », en haut de l'onglet Insights. Ce qui compte dans l'immédiat (agir,
+/// surveiller, un conseil, un bon signe…), tenu à jour par Omi après chaque conversation ou discussion et chaque
+/// matin. Autant de lignes qu'Omi le juge (aucune, une, douze…), dans son ordre. Chaque ligne montre sa nature par
+/// une icône ET un libellé (jamais la couleur seule) ; la toucher ouvre sa source ; appui long : la retirer.
+/// Encres : textPrimary et textTertiary, au moins 4,5:1 sur la carte en thème clair (textSecondary, translucide,
+/// n'y donne que 3,4:1 ; Mike lit en thème clair).
+class InsightNowCard extends StatelessWidget {
+  const InsightNowCard({
+    super.key,
+    required this.now,
+    this.problem,
+    required this.onRetry,
+    required this.onOpenLine,
+    required this.onRemoveLine,
+  });
+
+  /// Null tant que rien n'a été lu.
+  final InsightNow? now;
+
+  /// La dernière lecture a échoué (ce qui était affiché reste).
+  final ApiProblem? problem;
+  final VoidCallback onRetry;
+  final ValueChanged<InsightNowLine> onOpenLine;
+  final ValueChanged<InsightNowLine> onRemoveLine;
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = context.l10n;
+    final now = this.now;
+    final updatedAt = now?.updatedAt;
+    final summary = now?.summary;
+    final children = <Widget>[
+      Padding(
+        padding: const EdgeInsets.fromLTRB(OmiSpacing.md, OmiSpacing.md, OmiSpacing.md, OmiSpacing.xs),
+        // Le titre en entier, l'heure à droite ; en grand texte, l'heure passe dessous plutôt que de couper le titre.
+        child: Wrap(
+          alignment: WrapAlignment.spaceBetween,
+          crossAxisAlignment: WrapCrossAlignment.end,
+          spacing: OmiSpacing.sm,
+          children: [
+            Semantics(header: true, child: Text(l10n.insightNowTitle, style: OmiType.headline)),
+            if (updatedAt != null)
+              Text(
+                l10n.insightNowUpdated(OmiDateFormat.of(context).timestamp(updatedAt.toLocal())),
+                style: OmiType.footnote.copyWith(color: OmiColors.textTertiary),
+              ),
+          ],
+        ),
+      ),
+      if (summary != null)
+        Padding(
+          padding: const EdgeInsets.fromLTRB(OmiSpacing.md, 0, OmiSpacing.md, OmiSpacing.xs),
+          child: Text(summary, style: OmiType.subhead),
+        ),
+    ];
+    if (now == null && problem == null) {
+      children.add(const Padding(
+        padding: EdgeInsets.all(OmiSpacing.md),
+        child: Center(child: OmiSpinner(size: OmiSpinnerSize.small)),
+      ));
+    } else if (now == null) {
+      children.add(_InsightNowFailure(onRetry: onRetry));
+    } else if (now.lines.isEmpty) {
+      children.add(Padding(
+        key: const ValueKey('insight_now_empty'),
+        padding: const EdgeInsets.fromLTRB(OmiSpacing.md, 0, OmiSpacing.md, OmiSpacing.md),
+        child: Text(l10n.insightNowEmpty, style: OmiType.subhead.copyWith(color: OmiColors.textTertiary)),
+      ));
+    } else {
+      for (final (index, line) in now.lines.indexed) {
+        if (index > 0) {
+          children.add(Divider(height: 1, thickness: 0.5, color: OmiColors.border, indent: 44, endIndent: 0));
+        }
+        children.add(InsightNowLineTile(
+          line: line,
+          onTap: () => onOpenLine(line),
+          onLongPress: () => onRemoveLine(line),
+        ));
+      }
+      children.add(const SizedBox(height: OmiSpacing.xs));
+    }
+    return Material(
+      key: const ValueKey('insight_now_card'),
+      color: OmiColors.surface1,
+      borderRadius: OmiRadius.mdAll,
+      clipBehavior: Clip.antiAlias,
+      child: Column(crossAxisAlignment: CrossAxisAlignment.stretch, mainAxisSize: MainAxisSize.min, children: children),
+    );
+  }
+}
+
+class _InsightNowFailure extends StatelessWidget {
+  const _InsightNowFailure({required this.onRetry});
+
+  final VoidCallback onRetry;
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = context.l10n;
+    return Padding(
+      padding: const EdgeInsets.fromLTRB(OmiSpacing.md, 0, OmiSpacing.xs, OmiSpacing.xs),
+      child: Row(
+        children: [
+          ExcludeSemantics(child: Icon(Icons.cloud_off_rounded, size: 18, color: OmiColors.textTertiary)),
+          const SizedBox(width: OmiSpacing.xs),
+          Expanded(
+            child: Text(l10n.insightNowLoadError, style: OmiType.subhead.copyWith(color: OmiColors.textTertiary)),
+          ),
+          OmiButton.tertiary(label: l10n.tryAgain, size: OmiButtonSize.compact, onPressed: onRetry),
+        ],
+      ),
+    );
+  }
+}
+
+/// Une ligne de « Maintenant » : nature (icône et libellé) et domaine, le texte, la citation éventuelle. Toucher :
+/// ouvrir sa source ; appui long : la retirer.
+class InsightNowLineTile extends StatelessWidget {
+  const InsightNowLineTile({super.key, required this.line, required this.onTap, required this.onLongPress});
+
+  final InsightNowLine line;
+  final VoidCallback onTap;
+  final VoidCallback onLongPress;
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = context.l10n;
+    final label = insightNatureLabel(l10n, line.nature);
+    final meta = [if (label != null) label, if (line.domain != null) line.domain!].join(' · ');
+    final quote = line.quote;
+    final hasSources = !line.sources.isEmpty;
+    return InkWell(
+      key: ValueKey('insight_now_line_${line.id}'),
+      onTap: hasSources ? onTap : null,
+      onLongPress: onLongPress,
+      child: ConstrainedBox(
+        constraints: const BoxConstraints(minHeight: 48),
+        child: Padding(
+          padding: const EdgeInsets.fromLTRB(OmiSpacing.md, OmiSpacing.sm, OmiSpacing.xs, OmiSpacing.sm),
+          child: Row(
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              Padding(
+                padding: const EdgeInsets.only(top: 1),
+                child: ExcludeSemantics(
+                  child: Icon(insightNatureIcon(line.nature), size: 20, color: OmiColors.textTertiary),
+                ),
+              ),
+              const SizedBox(width: OmiSpacing.sm),
+              Expanded(
+                child: Column(
+                  crossAxisAlignment: CrossAxisAlignment.start,
+                  children: [
+                    if (meta.isNotEmpty)
+                      Text(
+                        meta,
+                        key: ValueKey('insight_now_meta_${line.id}'),
+                        maxLines: 1,
+                        overflow: TextOverflow.ellipsis,
+                        style: OmiType.footnote.copyWith(color: OmiColors.textTertiary, fontWeight: FontWeight.w600),
+                      ),
+                    if (line.heardInConversation) ...[
+                      const SizedBox(height: 2),
+                      const InsightHeardTag(),
+                      const SizedBox(height: 4),
+                    ],
+                    Text(line.text, style: OmiType.callout),
+                    // La citation en entier : quand la seule source s'ouvre d'un toucher, c'est ici qu'elle se lit.
+                    if (quote != null) ...[
+                      const SizedBox(height: 2),
+                      Text(
+                        quote,
+                        style: OmiType.footnote.copyWith(color: OmiColors.textTertiary, fontStyle: FontStyle.italic),
+                      ),
+                    ],
+                  ],
+                ),
+              ),
+              SizedBox(
+                width: 24,
+                child: hasSources
+                    ? ExcludeSemantics(
+                        child: Icon(Icons.chevron_right_rounded, size: 20, color: OmiColors.textTertiary),
+                      )
+                    : null,
+              ),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+/// Toucher une ligne (ou un essai) : une seule source à ouvrir l'ouvre tout de suite ; sinon (plusieurs, aucune
+/// encore là, planning ou journal) une feuille montre le texte, sa citation et toutes ses sources.
+Future<void> openInsightLinkedSources(
+  BuildContext context, {
+  required String text,
+  String? quote,
+  required InsightLinkedSources sources,
+  required InsightSourceOpener opener,
+}) async {
+  OmiHaptics.selection();
+  if (sources.openableCount == 1) {
+    final session = sources.sessions.where((source) => source.available).firstOrNull;
+    if (session != null) return opener.openChat(context, session.id);
+    final conversation = sources.conversations.firstWhere((source) => source.available);
+    return opener.openConversation(context, conversation.id);
+  }
+  String? chosenChat;
+  String? chosenConversation;
+  await showOmiSheet<void>(
+    context: context,
+    title: context.l10n.insightSources,
+    // Elle défile : un long texte, sa citation et ses sources ne tiennent pas toujours (grand texte, petit écran).
+    builder: (sheetContext) => SingleChildScrollView(
+      padding: const EdgeInsets.only(bottom: OmiSpacing.lg),
+      child: Column(
+        mainAxisSize: MainAxisSize.min,
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Text(text, style: OmiType.body),
+          if (quote != null) ...[
+            const SizedBox(height: OmiSpacing.xs),
+            Text(quote, style: OmiType.subhead.copyWith(color: OmiColors.textTertiary, fontStyle: FontStyle.italic)),
+          ],
+          InsightLinkedSourceChips(
+            sources: sources,
+            showTitle: false,
+            onOpenChat: (id) {
+              chosenChat = id;
+              Navigator.of(sheetContext).pop();
+            },
+            onOpenConversation: (id) {
+              chosenConversation = id;
+              Navigator.of(sheetContext).pop();
+            },
+          ),
+        ],
+      ),
+    ),
+  );
+  if (!context.mounted) return;
+  final chat = chosenChat;
+  final conversation = chosenConversation;
+  if (chat != null) return opener.openChat(context, chat);
+  if (conversation != null) return opener.openConversation(context, conversation);
+}
+
+/// Les sources d'une ligne ou d'un essai, en puces : discussions et conversations (ouvrables ; supprimées :
+/// « N'est plus disponible »), planning et journal (rien à ouvrir).
+class InsightLinkedSourceChips extends StatelessWidget {
+  const InsightLinkedSourceChips({
+    super.key,
+    required this.sources,
+    required this.onOpenChat,
+    required this.onOpenConversation,
+    this.showTitle = true,
+  });
+
+  final InsightLinkedSources sources;
+  final ValueChanged<String> onOpenChat;
+  final ValueChanged<String> onOpenConversation;
+  final bool showTitle;
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = context.l10n;
+    final dates = OmiDateFormat.of(context);
+    final chips = <Widget>[
+      for (final session in sources.sessions) insightChatSourceChip(l10n, session, onOpenChat),
+      for (final conversation in sources.conversations)
+        insightConversationSourceChip(l10n, dates, conversation, onOpenConversation),
+      if (sources.planning)
+        InsightSourceChip(
+          key: const ValueKey('insight_source_planning'),
+          icon: Icons.event_note_outlined,
+          label: l10n.insightSourcePlanning,
+          available: true,
+        ),
+      if (sources.journal)
+        InsightSourceChip(
+          key: const ValueKey('insight_source_journal'),
+          icon: Icons.menu_book_outlined,
+          label: l10n.insightSourceJournal,
+          available: true,
+        ),
+    ];
+    if (chips.isEmpty) return const SizedBox.shrink();
+    return Padding(
+      padding: const EdgeInsets.only(top: OmiSpacing.sm),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          if (showTitle) ...[
+            Text(l10n.insightSources, style: OmiType.footnote.copyWith(color: OmiColors.textTertiary)),
+            const SizedBox(height: OmiSpacing.xxs),
+          ],
+          Wrap(spacing: OmiSpacing.xs, runSpacing: OmiSpacing.xs, children: chips),
+        ],
+      ),
+    );
+  }
+}
+
+/// Appui long sur une ligne : « Retirer », confirmé, puis retirée sur le serveur (Omi ne la remettra plus).
+/// Rend « Maintenant » à jour, ou null si rien n'a changé ici (annulé, échec ; une ligne déjà partie relit tout
+/// par [onGone]).
+Future<InsightNow?> removeInsightNowLine(
+  BuildContext context,
+  InsightsApi api,
+  InsightNowLine line, {
+  required VoidCallback onGone,
+}) async {
+  final chosen = Completer<bool>();
+  await showOmiRowMenu(context, title: line.text, actions: [
+    OmiMenuAction(
+      icon: Icons.remove_circle_outline_rounded,
+      label: context.l10n.insightRemove,
+      isDestructive: true,
+      onSelected: () => chosen.complete(true),
+    ),
+  ]);
+  if (!chosen.isCompleted || !context.mounted) return null;
+  final l10n = context.l10n;
+  final confirmed = await showOmiConfirm(
+    context,
+    title: l10n.insightNowRemoveQuestion,
+    message: l10n.insightNowRemoveMessage,
+    confirmLabel: l10n.insightRemove,
+    destructive: true,
+  );
+  if (!confirmed || !context.mounted) return null;
+  final result = await api.removeNowLine(line.id);
+  if (!context.mounted) return null;
+  switch (result) {
+    case ApiSuccess(:final data):
+      OmiHaptics.success();
+      OmiFeedback.confirm(context, l10n.insightRemoved);
+      return data.now;
+    case ApiFailure(:final problem) when problem.kind == ApiProblemKind.notFound:
+      // Déjà partie (Omi a refait le point entre-temps) : pas une panne ; relire montre l'état réel.
+      OmiFeedback.info(context, l10n.insightNowLineGone);
+      onGone();
+      return null;
+    case ApiFailure():
+      OmiFeedback.error(context, l10n.somethingWentWrong);
+      return null;
+  }
+}
