+Future<void> _pump(
+  WidgetTester tester,
+  _Server server, {
+  _Opened? opened,
+  Size size = const Size(390, 2400),
+  double scale = 1,
+}) async {
+  tester.view.physicalSize = size;
+  tester.view.devicePixelRatio = 1;
+  tester.platformDispatcher.textScaleFactorTestValue = scale;
+  addTearDown(tester.view.reset);
+  addTearDown(tester.platformDispatcher.clearTextScaleFactorTestValue);
+  await tester.pumpWidget(MaterialApp(
+    localizationsDelegates: AppLocalizations.localizationsDelegates,
+    supportedLocales: AppLocalizations.supportedLocales,
+    locale: const Locale('fr'),
+    home: Scaffold(
+      backgroundColor: OmiColors.surface0,
+      body: InsightsPage(
+        api: InsightsApi(baseUrl: 'https://example.invalid/', send: server.send),
+        sources: (opened ?? _Opened()).opener,
+      ),
+    ),
+  ));
+  await tester.pumpAndSettle();
+}
+
+Finder _line(String id) => find.byKey(ValueKey('insight_now_line_$id'));
+
+/// Fait défiler l'onglet (ou la page ouverte) jusqu'à [target], puis le touche.
+Future<void> _scrollAndTap(WidgetTester tester, Finder target) async {
+  await tester.scrollUntilVisible(target, 300, scrollable: find.byType(Scrollable).first);
+  await tester.pumpAndSettle();
