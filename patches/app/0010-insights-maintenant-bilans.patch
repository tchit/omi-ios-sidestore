+Map<String, dynamic> _sources({
+  List<Map<String, dynamic>> sessions = const [],
+  List<Map<String, dynamic>> conversations = const [],
+  bool planning = false,
+  bool journal = false,
+}) =>
+    {
+      'messages': ['m-1'],
+      'sessions': sessions,
+      'conversations': conversations,
+      'planning': planning,
+      'journal': journal
+    };
+
+/// « Maintenant » tel que `maintenant_detail` le rend.
+Map<String, dynamic> _now() => {
+      'lignes': [
+        {
+          'id': 'l1',
+          'texte': 'Rappeler Arnaud avant midi',
+          'nature': 'agir',
+          'domaine': 'pro',
+          'citation': 'je dois rappeler Arnaud',
+          'sources': _sources(
+            sessions: [
+              {'id': 's-1', 'titre': 'Point du matin', 'disponible': true}
+            ],
+            conversations: [
+              {'id': 'c-1', 'titre': 'Réunion Arnaud', 'date': '2026-10-10T09:00:00+00:00', 'disponible': true},
