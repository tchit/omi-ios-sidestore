+      expect(bilan.trials.map((t) => (t.id, t.status)), [('y1', 'propose'), ('y2', 'abandonné')]);
+      expect(bilan.trials.first.sources.conversations.single.title, 'Réunion Arnaud');
+      expect(bilan.followUps.length, 2);
+      final tried = bilan.followUps.first;
+      expect((
+        tried.text,
+        tried.status,
+        tried.outcome,
+        tried.available
+      ), (
+        'Couper les écrans à 22 h',
+        'tente',
+        'Trois soirs sur sept.',
