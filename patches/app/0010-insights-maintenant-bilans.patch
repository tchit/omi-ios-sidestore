 import 'package:flutter/material.dart';
 
+import 'package:intl/intl.dart';
+
+import 'package:omi/backend/schema/insight_maintenant_bilan.dart';
 import 'package:omi/l10n/app_localizations.dart';
+import 'package:omi/ui/ui.dart';
 
 /// Clone local : libellés traduits des gabarits et des sections d'Insights. Le serveur envoie une clé fixe
 /// (`gabarit`, `cle`) et un nom français ; une clé inconnue garde ce nom.
@@ -50,3 +54,67 @@ String insightDossierMeta(
       if (count != null) l10n.insightElementCount(count),
       if (updatedAt != null) l10n.insightUpdated(formatDate(updatedAt.toLocal())),
     ].join(' · ');
+
+/// L'icône de la nature d'une ligne de « Maintenant » ; toujours montrée avec son libellé (Mike est daltonien :
+/// ni couleur seule, ni icône seule). Une nature inconnue a une étiquette neutre, une ligne sans nature une puce.
+IconData insightNatureIcon(String? nature) => switch (nature) {
+      'agir' => Icons.bolt_rounded,
+      'surveiller' => Icons.visibility_outlined,
+      'conseil' => Icons.tips_and_updates_outlined,
+      'encourager' => Icons.thumb_up_alt_outlined,
+      null => Icons.circle_outlined,
+      _ => Icons.label_outline_rounded,
+    };
+
+/// Le libellé de la nature ; une nature inconnue garde le mot choisi par Omi (avec sa majuscule) ; sans nature,
+/// null.
+String? insightNatureLabel(AppLocalizations l10n, String? nature) => switch (nature) {
+      'agir' => l10n.insightNatureAct,
+      'surveiller' => l10n.insightNatureWatch,
+      'conseil' => l10n.insightNatureAdvice,
+      'encourager' => l10n.insightNatureEncourage,
+      null => null,
+      _ => _capitalized(nature),
+    };
+
+/// L'icône du statut d'un essai (à essayer, tenté, pas tenté, inconnu), toujours avec son libellé.
+IconData insightTrialStatusIcon(String status) => switch (status) {
+      'propose' => Icons.science_outlined,
+      'tente' => Icons.check_circle_outline_rounded,
+      'pas_tente' => Icons.radio_button_unchecked_rounded,
+      'inconnu' => Icons.help_outline_rounded,
+      _ => Icons.label_outline_rounded,
+    };
+
+String insightTrialStatusLabel(AppLocalizations l10n, String status) => switch (status) {
+      'propose' => l10n.insightTrialProposed,
+      'tente' => l10n.insightTrialTried,
+      'pas_tente' => l10n.insightTrialNotTried,
+      'inconnu' => l10n.insightTrialUnknown,
+      _ => _capitalized(status),
+    };
+
+/// « rappel » → « Rappel » : un mot choisi par Omi s'affiche comme les libellés connus.
+String _capitalized(String word) => word.isEmpty ? word : word[0].toUpperCase() + word.substring(1);
+
+/// « 5 oct. – 11 oct. 2026 » (l'année une fois quand elle est la même), « Depuis le … », « Jusqu'au … » ; null
+/// sans aucune date.
+String? insightPeriodLabel(AppLocalizations l10n, OmiDateFormat dates, InsightPeriod period) {
+  final start = period.start?.toLocal();
+  final end = period.end?.toLocal();
+  if (start == null && end == null) return null;
+  if (start == null) return l10n.insightPeriodUntil(dates.date(end!));
+  if (end == null) return l10n.insightPeriodFrom(dates.date(start));
+  if (start.year == end.year && start.month == end.month && start.day == end.day) return dates.date(end);
+  final startText = start.year == end.year ? DateFormat.MMMd(dates.localeName).format(start) : dates.date(start);
+  return '$startText – ${dates.date(end)}';
+}
+
+/// Le titre d'un bilan : celui choisi par Omi, sinon « Bilan ».
+String insightBilanTitle(AppLocalizations l10n, InsightBilanSummary bilan) => bilan.title ?? l10n.insightBilanTitle;
+
+/// La ligne sous le titre d'un bilan : « 5 oct. – 11 oct. 2026 · 3 essais ».
+String insightBilanMeta(AppLocalizations l10n, OmiDateFormat dates, InsightBilanSummary bilan) => [
+      if (insightPeriodLabel(l10n, dates, bilan.period) case final period?) period,
+      l10n.insightBilanTrialCount(bilan.trialCount),
+    ].join(' · ');
diff --git a/app/lib/pages/insights/insight_now_card.dart b/app/lib/pages/insights/insight_now_card.dart
