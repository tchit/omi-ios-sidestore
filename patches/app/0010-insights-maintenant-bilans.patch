+
+Map<String, dynamic> _bilanSummary(String id, {String? title, int trials = 1}) => {
+      'id': id,
+      'titre': title,
+      'periode': {'debut': '2026-10-05', 'fin': '2026-10-11T23:59:00+04:00'},
+      'maj': '2026-10-11T18:00:00+00:00',
