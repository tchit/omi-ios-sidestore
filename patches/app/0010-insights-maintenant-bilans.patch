+Finder _inLine(String id, Finder matching) =>
+    find.descendant(of: find.byKey(ValueKey('insight_now_line_$id')), matching: matching);
+
+/// Contraste WCAG d'une encre (éventuellement translucide) sur un fond opaque.
+double _contrast(Color ink, Color background) {
+  final blended = Color.alphaBlend(ink, background);
+  final a = blended.computeLuminance();
+  final b = background.computeLuminance();
+  return (a > b ? a + 0.05 : b + 0.05) / (a > b ? b + 0.05 : a + 0.05);
+}
+
+/// L'encre d'un texte rendu : la première couleur posée dans ses morceaux (le markdown la met sur les enfants).
+Color? _inkOf(RichText text) {
+  Color? ink;
+  text.text.visitChildren((span) {
+    ink = span.style?.color;
+    return ink == null;
+  });
+  return ink;
+}
