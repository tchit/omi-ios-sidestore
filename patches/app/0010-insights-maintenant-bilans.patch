+            ],
+          ),
+        },
+        {'id': 'l2', 'texte': 'Le sommeil remonte', 'nature': 'Rappel', 'sources': _sources(journal: true)},
+        // Illisibles : écartées sans cacher le reste.
+        {'id': 'sans texte'},
