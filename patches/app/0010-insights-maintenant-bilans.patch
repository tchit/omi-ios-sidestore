+Map<String, dynamic> _line(
+  String id,
+  String text, {
+  String? nature,
+  String? domain,
+  String? quote,
+  List<Map<String, dynamic>> sessions = const [],
+  List<Map<String, dynamic>> conversations = const [],
+  bool planning = false,
+  bool journal = false,
+}) =>
+    {
+      'id': id,
+      'texte': text,
+      'nature': nature,
+      'domaine': domain,
+      'citation': quote,
+      'sources': {
+        'messages': [],
+        'sessions': sessions,
+        'conversations': conversations,
+        'planning': planning,
+        'journal': journal,
+      },
+    };
+
+const _reunion = {'id': 'c-1', 'titre': 'Réunion Arnaud', 'date': '2026-10-10T09:00:00+00:00', 'disponible': true};
+const _point = {'id': 's-1', 'titre': 'Point du matin', 'disponible': true};
+const _supprime = {'id': 'c-2', 'titre': 'Appel supprimé', 'date': null, 'disponible': false};
+
+List<Map<String, dynamic>> _defaultLines() => [
+      _line('l1', 'Rappeler Arnaud avant midi',
+          nature: 'agir', domain: 'pro', quote: 'je dois rappeler Arnaud', conversations: [_reunion]),
+      _line('l2', 'Le sommeil remonte depuis trois jours',
+          nature: 'encourager',
+          domain: 'santé',
+          sessions: [_point],
+          conversations: [_reunion, _supprime],
+          planning: true),
+      _line('l3', 'Le dossier de la banque attend ta signature', nature: 'surveiller'),
+      _line('l4', 'Couper les écrans plus tôt ce soir', nature: 'conseil', journal: true),
+      _line('l5', 'Préparer la réunion de jeudi', nature: 'rappel'),
+      _line('l6', 'Ligne sans nature ni domaine'),
+    ];
+
+Map<String, dynamic> _summary(String id, String? title, String start, String end, int trials,
+        {String statut = 'actif'}) =>
+    {
+      'id': id,
+      'titre': title,
+      'periode': {'debut': start, 'fin': end},
+      'maj': '${end}T18:00:00+00:00',
+      'version': 1,
+      'statut': statut,
+      'nb_essais': trials,
+    };
+
+/// Un faux serveur du clone : mêmes formes que backend/routers/insights.py (« Maintenant », bilans, dossiers).
+class _Server {
+  final requests = <ApiRequest>[];
+  List<Map<String, dynamic>> lines = _defaultLines();
+  String? resume = 'Une journée chargée côté pro, le reste va mieux.';
+  String? maj = '2026-10-11T04:12:00+00:00';
+  bool failNow = false;
+  bool failBilans = false;
+  final removedLines = <String>{};
+  final goneLines = <String>{};
+  final removedBilans = <String>{};
+
+  late Map<String, Map<String, dynamic>> bilans = {
+    'b-2': {
+      ..._summary('b-2', 'Semaine du 5 octobre', '2026-10-05', '2026-10-11', 2),
+      'sections': [
+        {'titre': 'Pro', 'texte': '- Devis **envoyé**\n- Démo calée pour jeudi'},
+        {'titre': 'Santé', 'texte': 'Le sommeil est meilleur quand les écrans sont coupés tôt.'},
+      ],
+      'suivi': [
+        {
+          'essai_id': 'x1',
+          'bilan_id': 'b-1',
+          'texte': 'Couper les écrans à 22 h',
+          'domaine': 'santé',
+          'disponible': true,
+          'statut': 'tente',
+          'constat': 'Trois soirs sur sept.',
+        },
+        {'essai_id': 'x9', 'bilan_id': 'b-x', 'texte': null, 'disponible': false, 'statut': 'pas_tente'},
+        {'essai_id': 'x2', 'bilan_id': 'b-1', 'texte': 'Appeler mon fils le mercredi', 'statut': 'inconnu'},
+      ],
+      'essais': [
+        {
+          'id': 'y1',
+          'texte': 'Marcher vingt minutes après le déjeuner',
+          'domaine': 'santé',
+          'statut': 'propose',
+          'sources': {
+            'messages': [],
+            'sessions': [],
+            'conversations': [_reunion],
+            'planning': false,
+            'journal': false
+          },
+        },
+        {'id': 'y2', 'texte': 'Essai au statut inconnu', 'statut': 'abandonné'},
+      ],
+    },
+    'b-1': {
+      ..._summary('b-1', 'Semaine du 28 septembre', '2026-09-28', '2026-10-04', 1),
+      'sections': [
+        {'titre': 'Ce qui a bougé', 'texte': 'Le projet avance.'},
+      ],
+      'essais': [
+        {'id': 'x1', 'texte': 'Couper les écrans à 22 h', 'statut': 'propose'},
+      ],
+      'suivi': [],
+    },
+  };
+
+  static http.Response _json(Object body, [int status = 200]) =>
+      http.Response(jsonEncode(body), status, headers: {'content-type': 'application/json; charset=utf-8'});
+
+  Map<String, dynamic> _now() => {
+        'lignes': lines.where((line) => !removedLines.contains(line['id'])).toList(),
+        'resume': resume,
+        'maj': maj,
+        'version': 3 + removedLines.length,
+      };
+
+  Map<String, dynamic> _resume(Map<String, dynamic> bilan) => {
+        for (final key in ['id', 'titre', 'periode', 'maj', 'version', 'statut', 'nb_essais']) key: bilan[key],
+      };
+
+  int count(String method, String path) =>
+      requests.where((r) => r.method == method && Uri.parse(r.url).path == path).length;
+
+  Future<http.Response> send(ApiRequest request) async {
+    requests.add(request);
+    final segments = Uri.parse(request.url).pathSegments;
+    switch (segments[2]) {
+      case 'dossiers':
+        return _json({
+          'dossiers': [
+            {
+              'id': 'arnaud',
+              'titre': 'Arnaud',
+              'gabarit': 'pro',
+              'alias': [],
+              'statut': 'actif',
+              'version': 1,
+              'maj': '2026-10-09T18:30:00+00:00',
+              'nb_elements': 2,
+            },
+          ],
+        });
+      case 'maintenant':
+        if (request.method == 'GET') return failNow ? _json({'detail': 'boom'}, 500) : _json(_now());
+        final id = segments[4];
+        if (goneLines.contains(id)) return _json({'detail': 'Line not found'}, 404);
+        removedLines.add(id);
+        return _json({'status': 'ok', 'deja_retire': false, 'maintenant': _now()});
+      case 'bilans':
+        if (segments.length == 3) {
+          if (failBilans) return _json({'detail': 'boom'}, 500);
+          return _json({
+            'bilans': [
+              for (final bilan in bilans.values)
+                if (!removedBilans.contains(bilan['id'])) _resume(bilan)
+            ],
+          });
+        }
+        final bilan = bilans[segments[3]];
+        if (bilan == null) return _json({'detail': 'Bilan not found'}, 404);
+        if (request.method == 'GET') return _json(bilan);
+        removedBilans.add(segments[3]);
+        return _json({
+          'status': 'ok',
+          'deja_retire': false,
+          'bilan': {..._resume(bilan), 'statut': 'retire'}
+        });
+    }
+    return _json({'detail': 'Not Found'}, 404);
+  }
+}
