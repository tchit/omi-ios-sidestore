+  Future<http.Response> send(ApiRequest request) async {
+    requests.add(request);
+    final segments = Uri.parse(request.url).pathSegments;
+    switch (segments[2]) {
+      case 'maintenant':
+        return _json(now);
+      case 'bilans':
+        if (segments.length == 3) {
+          return _json({
+            'bilans': [_bilan, _bilan]
+          });
+        }
+        return _json(_bilan);
+      case 'dossiers':
+        if (segments.length == 3) {
+          return _json({
+            'dossiers': [_resume, _resume]
+          });
+        }
+        return _json(_dossier);
+    }
+    return _json({'detail': 'Not Found'}, 404);
+  }
+}
