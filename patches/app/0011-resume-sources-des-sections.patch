+    {"name":"speaker bracket", "input":"Fact [spk 1].", "output":"Fact.", "source_ids":[]},
+    {"name":"speaker prose", "input":"Speaker_00: Fact.", "output":"Fact.", "source_ids":[]},
+    {"name":"speaker repeated", "input":"Fact [spk 1] [Speaker_02].", "output":"Fact.", "source_ids":[]},
+    {"name":"ordinary brackets", "input":"Fact [see appendix].", "output":"Fact [see appendix].", "source_ids":[]},
+    {"name":"ordinary ID label link", "input":"Open [RFC-123](https://example.com).", "output":"Open [RFC-123](https://example.com).", "source_ids":[]},
+    {"name":"ordinary link", "input":"Open [see appendix](https://example.com).", "output":"Open [see appendix](https://example.com).", "source_ids":[]},
+    {"name":"unsafe link", "input":"Open [local file](file:///tmp/private).", "output":"Open local file.", "source_ids":[]},
+    {"name":"inline code", "input":"Use `[s01234]` and `[]`.", "output":"Use `[s01234]` and `[]`.", "source_ids":[]},
