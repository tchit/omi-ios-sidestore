@@ -0,0 +1,269 @@
+// Clone local : sources des sections du résumé (0011). L'icône à côté d'un titre ouvre la liste des passages cités
+// (« m:ss · locuteur · texte ») ; toucher un passage ouvre la transcription sur lui, le met en évidence et y cale
+// la lecture.
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:provider/provider.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+import 'package:omi/backend/preferences.dart';
+import 'package:omi/backend/schema/conversation.dart';
+import 'package:omi/backend/schema/structured.dart';
+import 'package:omi/backend/schema/summary_version.dart';
+import 'package:omi/backend/schema/transcript_segment.dart';
+import 'package:omi/l10n/app_localizations.dart';
+import 'package:omi/pages/conversation_detail/conversation_detail_provider.dart';
+import 'package:omi/pages/conversation_detail/conversation_summary_selection.dart';
+import 'package:omi/pages/conversation_detail/page.dart';
+import 'package:omi/pages/conversation_detail/widgets.dart';
+import 'package:omi/pages/conversation_detail/widgets/conversation_section_sources.dart';
+import 'package:omi/providers/app_provider.dart';
+import 'package:omi/providers/connectivity_provider.dart';
+import 'package:omi/providers/conversation_provider.dart';
+import 'package:omi/providers/folder_provider.dart';
+import 'package:omi/providers/integration_provider.dart';
+import 'package:omi/providers/people_provider.dart';
+import 'package:omi/ui/ui.dart';
+import 'package:omi/utils/audio/conversation_playback_controller.dart';
+import 'package:omi/utils/platform/platform_manager.dart';
+import 'package:omi/widgets/conversation_bottom_bar.dart';
+
+TranscriptSegment _segment(String id, double start, String text, {int speakerId = 0, bool isUser = false}) =>
+    TranscriptSegment(
+      id: id,
+      text: text,
+      speaker: 'SPEAKER_0$speakerId',
+      isUser: isUser,
+      personId: null,
+      start: start,
+      end: start + 5,
+      translations: [],
+    );
+
+List<TranscriptSegment> _segments() => [
+      _segment('s1', 3, 'On part sur vendredi.', isUser: true),
+      _segment('s2', 75, 'Le devis arrive lundi.', speakerId: 1),
+      _segment('s3', 130, 'Il faudra prévoir le budget.', speakerId: 2),
+    ];
+
+ServerConversation _conversation({List<SummaryVersion> history = const []}) {
+  final sections = [
+    const Section(heading: 'Décisions', bodyMarkdown: 'On signe vendredi.', sourceSegmentIds: ['s2', 'inconnu', 's1']),
+    const Section(heading: 'Risques', bodyMarkdown: 'Le budget.', sourceSegmentIds: ['inconnu']),
+  ];
+  final structured = Structured('Point devis', ConversationSummarySelection.renderSections(sections), emoji: '🧠');
+  structured.sections = sections;
+  return ServerConversation(
+    id: 'conv-sources',
+    createdAt: DateTime.utc(2026, 10, 19, 9),
+    structured: structured,
+    transcriptSegments: _segments(),
+    summaryHistory: history,
+  );
+}
+
+Future<void> _pumpSummary(
+  WidgetTester tester,
+  ConversationSummarySelection selection,
+  ServerConversation conversation, {
+  ValueChanged<String>? onOpenSource,
+}) async {
+  await tester.pumpWidget(
+    MaterialApp(
+      localizationsDelegates: AppLocalizations.localizationsDelegates,
+      supportedLocales: AppLocalizations.supportedLocales,
+      locale: const Locale('fr'),
+      home: Scaffold(
+        body: CustomScrollView(
+          slivers: [
+            AppResultDetailWidget(
+              summarySelection: selection,
+              app: null,
+              conversation: conversation,
+              onSaveSummarySelection: (_, __) {},
+              onOpenSource: onOpenSource,
+              asSliver: true,
+            ),
+          ],
+        ),
+      ),
+    ),
+  );
+  await tester.pump();
+}
+
+void main() {
+  setUp(() async {
+    SharedPreferences.setMockInitialValues({'has_first_conversation': true});
+    await SharedPreferencesUtil.init();
+    OmiColors.active = OmiPalette.light;
+  });
+
+  testWidgets('only a section with findable passages gets the sources control', (tester) async {
+    final conversation = _conversation();
+    await _pumpSummary(tester, ConversationSummarySelection.select(conversation), conversation, onOpenSource: (_) {});
+    expect(find.text('Décisions'), findsOneWidget);
+    expect(find.text('Risques'), findsOneWidget);
+    expect(find.byKey(const ValueKey('section-sources')), findsOneWidget);
+    final row = find.ancestor(of: find.text('Décisions'), matching: find.byType(Row)).first;
+    expect(find.descendant(of: row, matching: find.byKey(const ValueKey('section-sources'))), findsOneWidget);
+    expect(find.byTooltip('Afficher les sources'), findsOneWidget);
+    // Light theme: the quiet control is the tertiary text colour, never a red/green signal.
+    final icon = tester.widget<Icon>(find.byIcon(Icons.graphic_eq_rounded));
+    expect(icon.color ?? IconTheme.of(tester.element(find.byIcon(Icons.graphic_eq_rounded))).color,
+        OmiPalette.light.textTertiary);
+  });
+
+  testWidgets('without a transcript callback no control is shown', (tester) async {
+    final conversation = _conversation();
+    await _pumpSummary(tester, ConversationSummarySelection.select(conversation), conversation);
+    expect(find.byKey(const ValueKey('section-sources')), findsNothing);
+    expect(find.text('Décisions'), findsOneWidget);
+  });
+
+  testWidgets('the sheet lists m:ss · speaker · text and a tap opens the passage', (tester) async {
+    final conversation = _conversation();
+    final opened = <String>[];
+    final controller = ConversationPlaybackController(segments: conversation.transcriptSegments);
+    addTearDown(controller.dispose);
+    await _pumpSummary(tester, ConversationSummarySelection.select(conversation), conversation, onOpenSource: (id) {
