+      final segment = conversation.transcriptSegments.singleWhere((segment) => segment.id == id);
+      controller.seek(segment.start, strict: true);
+    });
+
+    await tester.tap(find.byKey(const ValueKey('section-sources')));
+    await tester.pumpAndSettle();
+    // Sheet titled by the heading; passages in citation order, unknown ids silently left out.
+    expect(find.text('Décisions'), findsNWidgets(2));
+    final rows = find.byType(SectionSourcesList);
+    expect(find.descendant(of: rows, matching: find.text('1:15')), findsOneWidget);
+    expect(find.descendant(of: rows, matching: find.text('0:03')), findsOneWidget);
+    expect(find.descendant(of: rows, matching: find.textContaining('Le devis arrive lundi.', findRichText: true)),
+        findsOneWidget);
+    expect(find.descendant(of: rows, matching: find.textContaining('Locuteur 1', findRichText: true)), findsOneWidget);
+    expect(find.descendant(of: rows, matching: find.textContaining('Vous', findRichText: true)), findsOneWidget);
+    expect(tester.getTopLeft(find.byKey(const ValueKey('section-source-s2'))).dy,
+        lessThan(tester.getTopLeft(find.byKey(const ValueKey('section-source-s1'))).dy));
+
+    await tester.tap(find.byKey(const ValueKey('section-source-s2')));
+    await tester.pumpAndSettle();
+    expect(opened, ['s2']);
+    expect(find.byType(SectionSourcesList), findsNothing);
+    expect(controller.currentSegmentId, 's2');
+    expect(controller.followTargetSegmentId, 's2');
+    expect(controller.followRequest, 1);
+    expect(controller.pendingWallSeconds, 75);
+    expect(controller.isPlaying, isFalse);
+  });
