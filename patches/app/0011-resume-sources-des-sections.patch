@@ -0,0 +1,45 @@
+// Clone local : réparation des crochets de citation des notes (repris d'Omi, test/unit/note_citation_contract_test.dart ;
+// le contrat est copié dans test/fixtures, la racine du dépôt d'Omi n'étant pas dans la copie de l'app).
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+
+import 'package:omi/utils/note_citations.dart';
+
+void main() {
+  final contract =
+      jsonDecode(File('test/fixtures/note_citation_contract.json').readAsStringSync()) as Map<String, dynamic>;
+  final knownIDs = (contract['known_ids'] as List).cast<String>();
+  for (final item in contract['cases'] as List) {
+    test(item['name'] as String, () {
+      final ids = (item['known_ids'] as List?)?.cast<String>() ?? knownIDs;
+      final result = repairNoteCitations(item['input'] as String, ids);
+      expect(result.text, item['output']);
+      expect(result.sourceIDs, item['source_ids']);
+      expect(repairNoteCitations(result.text, ids).text, item['output']);
+    });
+  }
+
+  test('a transcript segment without an id never rewrites the note', () {
+    const input = '## Decisions\n\n- Fact. [s01234]\n  - Nested detail.\nHard break.  \nNext line.';
+    final result = repairNoteCitations(input, ['', 's01234']);
+    expect(result.text, '## Decisions\n\n- Fact.\n  - Nested detail.\nHard break.  \nNext line.');
+    expect(result.sourceIDs, ['s01234']);
+  });
+
+  test('thousands of protected units restore exactly, including code nested in a link', () {
+    final many = List.generate(3000, (i) => '`c$i` [s01234]').join(' ');
+    final kept = List.generate(3000, (i) => '`c$i`').join(' ');
+    expect(repairNoteCitations(many, ['s01234']).text, kept);
+    final nested = repairNoteCitations('See [`x`](https://e.com) [s01234].', ['s01234']);
+    expect(nested.text, 'See [`x`](https://e.com).');
+    expect(nested.sourceIDs, ['s01234']);
+  });
+
+  test('French notes keep their text and lose only the citation', () {
+    final result = repairNoteCitations('Marie relancera le devis lundi [seg-2].', ['seg-1', 'seg-2']);
+    expect(result.text, 'Marie relancera le devis lundi.');
+    expect(result.sourceIDs, ['seg-2']);
+  });
+}
diff --git a/app/test/unit/summary_section_sources_test.dart b/app/test/unit/summary_section_sources_test.dart
new file mode 100644
index 0000000000..aac6e0e048
--- /dev/null
+++ b/app/test/unit/summary_section_sources_test.dart
@@ -0,0 +1,239 @@
+// Clone local : sources des sections du résumé (0011) — lecture du schéma, versions gardées, rapprochement par titre.
+import 'package:flutter_test/flutter_test.dart';
+
+import 'package:omi/backend/schema/conversation.dart';
+import 'package:omi/backend/schema/structured.dart';
+import 'package:omi/backend/schema/summary_version.dart';
+import 'package:omi/backend/schema/transcript_segment.dart';
+import 'package:omi/pages/conversation_detail/conversation_summary_selection.dart';
+
+TranscriptSegment _segment(String id, double start, {int speakerId = 0, bool isUser = false, String? text}) =>
+    TranscriptSegment(
+      id: id,
+      text: text ?? 'Phrase $id',
+      speaker: 'SPEAKER_0$speakerId',
+      isUser: isUser,
+      personId: null,
+      start: start,
+      end: start + 4,
+      translations: [],
+    );
+
+ServerConversation _conversation({
+  List<Section> sections = const [],
+  String? overview,
+  List<SummaryVersion> history = const [],
+}) {
+  final structured = Structured('Point devis', overview ?? ConversationSummarySelection.renderSections(sections));
+  structured.sections = [...sections];
+  return ServerConversation(
+    id: 'conv-1',
+    createdAt: DateTime.utc(2026, 10, 19, 9),
+    structured: structured,
+    transcriptSegments: [_segment('s1', 3), _segment('s2', 65, speakerId: 1), _segment('s3', 130)],
+    summaryHistory: history,
+  );
+}
+
+SummaryVersion _version({
+  String content = '## Décisions\n\nOn signe vendredi.\n\n## Risques\n\nLe budget.',
+  String kind = 'omi',
+  Object? sources,
+}) =>
+    SummaryVersion.tryParse({
+      'id': 'v1',
+      'kind': kind,
+      if (kind == 'app') 'app_id': 'meeting-notes',
+      'content': content,
+      'recorded_at': '2026-10-18T10:00:00Z',
+      if (sources != null) 'sources': sources,
+    })!;
+
+List<String> _sources(List<SummarySectionSources> sources) =>
+    [for (final entry in sources) '${entry.heading}: ${entry.sourceSegmentIds.join(',')}'];
+
+List<String> _sections(List<Section> sections) =>
+    [for (final section in sections) '${section.heading}: ${(section.sourceSegmentIds ?? []).join(',')}'];
+
+void main() {
+  group('schéma', () {
+    test('the structured notes read each section\'s source_segment_ids', () {
+      final structured = Structured.fromJson({
+        'title': 'Point devis',
+        'overview': '## Décisions\n\nOn signe vendredi.',
+        'emoji': '🧠',
+        'category': 'other',
+        'sections': [
+          {
+            'heading': 'Décisions',
+            'body_markdown': 'On signe vendredi.',
+            'kind': 'main',
+            'source_segment_ids': ['s1', 's2'],
+          },
+          {'heading': 'Risques', 'body_markdown': 'Le budget.'},
+        ],
+      });
+      expect(structured.sections.map((s) => s.sourceSegmentIds), [
+        ['s1', 's2'],
+        null,
+      ]);
+    });
+
+    test('a kept version reads its optional sources and drops unreadable entries', () {
+      final version = _version(sources: [
+        {
+          'heading': 'Décisions',
+          'source_segment_ids': ['s1', '', 7, 's2']
+        },
+        {'heading': 'Vide', 'source_segment_ids': []},
+        {'heading': 'Cassé', 'source_segment_ids': 'pas une liste'},
+        'pas un objet',
+        {
+          'source_segment_ids': ['s3']
+        },
+      ]);
+      expect(_sources(version.sources), ['Décisions: s1,s2', ': s3']);
+      final again = SummaryVersion.tryParse(version.toJson())!;
+      expect(_sources(again.sources), ['Décisions: s1,s2', ': s3']);
+      expect(_version().sources, isEmpty);
+      expect(_version().toJson().containsKey('sources'), isFalse);
+    });
+
+    test('the summaries menu carries a kept version\'s sources', () {
+      final conversation = _conversation(
+        sections: const [Section(heading: 'Décisions', bodyMarkdown: 'Nouveau texte.')],
+        history: [
+          _version(sources: [
+            {
+              'heading': 'Risques',
+              'source_segment_ids': ['s3']
+            }
+          ])
+        ],
+      );
+      final kept = ConversationSummarySelection.choices(conversation).where((c) => !c.isCurrent).single;
+      expect(kept.sources.single.heading, 'Risques');
+      expect(kept.sources.single.sourceSegmentIds, ['s3']);
+    });
+  });
+
+  group('version actuelle', () {
+    test('sections keep known sources, add recovered inline citations and lose the brackets', () {
+      final conversation = _conversation(sections: const [
+        Section(
+            heading: 'Décisions', bodyMarkdown: 'On signe vendredi. [s2]', sourceSegmentIds: ['missing', 's1', 's1']),
+        Section(heading: 'Risques', bodyMarkdown: 'Le budget.'),
+      ]);
+      final selection = ConversationSummarySelection.select(conversation);
+      expect(selection.kind, ConversationSummaryKind.sections);
+      expect(selection.sections.map((s) => s.sourceSegmentIds), [
+        ['s1', 's2'],
+        isEmpty,
+      ]);
+      expect(selection.sections.first.bodyMarkdown, 'On signe vendredi.');
+      expect(selection.content, isNot(contains('[s2]')));
+      // The stored note is never rewritten.
+      expect(conversation.structured.sections.first.bodyMarkdown, 'On signe vendredi. [s2]');
+      expect(selection.canEdit(conversation), isTrue);
+    });
+
+    test('an overview that is no longer the projection keeps sources where its headings still match', () {
+      final conversation = _conversation(
+        sections: const [
+          Section(heading: 'Décisions', bodyMarkdown: 'On signe vendredi.', sourceSegmentIds: ['s1']),
+          Section(heading: 'Risques', bodyMarkdown: 'Le budget.', sourceSegmentIds: ['s3']),
+        ],
+        overview: '## Décisions\n\nOn signe vendredi, corrigé à la main.\n\n## Autre\n\nAjout.',
+      );
+      final selection = ConversationSummarySelection.select(conversation);
+      expect(selection.kind, ConversationSummaryKind.overview);
+      expect(_sections(selection.sections), ['Décisions: s1', 'Autre: ']);
+      expect(selection.canEdit(conversation), isTrue);
+    });
+
+    test('an overview without any matching heading stays one flat block', () {
+      final conversation = _conversation(
+        sections: const [
+          Section(heading: 'Décisions', bodyMarkdown: 'x', sourceSegmentIds: ['s1'])
+        ],
+        overview: 'Un aperçu écrit à la main.',
+      );
+      expect(ConversationSummarySelection.select(conversation).sections, isEmpty);
+    });
+  });
+
+  group('versions gardées', () {
+    test('an Omi version with sources reads section by section, matched by heading', () {
+      final conversation = _conversation(
+        sections: const [Section(heading: 'Décisions', bodyMarkdown: 'Texte actuel.')],
+        history: [
+          _version(
+            content: 'Intro sans titre. [s2]\n\n## **Décisions** :\n\nOn signe vendredi.\n\n## Risques\n\nLe budget.',
+            sources: [
+              {
+                'heading': 'décisions',
+                'source_segment_ids': ['s1', 'inconnu']
+              },
+              {
+                'heading': 'Absent',
+                'source_segment_ids': ['s3']
+              },
+            ],
+          ),
+        ],
+      );
+      final choice = ConversationSummarySelection.choices(conversation).firstWhere((c) => !c.isCurrent);
+      final selection = ConversationSummarySelection.fromChoice(choice, conversation);
+      expect(selection.isArchived, isTrue);
+      expect(selection.canEdit(conversation), isFalse);
+      expect(selection.content, startsWith('Intro sans titre.\n'));
+      expect(_sections(selection.sections), [': s2', 'Décisions :: s1', 'Risques: ']);
+    });
+
+    test('a version without sources, or whose ids are all unknown, stays one flat block', () {
+      for (final sources in <Object?>[
+        null,
+        [
+          {
+            'heading': 'Décisions',
+            'source_segment_ids': ['inconnu']
+          }
+        ],
+      ]) {
+        final conversation = _conversation(history: [_version(sources: sources)]);
+        final choice = ConversationSummarySelection.choices(conversation).firstWhere((c) => !c.isCurrent);
+        final selection = ConversationSummarySelection.fromChoice(choice, conversation);
+        expect(selection.sections, isEmpty, reason: '$sources');
+        expect(selection.content, _version().content);
+      }
+    });
+
+    test('an app version is shown as written', () {
+      final conversation = _conversation(history: [
+        _version(kind: 'app', content: '## Décisions\n\nTexte [s1]', sources: [
+          {
+            'heading': 'Décisions',
+            'source_segment_ids': ['s1']
+          }
+        ]),
+      ]);
+      final choice = ConversationSummarySelection.choices(conversation).firstWhere((c) => !c.isCurrent);
+      final selection = ConversationSummarySelection.fromChoice(choice, conversation);
+      expect(selection.sections, isEmpty);
+      expect(selection.content, '## Décisions\n\nTexte [s1]');
+    });
+  });
+
+  group('découpage', () {
+    test('cuts at level-2 headings only, outside code blocks', () {
+      final sections = ConversationSummarySelection.splitMarkdownSections(
+          'Avant\n\n## Un ##\n\nCorps\n### Sous-titre\n```\n## pas un titre\n```\n## Deux\nFin');
+      expect(sections.map((s) => s.heading), ['', 'Un', 'Deux']);
+      expect(sections.map((s) => s.bodyMarkdown), [
+        'Avant',
+        'Corps\n### Sous-titre\n```\n## pas un titre\n```',
+        'Fin',
+      ]);
+    });
+  });
+}
diff --git a/app/test/widgets/summary_section_sources_test.dart b/app/test/widgets/summary_section_sources_test.dart
