+/// Clone local : les passages cités par une section d'une version gardée (`{"heading": ..., "source_segment_ids": [...]}`).
+/// Le texte d'une version est du Markdown ; la section s'y retrouve par son titre (« ## … »).
+class SummarySectionSources {
+  final String heading;
+  final List<String> sourceSegmentIds;
+
+  const SummarySectionSources({required this.heading, required this.sourceSegmentIds});
+
+  /// Null pour une entrée illisible ou sans passage : elle n'a rien à montrer.
+  static SummarySectionSources? tryParse(Object? json) {
+    if (json is! Map) return null;
+    final heading = json['heading'];
+    final ids = json['source_segment_ids'];
+    if (ids is! List) return null;
+    final sourceSegmentIds = ids.whereType<String>().where((id) => id.isNotEmpty).toList();
+    if (sourceSegmentIds.isEmpty) return null;
+    return SummarySectionSources(heading: heading is String ? heading : '', sourceSegmentIds: sourceSegmentIds);
+  }
+
+  static List<SummarySectionSources> parseList(Object? json) {
+    if (json is! List) return const [];
+    return json.map(tryParse).whereType<SummarySectionSources>().toList();
+  }
+
+  Map<String, dynamic> toJson() => {'heading': heading, 'source_segment_ids': sourceSegmentIds};
+}
