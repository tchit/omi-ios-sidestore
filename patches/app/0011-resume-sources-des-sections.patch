+  /// The transcript's segment ids; an id-less segment ('') is never a citation.
+  static List<String> _knownSegmentIDs(ServerConversation conversation) =>
+      conversation.transcriptSegments.map((segment) => segment.id).where((id) => id.isNotEmpty).toList();
+
+  /// Clone local : les sections de [markdown] (des notes d'Omi en Markdown, coupées à chaque titre « ## »)
+  /// avec les passages que [sources] donne à leur titre, plus ceux des crochets de citation retirés du texte.
+  /// Vide quand aucune section n'a de passage connu de la transcription : le texte s'affiche alors d'un bloc,
+  /// comme avant.
+  static List<Section> sectionsWithSources(
+      String markdown, List<SummarySectionSources> sources, Iterable<String> knownIDs) {
+    final validIDs = knownIDs.where((id) => id.isNotEmpty).toSet();
+    if (validIDs.isEmpty) return const [];
+    final unused = [
+      for (final entry in sources)
+        (heading: _headingKey(repairNoteCitations(entry.heading, validIDs).text), ids: entry.sourceSegmentIds),
+    ];
+    var anySource = false;
+    final sections = <Section>[];
+    for (final part in splitMarkdownSections(markdown)) {
+      final heading = repairNoteCitations(part.heading, validIDs);
+      final body = repairNoteCitations(part.bodyMarkdown, validIDs);
+      if (heading.text.trim().isEmpty && body.text.trim().isEmpty) continue;
+      final key = _headingKey(heading.text);
+      final index = unused.indexWhere((entry) => entry.heading == key);
+      final typed = index < 0 ? const <String>[] : unused.removeAt(index).ids;
+      final ids = [...typed, ...heading.sourceIDs, ...body.sourceIDs].where(validIDs.contains).toSet().toList();
+      if (ids.isNotEmpty) anySource = true;
+      sections.add(Section(heading: heading.text, bodyMarkdown: body.text, sourceSegmentIds: ids));
+    }
+    return anySource ? List.unmodifiable(sections) : const [];
+  }
+
+  /// Clone local : [markdown] coupé à chaque titre de niveau 2 (« ## Titre ») hors bloc de code ; le texte avant le
+  /// premier titre forme une section sans titre. Les autres niveaux de titre restent dans le corps.
+  static List<Section> splitMarkdownSections(String markdown) {
+    final sections = <Section>[];
+    String heading = '';
+    final body = <String>[];
+    String? fence;
+    void flush() {
+      final text = body.join('\n').trim();
+      if (heading.isNotEmpty || text.isNotEmpty) sections.add(Section(heading: heading, bodyMarkdown: text));
+      body.clear();
+    }
+
+    final headingLine = RegExp(r'^ {0,3}##[ \t]+(.*?)(?:[ \t]+#+)?[ \t]*$');
+    final fenceLine = RegExp(r'^ {0,3}(`{3,}|~{3,})');
+    for (final line in markdown.split('\n')) {
+      final fenceMatch = fenceLine.firstMatch(line);
+      if (fence != null) {
+        if (fenceMatch != null && fenceMatch[1]![0] == fence[0] && fenceMatch[1]!.length >= fence.length) fence = null;
+        body.add(line);
+        continue;
+      }
+      if (fenceMatch != null) {
+        fence = fenceMatch[1];
+        body.add(line);
+        continue;
+      }
+      final match = headingLine.firstMatch(line);
+      if (match != null && match[1]!.trim().isNotEmpty) {
+        flush();
+        // The heading row is plain text: emphasis and code marks would show as typed.
+        heading = match[1]!.replaceAll(RegExp(r'\*\*|__|`'), '').trim();
+        continue;
+      }
+      body.add(line);
+    }
+    flush();
+    return sections;
+  }
+
+  /// A heading as matching sees it: no emphasis marks, case or spacing differences, no trailing colon.
+  static String _headingKey(String heading) => heading
+      .replaceAll(RegExp(r'[*_`]'), '')
+      .replaceAll(RegExp(r'\s+'), ' ')
+      .trim()
+      .replaceAll(RegExp(r'[:：]$'), '')
+      .trim()
+      .toLowerCase();
+
