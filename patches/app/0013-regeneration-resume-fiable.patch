-Future<ServerConversation?> reProcessConversationServer(
+/// What POST /v1/conversations/{id}/reprocess did (repris d'Omi 922c9a86dc). The detail page needs to tell
+/// "the server is already working on it" (409) and "too many requests" (429) from a plain failure.
+sealed class ReprocessResult {
+  const ReprocessResult();
+
+  /// The reprocessed conversation, only on [ReprocessSuccess].
+  ServerConversation? get conversation => null;
+
+  /// Adapts a call that only knows "a conversation or nothing" (older seams, list-row retries).
+  static ReprocessResult fromConversation(ServerConversation? conversation) =>
+      conversation == null ? const ReprocessFailed() : ReprocessSuccess(conversation);
+}
+
+final class ReprocessSuccess extends ReprocessResult {
+  const ReprocessSuccess(this.conversation);
+
+  @override
+  final ServerConversation conversation;
+}
+
+/// Another writer holds the conversation's processing claim (HTTP 409 `conversation_processing_in_progress`).
+final class ReprocessBusy extends ReprocessResult {
+  const ReprocessBusy();
+}
+
+/// The hourly reprocess limit, or the model provider's (HTTP 429). [retryAfter] when the server said how long.
+final class ReprocessRateLimited extends ReprocessResult {
+  const ReprocessRateLimited({this.retryAfter});
+
+  final Duration? retryAfter;
+}
+
+/// Anything else: transport failure, 5xx (502 `app_result_failed` when the selected template returned nothing),
+/// an app the server will not run, an unacknowledged speaker receipt, an undecodable body. [timedOut] when no
+/// answer came within [reprocessRequestTimeout] (the server may still finish the summary).
+final class ReprocessFailed extends ReprocessResult {
+  const ReprocessFailed({this.statusCode, this.timedOut = false});
+
+  final int? statusCode;
+  final bool timedOut;
+}
+
+/// A reprocess runs the whole summary pipeline and can take minutes. It is not idempotent, so the pool must
+/// never retry it (a timeout or 5xx retry starts a second, duplicate reprocess).
+///
+/// Clone local : 320 s (180 s chez Omi). Le serveur personnel accorde jusqu'à 300 s à une requête de premier
+/// plan (OMI_FOREGROUND_REQUEST_TIMEOUT_SECONDS) ; l'app ne doit jamais abandonner avant lui.
+const Duration reprocessRequestTimeout = Duration(seconds: 320);
+
+/// Sends the reprocess POST: [timeout] and [retries] are what the request must use (a test seam).
+typedef ReprocessSend = Future<http.Response?> Function(String url, {required Duration timeout, required int retries});
+
+Future<http.Response?> _sendReprocess(String url, {required Duration timeout, required int retries}) =>
+    makeApiCall(url: url, headers: {}, method: 'POST', body: '', timeout: timeout, retries: retries);
+
+/// POST /v1/conversations/{id}/reprocess, sent once (no automatic retry), waiting at most
+/// [reprocessRequestTimeout].
+Future<ReprocessResult> reprocessConversationResult(
   String conversationId, {
   String? appId,
   bool requireSpeakerReceipt = false,
+  @visibleForTesting ReprocessSend? send,
+  @visibleForTesting DateTime Function() now = DateTime.now,
 }) async {
-  var response = await makeApiCall(
-    url: '${Env.apiBaseUrl}v1/conversations/$conversationId/reprocess${appId != null ? '?app_id=$appId' : ''}',
-    headers: {},
-    method: 'POST',
-    body: '',
+  final started = now();
+  final response = await (send ?? _sendReprocess)(
+    '${Env.apiBaseUrl}v1/conversations/$conversationId/reprocess${appId != null ? '?app_id=$appId' : ''}',
+    timeout: reprocessRequestTimeout,
+    retries: 0,
   );
-  if (response == null) return null;
-  Logger.debug('reProcessConversationServer: ${response.body}');
-  if (response.statusCode == 200) {
-    // A pre-fix backend can return 200 with a summary made from stale speaker
-    // labels. Keep the detail page's retry action until the receipt-aware
-    // processor explicitly acknowledges its summary path.
-    if (requireSpeakerReceipt && !hasSpeakerReceiptSummaryCapability(response.headers)) return null;
-    return ServerConversation.fromJson(jsonDecode(response.body) as Map<String, dynamic>);
+  if (response == null) return reprocessResultWithoutResponse(now().difference(started));
+  Logger.debug('reProcessConversationServer: ${response.statusCode}');
+  return reprocessResultFromResponse(response, requireSpeakerReceipt: requireSpeakerReceipt);
+}
+
+/// The reprocessed conversation, or null on any failure (list rows and the processing card only need that).
+Future<ServerConversation?> reProcessConversationServer(
+  String conversationId, {
+  String? appId,
+  bool requireSpeakerReceipt = false,
+}) async =>
+    (await reprocessConversationResult(conversationId, appId: appId, requireSpeakerReceipt: requireSpeakerReceipt))
+        .conversation;
+
+/// No response at all: a request that used up [reprocessRequestTimeout] timed out; anything sooner is a
+/// transport failure. ([makeApiCall] reports both as null.)
+@visibleForTesting
+ReprocessResult reprocessResultWithoutResponse(Duration elapsed) =>
+    ReprocessFailed(timedOut: elapsed >= reprocessRequestTimeout - const Duration(seconds: 2));
+
+/// Maps a reprocess response to its [ReprocessResult].
+@visibleForTesting
+ReprocessResult reprocessResultFromResponse(http.Response response, {bool requireSpeakerReceipt = false}) {
+  switch (response.statusCode) {
+    case 200:
+      // A pre-fix backend can return 200 with a summary made from stale speaker
+      // labels. Keep the detail page's retry action until the receipt-aware
+      // processor explicitly acknowledges its summary path.
+      if (requireSpeakerReceipt && !hasSpeakerReceiptSummaryCapability(response.headers)) {
+        return const ReprocessFailed(statusCode: 200);
+      }
+      try {
+        return ReprocessSuccess(ServerConversation.fromJson(jsonDecode(response.body) as Map<String, dynamic>));
+      } catch (e) {
+        Logger.debug('reProcessConversationServer decode failed: ${e.runtimeType}');
+        return const ReprocessFailed(statusCode: 200);
+      }
+    case 409:
+      // 409 is busy only with the structured `conversation_processing_in_progress` detail. The same
+      // route answers 409 with a string detail when the selected app is disabled or not enabled:
+      // that is the template failing, not the conversation being busy.
+      return _reprocessDetailCode(response.body) == 'conversation_processing_in_progress'
+          ? const ReprocessBusy()
+          : const ReprocessFailed(statusCode: 409);
+    case 429:
+      final seconds = int.tryParse(response.headers['retry-after']?.trim() ?? '');
+      return ReprocessRateLimited(retryAfter: seconds == null || seconds < 0 ? null : Duration(seconds: seconds));
+    default:
+      return ReprocessFailed(statusCode: response.statusCode);
+  }
+}
+
+/// The `detail.code` of an error body (`{"detail": {"code": ..., "message": ...}}`), if any.
+String? _reprocessDetailCode(String body) {
+  try {
+    final decoded = jsonDecode(body);
+    final detail = decoded is Map ? decoded['detail'] : null;
+    final code = detail is Map ? detail['code'] : null;
+    return code is String ? code : null;
+  } catch (_) {
+    return null;
   }
-  return null;
 }
 
