diff --git a/app/test/unit/reprocess_reliability_test.dart b/app/test/unit/reprocess_reliability_test.dart
new file mode 100644
index 0000000000..de69b72dd1
--- /dev/null
+++ b/app/test/unit/reprocess_reliability_test.dart
@@ -0,0 +1,264 @@
+// Clone local : fiabilité de la régénération du résumé (0013, repris d'Omi 922c9a86dc hors drapeau et du côté
+// client de c985d982de) — un seul envoi, 320 s au plus (le serveur accorde 300 s), une réponse 200 sans le résumé demandé est un échec,
+// et les versions gardées (0007) comme la relance « app seule » restent intactes.
+import 'dart:convert';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:shared_preferences/shared_preferences.dart';
+
+import 'package:omi/backend/http/api/conversations.dart';
+import 'package:omi/backend/preferences.dart';
+import 'package:omi/backend/schema/conversation.dart';
+import 'package:omi/backend/schema/structured.dart';
+import 'package:omi/backend/schema/summary_version.dart';
+import 'package:omi/env/env.dart';
+import 'package:omi/pages/conversation_detail/conversation_detail_provider.dart';
+import 'package:omi/pages/conversation_detail/summary_failure_message.dart';
+import 'package:omi/l10n/app_localizations.dart';
+import 'package:omi/providers/conversation_provider.dart';
+
+Map<String, dynamic> _wire({String overview = 'Résumé régénéré.', List<Map<String, dynamic>> apps = const []}) => {
+      'id': 'c1',
+      'created_at': '2026-10-19T09:00:00Z',
+      'started_at': '2026-10-19T09:00:00Z',
+      'finished_at': '2026-10-19T09:30:00Z',
+      'structured': {'title': 'Point devis', 'overview': overview, 'emoji': '🧠', 'category': 'other'},
+      'transcript_segments': [],
+      'apps_results': apps,
+      'status': 'completed',
+    };
+
+ServerConversation _conversation({
+  String overview = 'Ancien résumé.',
+  List<AppResponse> apps = const [],
+  List<SummaryVersion> history = const [],
+}) =>
+    ServerConversation(
+      id: 'c1',
+      createdAt: DateTime.utc(2026, 10, 19, 9),
+      structured: Structured('Point devis', overview),
+      appResults: apps,
+      summaryHistory: history,
+      status: ConversationStatus.completed,
+    );
+
+({ConversationDetailProvider detail, List<String> errors}) _detail(
+  ServerConversation conversation,
+  Future<ReprocessResult> Function(String id, String? appId) reprocess,
+) {
+  final detail = ConversationDetailProvider(
+    reprocessResult: (id, {appId, requireSpeakerReceipt = false}) => reprocess(id, appId),
+  )
+    ..selectedDate = conversationLocalDayKey(conversation.createdAt)
+    ..setCachedConversation(conversation);
+  final errors = <String>[];
+  detail.addListener(() {
+    if (detail.error case final String message? when message.isNotEmpty) errors.add(message);
+  });
+  return (detail: detail, errors: errors);
+}
+
+http.Response _json(Object body, int status, {Map<String, String> headers = const {}}) => http.Response.bytes(
+      utf8.encode(jsonEncode(body)),
+      status,
+      headers: {'content-type': 'application/json; charset=utf-8', ...headers},
+    );
+
+void main() {
+  setUp(() async {
+    SharedPreferences.setMockInitialValues({});
+    await SharedPreferencesUtil.init();
+    Env.overrideApiBaseUrl('https://omi.test.invalid/');
+  });
+  tearDown(Env.clearApiBaseUrlOverrideForTesting);
+
+  group('envoi', () {
+    test('the POST is sent once, with a 320 s limit (past the server\'s 300 s) and no automatic retry', () async {
+      final calls = <(String, Duration, int)>[];
+      final result = await reprocessConversationResult(
+        'c1',
+        appId: 'meeting-notes',
+        send: (url, {required timeout, required retries}) async {
+          calls.add((url, timeout, retries));
+          return http.Response('{"detail":"boom"}', 500);
+        },
+      );
+      expect(calls, [
+        ('https://omi.test.invalid/v1/conversations/c1/reprocess?app_id=meeting-notes', reprocessRequestTimeout, 0)
+      ]);
+      expect(reprocessRequestTimeout, const Duration(seconds: 320));
+      expect(reprocessRequestTimeout, greaterThan(const Duration(seconds: 300)));
+      expect(result, isA<ReprocessFailed>().having((r) => r.statusCode, 'statusCode', 500));
+    });
+
+    test('no answer: quickly is a transport failure, after the full 320 s it timed out', () async {
+      var clock = DateTime.utc(2026, 10, 19, 9);
+      Future<ReprocessResult> run(Duration wait) => reprocessConversationResult(
+            'c1',
+            now: () => clock,
+            send: (url, {required timeout, required retries}) async {
+              clock = clock.add(wait);
+              return null;
+            },
+          );
+      expect(
+          await run(const Duration(seconds: 2)), isA<ReprocessFailed>().having((r) => r.timedOut, 'timedOut', false));
+      expect(
+          await run(const Duration(seconds: 320)), isA<ReprocessFailed>().having((r) => r.timedOut, 'timedOut', true));
+    });
+
+    test('responses map to success, busy, rate limited or failed', () {
+      expect(reprocessResultFromResponse(_json(_wire(), 200)), isA<ReprocessSuccess>());
+      expect(
+        reprocessResultFromResponse(_json(_wire(), 200), requireSpeakerReceipt: true),
+        isA<ReprocessFailed>().having((r) => r.statusCode, 'statusCode', 200),
+      );
+      expect(
+        reprocessResultFromResponse(
+          _json(_wire(), 200, headers: {'x-omi-speaker-receipt-summary': '1'}),
+          requireSpeakerReceipt: true,
+        ),
+        isA<ReprocessSuccess>(),
+      );
+      expect(reprocessResultFromResponse(http.Response('pas du json', 200)), isA<ReprocessFailed>());
+      expect(
+        reprocessResultFromResponse(http.Response(
+            jsonEncode({
+              'detail': {'code': 'conversation_processing_in_progress', 'message': 'busy'}
+            }),
+            409)),
+        isA<ReprocessBusy>(),
+      );
+      expect(
+        reprocessResultFromResponse(http.Response(jsonEncode({'detail': 'App is disabled'}), 409)),
+        isA<ReprocessFailed>().having((r) => r.statusCode, 'statusCode', 409),
+      );
+      expect(
+        reprocessResultFromResponse(http.Response('{}', 429, headers: {'retry-after': '120'})),
+        isA<ReprocessRateLimited>().having((r) => r.retryAfter, 'retryAfter', const Duration(minutes: 2)),
+      );
+      expect(
+        reprocessResultFromResponse(http.Response('{}', 502)),
+        isA<ReprocessFailed>().having((r) => r.statusCode, 'statusCode', 502),
+      );
+    });
+
+    test('list rows keep their "conversation or nothing" contract', () async {
+      // The adapter used by older seams.
+      expect(ReprocessResult.fromConversation(null), isA<ReprocessFailed>());
+      expect(ReprocessResult.fromConversation(_conversation()).conversation?.id, 'c1');
+    });
+  });
+
+  group('page de la conversation', () {
+    test('a 200 without any summary is a failure that changes nothing', () async {
+      final h = _detail(_conversation(), (id, appId) async => ReprocessSuccess(_conversation(overview: '')));
+      expect(await h.detail.reprocessConversation(), isFalse);
+      expect(h.detail.summaryFailure?.kind, SummaryFailureKind.empty);
+      expect(h.detail.conversation.structured.overview, 'Ancien résumé.');
+      expect(h.detail.loadingReprocessConversation, isFalse);
+      expect(h.detail.lastFailedReprocessConversationId, 'c1');
+      expect(h.errors, contains('REPROCESS_FAILED'));
+      h.detail.dispose();
+    });
+
+    test('a template that came back without its result is a template failure', () async {
+      final h = _detail(
+        _conversation(),
+        (id, appId) async =>
+            ReprocessSuccess(_conversation(overview: 'Résumé', apps: [AppResponse('', appId: 'other')])),
+      );
+      expect(await h.detail.reprocessConversation(appId: 'meeting-notes'), isFalse);
+      expect(h.detail.summaryFailure?.kind, SummaryFailureKind.template);
+      expect(h.detail.summaryFailure?.appId, 'meeting-notes');
+      expect(h.detail.lastFailedReprocessAppId, 'meeting-notes');
+      h.detail.dispose();
+    });
+
+    test('busy, rate limited, timed out and transport failures are told apart', () async {
+      final cases = <ReprocessResult, SummaryFailureKind>{
+        const ReprocessBusy(): SummaryFailureKind.busy,
+        const ReprocessRateLimited(retryAfter: Duration(minutes: 5)): SummaryFailureKind.rateLimited,
+        const ReprocessFailed(timedOut: true): SummaryFailureKind.timedOut,
+        const ReprocessFailed(): SummaryFailureKind.generic,
+        const ReprocessFailed(statusCode: 500): SummaryFailureKind.generic,
+      };
+      for (final MapEntry(key: result, value: kind) in cases.entries) {
+        final h = _detail(_conversation(), (id, appId) async => result);
+        expect(await h.detail.reprocessConversation(), isFalse);
+        expect(h.detail.summaryFailure?.kind, kind, reason: '$result');
+        h.detail.dispose();
+      }
+      final template = _detail(_conversation(), (id, appId) async => const ReprocessFailed(statusCode: 500));
+      expect(await template.detail.reprocessConversation(appId: 'meeting-notes'), isFalse);
+      expect(template.detail.summaryFailure?.kind, SummaryFailureKind.template);
+      template.detail.dispose();
+      final limited =
+          _detail(_conversation(), (id, appId) async => const ReprocessRateLimited(retryAfter: Duration(minutes: 5)));
+      await limited.detail.reprocessConversation();
+      expect(limited.detail.summaryFailure?.retryAfter, const Duration(minutes: 5));
+      limited.detail.dispose();
+    });
+
+    test('a seam that throws settles the page as a plain failure', () async {
+      final h = _detail(_conversation(), (id, appId) async => throw StateError('synthetic'));
+      expect(await h.detail.reprocessConversation(), isFalse);
+      expect(h.detail.loadingReprocessConversation, isFalse);
+      expect(h.detail.summaryFailure?.kind, SummaryFailureKind.generic);
+      expect(h.errors, contains('REPROCESS_FAILED'));
+      h.detail.dispose();
+    });
+
+    test('« app seule » : the chosen template\'s result is a success and is shown', () async {
+      final h = _detail(
+        _conversation(),
+        (id, appId) async => ReprocessSuccess(_conversation(apps: [AppResponse('Compte rendu.', appId: appId)])),
+      );
+      expect(await h.detail.reprocessConversation(appId: 'meeting-notes'), isTrue);
+      expect(h.detail.summaryFailure, isNull);
+      final selection = h.detail.getSummarySelection();
+      expect(selection.isApp, isTrue);
+      expect(selection.content, 'Compte rendu.');
+      h.detail.dispose();
+    });
+
+    test('a failure keeps the kept version being read (0007); a success shows the new summary', () async {
+      final kept = SummaryVersion(
+        id: 'v1',
+        kind: 'omi',
+        content: 'Version de la veille.',
+        recordedAt: DateTime.utc(2026, 10, 18, 10),
+      );
+      var answer = ReprocessSuccess(_conversation(overview: '', history: [kept])) as ReprocessResult;
+      final h = _detail(_conversation(history: [kept]), (id, appId) async => answer);
+      final choice = h.detail.summaryChoices().firstWhere((c) => !c.isCurrent);
+      h.detail.selectSummaryChoice(choice);
+      expect(h.detail.getSummarySelection().content, 'Version de la veille.');
+
+      expect(await h.detail.reprocessConversation(), isFalse);
+      expect(h.detail.getSummarySelection().content, 'Version de la veille.');
+      expect(h.detail.summaryChoices().where((c) => !c.isCurrent), hasLength(1));
+
+      answer = ReprocessSuccess(_conversation(overview: 'Nouveau résumé.', history: [kept]));
+      expect(await h.detail.reprocessConversation(), isTrue);
+      expect(h.detail.summaryFailure, isNull);
+      expect(h.detail.getSummarySelection().content, 'Nouveau résumé.');
+      expect(h.detail.summaryChoices().map((c) => c.content), contains('Version de la veille.'));
+      h.detail.dispose();
+    });
+  });
+
+  test('each failure has its own message, in French and English', () {
+    for (final locale in const [Locale('fr'), Locale('en')]) {
+      final l10n = lookupAppLocalizations(locale);
+      final messages = {for (final kind in SummaryFailureKind.values) kind: summaryFailureMessage(l10n, kind)};
+      expect(messages.values.toSet(), hasLength(SummaryFailureKind.values.length), reason: '$locale');
+      expect(messages[SummaryFailureKind.generic], l10n.errorProcessingConversation);
+    }
+    final fr = lookupAppLocalizations(const Locale('fr'));
+    expect(summaryFailureMessage(fr, SummaryFailureKind.busy), startsWith('Omi est déjà en train'));
+    expect(summaryFailureMessage(fr, SummaryFailureKind.timedOut), contains('5 minutes'));
+  });
+}
