@@ -0,0 +1,152 @@
+// Clone local : la page dit clairement pourquoi une régénération du résumé n'a rien donné (0013), en français,
+// et ne propose « Réessayer » que là où un nouvel essai a une chance.
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:provider/provider.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+import 'package:omi/backend/http/api/conversations.dart';
+import 'package:omi/backend/preferences.dart';
+import 'package:omi/backend/schema/conversation.dart';
+import 'package:omi/backend/schema/structured.dart';
+import 'package:omi/backend/schema/transcript_segment.dart';
+import 'package:omi/l10n/app_localizations.dart';
+import 'package:omi/pages/conversation_detail/conversation_detail_provider.dart';
+import 'package:omi/pages/conversation_detail/page.dart';
+import 'package:omi/providers/app_provider.dart';
+import 'package:omi/providers/connectivity_provider.dart';
+import 'package:omi/providers/conversation_provider.dart';
+import 'package:omi/providers/folder_provider.dart';
+import 'package:omi/providers/integration_provider.dart';
+import 'package:omi/providers/people_provider.dart';
+import 'package:omi/ui/ui.dart';
+import 'package:omi/utils/platform/platform_manager.dart';
+import 'package:omi/widgets/conversation_bottom_bar.dart';
+
+ServerConversation _conversation({String overview = 'Ancien résumé.'}) => ServerConversation(
+      id: 'c-msg',
+      createdAt: DateTime.utc(2026, 10, 19, 9),
+      structured: Structured('Point devis', overview),
+      status: ConversationStatus.completed,
+      transcriptSegments: [
+        TranscriptSegment(
+          id: 's1',
+          text: 'On signe vendredi.',
+          speaker: 'SPEAKER_00',
+          isUser: false,
+          personId: null,
+          start: 0,
+          end: 3,
+          translations: [],
+        ),
+      ],
+    );
+
+/// [answer] lands one frame after the request starts, as a real request does (after the progress toast).
+Future<ConversationDetailProvider> _pumpPage(WidgetTester tester, ReprocessResult Function() answer) async {
+  PlatformManager.initializeForLocalHarness();
+  final initial = _conversation();
+  final details = Completer<ServerConversation?>()..complete(initial);
+  final conversations = ConversationProvider(isSignedIn: () => false);
+  conversations.conversations = [initial];
+  conversations.groupedConversations = {
+    conversationLocalDayKey(initial.createdAt): [initial],
+  };
+  conversations.conversationDetailsFetcherOverride = (_) => details.future;
+  final detail = ConversationDetailProvider(
+    reprocessResult: (id, {appId, requireSpeakerReceipt = false}) async {
+      await Future<void>.delayed(const Duration(milliseconds: 100));
+      return answer();
+    },
+  );
+  final apps = AppProvider();
+  detail.setProviders(apps, conversations);
+  addTearDown(() {
+    detail.dispose();
+    conversations.dispose();
+    apps.dispose();
+  });
+  await tester.pumpWidget(MaterialApp(
+    theme: buildOmiTheme(brightness: Brightness.light),
+    localizationsDelegates: AppLocalizations.localizationsDelegates,
+    supportedLocales: AppLocalizations.supportedLocales,
+    locale: const Locale('fr'),
+    home: MultiProvider(
+      providers: [
+        ChangeNotifierProvider<ConversationProvider>.value(value: conversations),
+        ChangeNotifierProvider<ConversationDetailProvider>.value(value: detail),
+        ChangeNotifierProvider<AppProvider>.value(value: apps),
+        ChangeNotifierProvider(create: (_) => FolderProvider(foldersFetcher: () async => [])),
+        ChangeNotifierProvider(create: (_) => ConnectivityProvider()),
+        ChangeNotifierProvider(create: (_) => PeopleProvider()),
+        ChangeNotifierProvider(
+          create: (_) => IntegrationProvider(
+            fetchStatus: (_) async => null,
+            saveStatus: (_, __) async => false,
+            deleteStatus: (_) async => false,
+            persistPref: (_, __) async {},
+          ),
+        ),
+      ],
+      child: ConversationDetailPage(conversation: initial, initialTab: ConversationTab.summary),
+    ),
+  ));
+  await tester.pump();
+  await tester.pump(const Duration(milliseconds: 300));
+  return detail;
+}
+
+void main() {
+  setUp(() async {
+    SharedPreferences.setMockInitialValues({'has_first_conversation': true});
+    await SharedPreferencesUtil.init();
+    OmiColors.active = OmiPalette.light;
+  });
+
+  testWidgets('Omi déjà occupé : le dire, sans Réessayer', (tester) async {
+    final detail = await _pumpPage(tester, () => const ReprocessBusy());
+    unawaited(detail.reprocessConversation());
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 300));
+    await tester.pump();
+    expect(
+        find.text('Omi est déjà en train de traiter cette conversation. Réessayez dans un instant.'), findsOneWidget);
+    expect(find.text('Réessayer'), findsNothing);
+    expect(find.text('Ancien résumé.', findRichText: true), findsOneWidget);
+    expect(tester.takeException(), isNull);
+  });
+
+  testWidgets('une réponse sans résumé : le dire, et Réessayer relance une seule fois', (tester) async {
+    var calls = 0;
+    final detail = await _pumpPage(tester, () {
+      calls++;
+      return ReprocessSuccess(_conversation(overview: ''));
+    });
+    unawaited(detail.reprocessConversation());
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 300));
+    await tester.pump();
+    expect(calls, 1);
+    expect(find.text('Omi n’a renvoyé aucun résumé. Réessayez.'), findsOneWidget);
+    expect(find.text('Ancien résumé.', findRichText: true), findsOneWidget);
+    tester.widget<SnackBarAction>(find.widgetWithText(SnackBarAction, 'Réessayer')).onPressed();
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 300));
+    await tester.pump();
+    expect(calls, 2);
+    expect(tester.takeException(), isNull);
+  });
+
+  testWidgets('pas de réponse en 5 minutes : le dire, sans relancer un doublon', (tester) async {
+    final detail = await _pumpPage(tester, () => const ReprocessFailed(timedOut: true));
+    unawaited(detail.reprocessConversation());
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 300));
+    await tester.pump();
+    expect(find.textContaining('n’a pas répondu en 5 minutes'), findsOneWidget);
+    expect(find.text('Réessayer'), findsNothing);
+    expect(tester.takeException(), isNull);
+  });
+}
