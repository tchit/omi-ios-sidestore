+import 'dart:async';
+
+import 'package:flutter/material.dart';
+
+import 'package:omi/backend/schema/relecture.dart';
+import 'package:omi/pages/insights/insight_sources.dart';
+import 'package:omi/pages/insights/relecture_controller.dart';
+import 'package:omi/pages/insights/relecture_widgets.dart';
+import 'package:omi/ui/ui.dart';
+import 'package:omi/utils/l10n_extensions.dart';
+import 'package:omi/utils/other/temp.dart';
+
+/// Ouvre « Changements récents » par-dessus l'accueil ; se termine quand on en revient.
+Future<void> routeToRelectureChanges(
+  BuildContext context,
+  RelectureController controller, {
+  InsightSourceOpener sources = const InsightSourceOpener(),
+}) =>
+    routeToPage(context, RelectureChangesPage(controller: controller, sources: sources));
+
+/// Clone local : « Changements récents », ce qu'Omi a changé avec l'accord de Mike, le plus récent d'abord. Pour
+/// chacun : sa nature et sa date en clair, son titre, et pour chaque chose touchée, avant → après. « Annuler »
+/// (confirmation légère) tant que le serveur le permet ; « Annulé le … » ensuite. Rien n'est effacé d'ici.
+class RelectureChangesPage extends StatefulWidget {
+  const RelectureChangesPage({super.key, required this.controller, this.sources = const InsightSourceOpener()});
+
+  final RelectureController controller;
+  final InsightSourceOpener sources;
+
+  @override
+  State<RelectureChangesPage> createState() => _RelectureChangesPageState();
+}
+
+class _RelectureChangesPageState extends State<RelectureChangesPage> {
+  RelectureController get _controller => widget.controller;
+
+  @override
+  void initState() {
+    super.initState();
+    unawaited(_controller.load());
+  }
+
+  Future<void> _undo(RelectureChangement changement) async {
+    final l10n = context.l10n;
+    final confirmed = await showOmiConfirm(
+      context,
+      title: l10n.relectureUndoQuestion,
+      message: l10n.relectureUndoMessage,
+      confirmLabel: l10n.relectureUndoConfirm,
+      cancelLabel: l10n.relectureUndoKeep,
+    );
+    if (!confirmed || !mounted) return;
+    final outcome = await _controller.undo(changement);
+    if (outcome == null || !mounted) return;
+    showRelectureUndoOutcome(context, outcome);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = context.l10n;
+    return Scaffold(
+      appBar: AppBar(leading: const OmiBackButton(), title: Text(l10n.relectureChangesTitle)),
+      body: ListenableBuilder(
+        listenable: _controller,
+        builder: (context, _) {
+          final data = _controller.data;
+          if (data == null) {
+            return _controller.problem == null
+                ? const OmiLoadingState()
+                : OmiErrorState(message: l10n.relectureListLoadError, onRetry: _controller.load);
+          }
+          final changements = data.changements;
+          if (changements.isEmpty) {
+            return OmiEmptyState(
+              key: const ValueKey('relecture_no_changes'),
+              icon: Icons.history_rounded,
+              title: l10n.relectureNoChangesTitle,
+              message: l10n.relectureNoChangesMessage,
+            );
+          }
+          return RefreshIndicator(
+            onRefresh: _controller.load,
+            child: ListView.separated(
+              key: const ValueKey('relecture_changes_list'),
+              physics: const AlwaysScrollableScrollPhysics(),
+              padding: EdgeInsets.fromLTRB(
+                OmiSpacing.md,
+                OmiSpacing.xs,
+                OmiSpacing.md,
+                OmiSpacing.xxl + MediaQuery.paddingOf(context).bottom,
+              ),
+              itemCount: changements.length,
+              separatorBuilder: (_, __) => const SizedBox(height: OmiSpacing.sm),
+              itemBuilder: (context, index) {
+                final changement = changements[index];
+                return RelectureChangeCard(
+                  key: ValueKey('relecture_changement_${changement.id}'),
+                  changement: changement,
+                  busy: _controller.gestureOn(changement.id) != null,
+                  onUndo: () => unawaited(_undo(changement)),
+                  onOpenConversation: (id) => unawaited(widget.sources.openConversation(context, id)),
+                  onOpenTasks: () => unawaited(widget.sources.openTasks(context)),
+                );
+              },
+            ),
+          );
+        },
+      ),
+    );
+  }
+}
+
+/// Un changement : nature et date, titre, puis pour chaque chose touchée avant → après ; « Annuler » s'il est
+/// annulable, « Annulé le … » s'il l'a été, « Ne peut plus être annulé » sinon.
+class RelectureChangeCard extends StatelessWidget {
+  const RelectureChangeCard({
+    super.key,
+    required this.changement,
+    required this.busy,
+    required this.onUndo,
+    required this.onOpenConversation,
+    required this.onOpenTasks,
+  });
+
+  final RelectureChangement changement;
+  final bool busy;
+  final VoidCallback onUndo;
+  final ValueChanged<String> onOpenConversation;
+  final VoidCallback onOpenTasks;
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = context.l10n;
+    final dates = OmiDateFormat.of(context);
+    final c = changement;
+    final faitLe = c.faitLe;
+    final annuleLe = c.annuleLe;
+    final titre = c.titre;
+    final footnote = OmiType.footnote.copyWith(color: OmiColors.textTertiary, fontWeight: FontWeight.w600);
+    return Material(
+      color: OmiColors.surface1,
+      borderRadius: OmiRadius.mdAll,
+      child: Padding(
+        padding: const EdgeInsets.fromLTRB(OmiSpacing.md, OmiSpacing.md, OmiSpacing.md, OmiSpacing.sm),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.stretch,
+          children: [
+            RelectureKindLine(type: c.type, trailing: faitLe == null ? null : dates.dateTime(faitLe.toLocal())),
+            if (titre != null) ...[
+              const SizedBox(height: OmiSpacing.xs),
+              Semantics(header: true, child: Text(titre, style: OmiType.headline)),
+            ],
+            for (final detail in c.details) ...[
+              const SizedBox(height: OmiSpacing.sm),
+              if (detail.cible case final cible?)
+                Align(
+                  alignment: Alignment.centerLeft,
+                  child: relectureTargetChip(context, cible, onOpenConversation, onOpenTasks),
+                ),
+              if (detail.avant != null || detail.apres != null) ...[
+                if (detail.cible != null) const SizedBox(height: OmiSpacing.xxs),
+                RelectureDiff(before: detail.avant, after: detail.apres),
+              ],
+            ],
+            const SizedBox(height: OmiSpacing.sm),
+            if (annuleLe != null)
+              Row(
+                key: ValueKey('relecture_undone_${c.id}'),
+                children: [
+                  ExcludeSemantics(child: Icon(Icons.undo_rounded, size: 16, color: OmiColors.textTertiary)),
+                  const SizedBox(width: OmiSpacing.xxs),
+                  Expanded(child: Text(l10n.relectureUndoneOn(dates.dateTime(annuleLe.toLocal())), style: footnote)),
+                ],
+              )
+            else if (c.annulable)
+              Align(
+                alignment: Alignment.centerRight,
+                child: OmiButton.secondary(
+                  key: ValueKey('relecture_undo_${c.id}'),
+                  label: l10n.undo,
+                  size: OmiButtonSize.compact,
+                  isLoading: busy,
+                  onPressed: onUndo,
+                ),
+              )
+            else
+              Text(l10n.relectureNotUndoable, key: ValueKey('relecture_not_undoable_${c.id}'), style: footnote),
+          ],
+        ),
+      ),
+    );
+  }
+}
diff --git a/app/lib/pages/insights/relecture_controller.dart b/app/lib/pages/insights/relecture_controller.dart
new file mode 100644
index 0000000000..7d18150cdd
--- /dev/null
+++ b/app/lib/pages/insights/relecture_controller.dart
@@ -0,0 +1,166 @@
+import 'package:flutter/foundation.dart';
+
+import 'package:omi/backend/http/api/relecture.dart';
+import 'package:omi/backend/http/api_result.dart';
+import 'package:omi/backend/schema/relecture.dart';
+
+/// Le geste en cours sur une proposition ou un changement (son bouton tourne, les autres attendent).
+enum RelectureGesture { accept, ignore, undo }
+
+/// Clone local : l'état de la « Relecture de nuit », partagé par la carte de l'onglet Insights et les pages
+/// « À vérifier » et « Changements récents » (un geste fait dans une page se voit aussitôt dans l'onglet).
+///
+/// Une seule lecture à la fois ; un geste par élément à la fois (jamais de double envoi). Une lecture qui
+/// croise un geste est refaite : elle pourrait le précéder et remontrer une carte déjà traitée.
+class RelectureController extends ChangeNotifier {
+  RelectureController({required this.api});
+
+  final RelectureApi api;
+
+  Relecture? _data;
+  ApiProblem? _problem;
+  Future<void>? _loading;
+  final Map<String, RelectureGesture> _busy = {};
+
+  /// Compte les gestes terminés : une lecture partie avant le dernier est relue.
+  int _gestures = 0;
+  bool _disposed = false;
+
+  /// Null tant que rien n'a été lu.
+  Relecture? get data => _data;
+  List<RelectureProposition> get propositions => _data?.propositions ?? const [];
+  List<RelectureChangement> get changements => _data?.changements ?? const [];
+
+  /// La dernière lecture a échoué (ce qui était affiché reste).
+  ApiProblem? get problem => _problem;
+
+  /// Le serveur ne connaît pas (encore) la relecture (404) : rien n'est montré, ce n'est pas une panne.
+  bool get missing => _problem?.kind == ApiProblemKind.notFound;
+  RelectureGesture? gestureOn(String id) => _busy[id];
+
+  /// Relit ; un appel pendant une lecture attend celle-ci.
+  Future<void> load() {
+    final running = _loading;
+    if (running != null) return running;
+    // Rien n'est annoncé au départ (appelé aussi pendant la construction d'une page) ; seulement à l'arrivée.
+    final future = _read().whenComplete(() => _loading = null);
+    _loading = future;
+    return future;
+  }
+
+  Future<void> _read() async {
+    while (true) {
+      final mark = _gestures;
+      ApiResult<Relecture> result;
+      try {
+        result = await api.load();
+      } on Exception {
+        result = const ApiFailure(ApiProblem(ApiProblemKind.transport));
+      }
+      if (_disposed) return;
+      // Un geste a abouti pendant la lecture : elle peut le précéder ; relire.
+      if (mark != _gestures) continue;
+      switch (result) {
+        case ApiSuccess(:final data):
+          _data = data;
+          _problem = null;
+        case ApiFailure(:final problem):
+          _problem = problem;
+      }
+      _notify();
+      return;
+    }
+  }
+
+  /// Accepte [proposition] ; fait, elle quitte la liste et son changement arrive en tête des changements. Null :
+  /// un geste est déjà en cours sur elle (rien n'est envoyé).
+  Future<RelectureOutcome<RelectureChangement?>?> accept(RelectureProposition proposition) async {
+    if (!_start(proposition.id, RelectureGesture.accept)) return null;
+    final outcome = await _guard(() => api.accept(proposition.id));
+    if (_disposed) return outcome;
+    _end(proposition.id);
+    if (outcome case RelectureDone(:final data)) {
+      _update(
+        propositions: _without(proposition.id),
+        changements: data == null ? null : sortChangements([data, ...changements.where((c) => c.id != data.id)]),
+      );
+      if (data == null) _reload();
+    } else {
+      _reload();
+    }
+    return outcome;
+  }
+
+  /// Ignore [proposition] ; faite, elle quitte la liste (le serveur ne la reproposera pas).
+  Future<RelectureOutcome<void>?> ignore(RelectureProposition proposition) async {
+    if (!_start(proposition.id, RelectureGesture.ignore)) return null;
+    final outcome = await _guard(() => api.ignore(proposition.id));
+    if (_disposed) return outcome;
+    _end(proposition.id);
+    if (outcome is RelectureDone) {
+      _update(propositions: _without(proposition.id));
+    } else {
+      _reload();
+    }
+    return outcome;
+  }
+
+  /// Annule [changement] ; fait, il se montre « Annulé le … ». La liste est relue : une proposition peut revenir.
+  Future<RelectureOutcome<RelectureChangement?>?> undo(RelectureChangement changement) async {
+    if (!_start(changement.id, RelectureGesture.undo)) return null;
+    final outcome = await _guard(() => api.undo(changement.id));
+    if (_disposed) return outcome;
+    _end(changement.id);
+    if (outcome case RelectureDone(:final data?)) {
+      _update(changements: [for (final c in changements) c.id == data.id ? data : c]);
+    }
+    _reload();
+    return outcome;
+  }
+
+  bool _start(String id, RelectureGesture gesture) {
+    if (_busy.containsKey(id)) return false;
+    _busy[id] = gesture;
+    _notify();
+    return true;
+  }
+
+  void _end(String id) {
+    _busy.remove(id);
+    _gestures++;
+  }
+
+  Future<RelectureOutcome<T>> _guard<T>(Future<RelectureOutcome<T>> Function() send) async {
+    try {
+      return await send();
+    } on Exception {
+      return const RelectureFailed(ApiProblem(ApiProblemKind.transport));
+    }
+  }
+
+  List<RelectureProposition> _without(String id) => [
+        for (final p in propositions)
+          if (p.id != id) p
+      ];
+
+  void _update({List<RelectureProposition>? propositions, List<RelectureChangement>? changements}) {
+    _data = (_data ?? Relecture.empty).copyWith(propositions: propositions, changements: changements);
+    _notify();
+  }
+
+  /// Relit en arrière-plan (409, 404, panne, réponse illisible : la vérité est sur le serveur).
+  void _reload() {
+    _notify();
+    load();
+  }
+
+  void _notify() {
+    if (!_disposed) notifyListeners();
+  }
+
+  @override
+  void dispose() {
+    _disposed = true;
+    super.dispose();
+  }
+}
diff --git a/app/lib/pages/insights/relecture_page.dart b/app/lib/pages/insights/relecture_page.dart
new file mode 100644
index 0000000000..7013918f1d
--- /dev/null
