+    test('409 : le message passe, la liste est relue ; 404 sur la lecture = rien à montrer, pas une panne', () async {
+      var reads = 0;
+      var routeKnown = true;
+      final controller = RelectureController(
+        api: RelectureApi(
+          baseUrl: 'https://example.invalid/',
+          send: (request) async {
+            if (request.method == 'GET') {
+              reads++;
+              if (!routeKnown) return _json({'detail': 'Not Found'}, 404);
+              return _json({
+                'propositions': [_proposition('p-1')],
+              });
+            }
+            return _json({'detail': 'Déjà traitée.'}, 409);
+          },
+        ),
+      );
+      addTearDown(controller.dispose);
+      await controller.load();
+      final outcome = await controller.accept(controller.propositions.single);
