+
+      routeKnown = false;
+      final fresh = RelectureController(api: controller.api);
+      addTearDown(fresh.dispose);
+      await fresh.load();
+      expect(fresh.missing, isTrue);
+      expect(fresh.propositions, isEmpty);
+    });
+  });
