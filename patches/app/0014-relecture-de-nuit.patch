+/// Un faux serveur du clone : Insights (vide, un dossier) et la relecture de nuit, mêmes formes que le contrat.
+class _Server {
+  final requests = <ApiRequest>[];
+  List<Map<String, dynamic>> propositions = [_orthographe(), _tacheFaite(), _souvenirs()];
+  List<Map<String, dynamic>> changements = [];
+  int relectureStatus = 200;
+
+  /// Propositions et changements refusés (409) avec ce message (null : sans message).
+  final conflicts = <String, String?>{};
+
+  /// Retient la réponse d'un geste (bouton occupé).
+  Completer<void>? hold;
+  var _next = 0;
+
+  static http.Response _json(Object body, [int status = 200]) =>
+      http.Response(jsonEncode(body), status, headers: {'content-type': 'application/json; charset=utf-8'});
+
+  int count(String method, String path) =>
+      requests.where((r) => r.method == method && Uri.parse(r.url).path == path).length;
+
+  Future<http.Response> send(ApiRequest request) async {
+    requests.add(request);
+    final segments = Uri.parse(request.url).pathSegments;
+    if (segments[1] == 'insights') {
+      switch (segments[2]) {
+        case 'maintenant':
+          return _json({'lignes': [], 'resume': null, 'maj': null, 'version': 0});
+        case 'bilans':
+          return _json({'bilans': []});
+        case 'dossiers':
+          return _json({
+            'dossiers': [
+              {
+                'id': 'arnaud',
+                'titre': 'Dossier Arnaud',
+                'gabarit': 'pro',
+                'statut': 'actif',
+                'maj': '2026-10-09T18:30:00+00:00',
+                'nb_elements': 2,
+              },
+            ],
+          });
+      }
+    }
+    if (segments.length == 3 && request.method == 'GET') {
+      if (relectureStatus != 200) return _json({'detail': 'boom'}, relectureStatus);
+      return _json({
+        'propositions': propositions,
+        'changements': changements,
+        'derniere_relecture': '2026-10-20T04:12:00+00:00',
+      });
+    }
+    final hold = this.hold;
+    if (hold != null) await hold.future;
+    final id = segments[4];
+    if (conflicts.containsKey(id)) return _json({'detail': conflicts[id]}, 409);
+    switch ((segments[3], segments[5])) {
+      case ('propositions', 'accepter'):
+        final proposition = propositions.firstWhere((p) => p['id'] == id);
+        propositions = propositions.where((p) => p['id'] != id).toList();
+        final changement = {
+          ..._changement('ch-${_next++}', proposition['titre'] as String, '2026-10-20T08:00:00+00:00'),
+          'proposition_id': id,
+        };
+        changements = [changement, ...changements];
+        return _json({'changement': changement});
+      case ('propositions', 'ignorer'):
+        propositions = propositions.where((p) => p['id'] != id).toList();
+        return _json({'ok': true});
+      case ('changements', 'annuler'):
+        final index = changements.indexWhere((c) => c['id'] == id);
+        changements[index] = {...changements[index], 'annulable': false, 'annule_le': '2026-10-20T09:30:00+00:00'};
+        return _json({'changement': changements[index]});
+    }
+    return _json({'detail': 'Not Found'}, 404);
+  }
+}
