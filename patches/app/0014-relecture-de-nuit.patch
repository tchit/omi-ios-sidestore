+/// La barre du bas montre [icon] dans une encre neutre (jamais le vert « bon » ni le rouge « mauvais »).
+void _expectNeutralToast(WidgetTester tester, IconData icon) {
+  final shown = tester.widget<Icon>(find.descendant(of: find.byType(SnackBar), matching: find.byIcon(icon)));
+  expect([OmiPalette.light.success, OmiPalette.light.danger], isNot(contains(shown.color)));
+  expect(find.descendant(of: find.byType(SnackBar), matching: find.byIcon(Icons.error_rounded)), findsNothing);
+  expect(find.descendant(of: find.byType(SnackBar), matching: find.byIcon(Icons.check_circle_rounded)), findsNothing);
+}
