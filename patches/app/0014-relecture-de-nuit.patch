+/// Confirme un geste (« Fait », « Changement annulé »…) : la barre habituelle, mais une coche neutre (la coche
+/// verte de l'app dirait « bon » par la couleur).
+void relectureConfirm(BuildContext context, String message) => _show(
+      context,
+      OmiFeedback.buildSnackBar(
+        context,
+        message,
+        kind: OmiFeedbackKind.confirm,
+        duration: OmiFeedbackTiming.confirm,
+        icon: Icons.check_rounded,
+      ),
+    );
+
+/// Un refus du serveur, une proposition partie, une panne : le texte dit tout, l'icône reste neutre (jamais le
+/// rouge de l'app) ; 8 s avec un bouton de fermeture, le temps de lire un message du serveur.
+void relectureNotice(BuildContext context, String message) => _show(
+      context,
+      OmiFeedback.buildSnackBar(
+        context,
+        message,
+        kind: OmiFeedbackKind.error,
+        duration: OmiFeedbackTiming.error,
+        showClose: true,
+        icon: Icons.info_outline_rounded,
+      ),
+    );
+
+void _show(BuildContext context, SnackBar bar) {
+  final messenger = ScaffoldMessenger.maybeOf(context);
+  if (messenger == null) return;
+  messenger.hideCurrentSnackBar();
+  messenger.showSnackBar(bar);
+}
+
+/// Dit le résultat d'un geste : fait ([done]), refusé (409 : le message du serveur), parti (404 : [gone]), ou en
+/// panne.
+void showRelectureOutcome(
+  BuildContext context,
+  RelectureOutcome<Object?> outcome, {
+  required String done,
+  required String gone,
+}) {
+  final l10n = context.l10n;
+  switch (outcome) {
+    case RelectureDone():
+      OmiHaptics.success();
+      relectureConfirm(context, done);
+    case RelectureConflict(:final detail):
+      relectureNotice(context, detail ?? l10n.relectureConflict);
+    case RelectureFailed(:final problem) when problem.kind == ApiProblemKind.notFound:
+      relectureNotice(context, gone);
+    case RelectureFailed():
+      relectureNotice(context, l10n.relectureActionFailed);
+  }
+}
+
+/// Dit le résultat d'une annulation (barre « Fait » ou « Changements récents »).
+void showRelectureUndoOutcome(BuildContext context, RelectureOutcome<RelectureChangement?> outcome) =>
+    showRelectureOutcome(context, outcome, done: context.l10n.relectureUndone, gone: context.l10n.relectureChangeGone);
