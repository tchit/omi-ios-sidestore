diff --git a/app/lib/backend/http/api/relecture.dart b/app/lib/backend/http/api/relecture.dart
new file mode 100644
index 0000000000..73f121bbfd
--- /dev/null
+++ b/app/lib/backend/http/api/relecture.dart
@@ -0,0 +1,129 @@
+import 'dart:convert';
+
+import 'package:http/http.dart' as http;
+
+import 'package:omi/backend/http/api_result.dart';
+import 'package:omi/backend/http/shared.dart';
+import 'package:omi/backend/schema/relecture.dart';
+import 'package:omi/env/env.dart';
+import 'package:omi/services/auth/auth_token_result.dart';
+
+/// Le résultat d'un geste de la relecture (accepter, ignorer, annuler).
+sealed class RelectureOutcome<T> {
+  const RelectureOutcome();
+}
+
+/// Fait (le serveur a répondu 2xx). [data] est ce qu'il a rendu, s'il se lit.
+final class RelectureDone<T> extends RelectureOutcome<T> {
+  const RelectureDone(this.data);
+  final T data;
+}
+
+/// Refusé par le serveur (409) : déjà traité, ou les données ont changé depuis. [detail] est son message, à
+/// montrer tel quel.
+final class RelectureConflict<T> extends RelectureOutcome<T> {
+  const RelectureConflict(this.detail);
+  final String? detail;
+}
+
+/// En échec : réseau, serveur, ou 404 ([ApiProblemKind.notFound] : n'existe plus).
+final class RelectureFailed<T> extends RelectureOutcome<T> {
+  const RelectureFailed(this.problem);
+  final ApiProblem problem;
+}
+
+/// Clone local : les routes de la « Relecture de nuit » du serveur du clone. L'app lit les propositions et les
+/// changements, et ne fait que des gestes explicites de Mike : accepter, ignorer une proposition, annuler un
+/// changement. Rien n'est supprimé d'ici.
+class RelectureApi {
+  RelectureApi({this.send, String? baseUrl}) : _baseUrl = baseUrl;
+
+  /// Remplace l'envoi (tests) ; null : le chemin de production (en-têtes, jeton, nouvel essai après 401).
+  final ApiSend? send;
+  final String? _baseUrl;
+
+  static const _root = 'v1/clone/relecture';
+
+  String _url(String path) => '${_baseUrl ?? Env.apiBaseUrl}$path';
+
+  /// Les propositions en attente, les changements récents (le plus récent d'abord) et l'heure de la dernière
+  /// relecture. Une réponse sans rien (`{}`) n'est pas une erreur.
+  Future<ApiResult<Relecture>> load() => executeApi(
+        request: ApiRequest(url: _url(_root), method: 'GET'),
+        send: send,
+        decode: (body) {
+          final decoded = jsonDecode(body);
+          if (decoded is! Map<String, dynamic>) throw const FormatException('Invalid relecture answer');
+          return Relecture.fromJson(decoded);
+        },
+      );
+
+  /// Applique la proposition ; rend le changement fait (null s'il ne se lit pas : c'est fait quand même).
+  Future<RelectureOutcome<RelectureChangement?>> accept(String propositionId) =>
+      _post('$_root/propositions/${Uri.encodeComponent(propositionId)}/accepter', RelectureChangement.tryParseEnvelope);
+
+  /// Écarte la proposition ; elle ne reviendra pas.
+  Future<RelectureOutcome<void>> ignore(String propositionId) =>
+      _post('$_root/propositions/${Uri.encodeComponent(propositionId)}/ignorer', (_) {});
+
+  /// Remet les données comme avant le changement ; rend le changement à jour (`annule_le`).
+  Future<RelectureOutcome<RelectureChangement?>> undo(String changementId) =>
+      _post('$_root/changements/${Uri.encodeComponent(changementId)}/annuler', RelectureChangement.tryParseEnvelope);
+
+  /// Un POST dont le refus (409) garde le message du serveur : [executeApi] ne rend que le code, la réponse est
+  /// donc lue au passage. Le chemin de production reste celui d'[executeApi] (même envoi, même 401).
+  Future<RelectureOutcome<T>> _post<T>(String path, T Function(Object? json) read) async {
+    http.Response? answer;
+    AuthTokenResult? refresh;
+    final result = await executeApi<T>(
+      request: ApiRequest(
+        url: _url(path),
+        method: 'POST',
+        headers: const {'Content-Type': 'application/json'},
+        body: '{}',
+      ),
+      send: (request) async {
+        final custom = send;
+        final response = custom != null
+            ? await custom(request)
+            : await sendUncaughtApiCall(
+                url: request.url,
+                headers: request.headers,
+                body: request.body,
+                method: request.method,
+                onAuthRefresh: (result) => refresh = result,
+              );
+        return answer = response;
+      },
+      // Le geste a réussi dès que le serveur répond 2xx ; une réponse illisible n'y change rien.
+      decode: (body) => read(_jsonOrNull(body)),
+    );
+    switch (result) {
+      case ApiSuccess(:final data):
+        return RelectureDone(data);
+      case ApiFailure(:final problem) when problem.statusCode == 409:
+        return RelectureConflict(_detail(answer?.body));
+      case ApiFailure(:final problem) when problem.statusCode == 401 && refresh is AuthTokenTransientFailure:
+        return const RelectureFailed(ApiProblem(ApiProblemKind.authTransient, statusCode: 401));
+      case ApiFailure(:final problem):
+        return RelectureFailed(problem);
+    }
+  }
+
+  static Object? _jsonOrNull(String body) {
+    try {
+      return jsonDecode(body);
+    } on FormatException {
+      return null;
+    }
+  }
+
+  /// `{"detail": "…"}` → le message ; autre chose (FastAPI rend parfois une liste) → null.
+  static String? _detail(String? body) {
+    if (body == null) return null;
+    final json = _jsonOrNull(body);
+    if (json is! Map) return null;
+    final detail = json['detail'];
+    return detail is String && detail.trim().isNotEmpty ? detail.trim() : null;
+  }
+}
diff --git a/app/lib/backend/schema/relecture.dart b/app/lib/backend/schema/relecture.dart
new file mode 100644
index 0000000000..cab93fac9a
--- /dev/null
+++ b/app/lib/backend/schema/relecture.dart
@@ -0,0 +1,247 @@
+/// Clone local : la « Relecture de nuit ». Chaque nuit, le serveur du clone relit les données de Mike et PROPOSE
+/// des corrections (nom mal orthographié, tâches en double, tâche visiblement faite, souvenirs ou fiches de
+/// personnes en double). Rien ne s'applique sans son accord ; ce qu'il accepte devient un changement, annulable.
+///
+/// Formes rendues par `GET /v1/clone/relecture` et par les gestes (accepter, ignorer, annuler). Dart pur (sans
+/// Flutter) pour être testé seul. Lecture tolérante : champs inconnus ignorés, champs absents tolérés (liste vide,
+/// null) ; une ligne illisible (sans id) est écartée et comptée sans cacher les autres ; seule une liste non vide
+/// entièrement illisible est une erreur de lecture ([FormatException]).
+library;
+
+import 'package:omi/backend/schema/insight_dossier.dart' show uniqueById;
+
+/// Les types de proposition connus ; un autre reste affiché, avec une étiquette neutre.
+const relectureTypes = ['orthographe', 'tache_doublon', 'tache_terminee', 'souvenir_doublon', 'personne_doublon'];
+
+/// Ce qu'une proposition ou un changement touche : une conversation, une tâche, un souvenir, une personne.
+class RelectureCible {
+  const RelectureCible({required this.type, required this.id, this.titre});
+
+  final String type;
+  final String id;
+  final String? titre;
+
+  static RelectureCible? tryParse(Object? json) {
+    if (json is! Map) return null;
+    final id = _string(json['id']);
+    if (id == null) return null;
+    return RelectureCible(type: _string(json['type']) ?? '', id: id, titre: _string(json['titre']));
+  }
+}
+
+/// Une citation courte qui justifie la proposition, avec sa source (et la conversation à ouvrir, s'il y en a une).
+class RelectureExtrait {
+  const RelectureExtrait({required this.texte, this.source, this.conversationId});
+
+  final String texte;
+  final String? source;
+  final String? conversationId;
+
+  static RelectureExtrait? tryParse(Object? json) {
+    if (json is! Map) return null;
+    final texte = _string(json['texte']);
+    if (texte == null) return null;
+    return RelectureExtrait(
+      texte: texte,
+      source: _string(json['source']),
+      conversationId: _string(json['conversation_id']),
+    );
+  }
+}
+
+class RelectureProposition {
+  const RelectureProposition({
+    required this.id,
+    required this.type,
+    this.titre,
+    this.explication,
+    this.avant,
+    this.apres,
+    this.extraits = const [],
+    this.cibles = const [],
+    this.cree,
+  });
+
+  final String id;
+  final String type;
+  final String? titre;
+  final String? explication;
+
+  /// Le texte tel qu'il est, et tel qu'il serait une fois la proposition acceptée (l'un ou l'autre peut manquer).
+  final String? avant;
+  final String? apres;
+  final List<RelectureExtrait> extraits;
+  final List<RelectureCible> cibles;
+  final DateTime? cree;
+
+  factory RelectureProposition.fromJson(Map<String, dynamic> json) {
+    final id = _string(json['id']);
+    if (id == null) throw const FormatException('Proposition sans id');
+    return RelectureProposition(
+      id: id,
+      type: _string(json['type']) ?? '',
+      titre: _string(json['titre']),
+      explication: _string(json['explication']),
+      avant: _string(json['avant']),
+      apres: _string(json['apres']),
+      extraits: _list(json['extraits'], RelectureExtrait.tryParse),
+      cibles: uniqueById(_list(json['cibles'], RelectureCible.tryParse), (cible) => '${cible.type}/${cible.id}'),
+      cree: _date(json['cree']),
+    );
+  }
+}
+
+/// Une cible d'un changement, et son texte avant / après.
+class RelectureDetail {
+  const RelectureDetail({this.cible, this.avant, this.apres});
+
+  final RelectureCible? cible;
+  final String? avant;
+  final String? apres;
+
+  static RelectureDetail? tryParse(Object? json) {
+    if (json is! Map) return null;
+    final detail = RelectureDetail(
+      cible: RelectureCible.tryParse(json['cible']),
+      avant: _string(json['avant']),
+      apres: _string(json['apres']),
+    );
+    // Rien à montrer : écarté.
+    if (detail.cible == null && detail.avant == null && detail.apres == null) return null;
+    return detail;
+  }
+}
+
+class RelectureChangement {
+  const RelectureChangement({
+    required this.id,
+    this.propositionId,
+    required this.type,
+    this.titre,
+    this.details = const [],
+    this.faitLe,
+    this.annulable = false,
+    this.annuleLe,
+  });
+
+  final String id;
+  final String? propositionId;
+  final String type;
+  final String? titre;
+  final List<RelectureDetail> details;
+  final DateTime? faitLe;
+
+  /// Ce que dit le serveur ; voir [peutAnnuler].
+  final bool annulable;
+  final DateTime? annuleLe;
+
+  /// Annulable et pas déjà annulé.
+  bool get peutAnnuler => annulable && annuleLe == null;
+
+  factory RelectureChangement.fromJson(Map<String, dynamic> json) {
+    final id = _string(json['id']);
+    if (id == null) throw const FormatException('Changement sans id');
+    return RelectureChangement(
+      id: id,
+      propositionId: _string(json['proposition_id']),
+      type: _string(json['type']) ?? '',
+      titre: _string(json['titre']),
+      details: _list(json['details'], RelectureDetail.tryParse),
+      faitLe: _date(json['fait_le']),
+      annulable: json['annulable'] == true,
+      annuleLe: _date(json['annule_le']),
+    );
+  }
+
+  /// Le changement rendu par un geste (`{"changement": {...}}`) ; null s'il manque ou ne se lit pas (le geste a
+  /// quand même réussi : c'est le code HTTP qui le dit).
+  static RelectureChangement? tryParseEnvelope(Object? json) {
+    if (json is! Map) return null;
+    final changement = json['changement'];
+    if (changement is! Map<String, dynamic>) return null;
+    try {
+      return RelectureChangement.fromJson(changement);
+    } on FormatException {
+      return null;
+    }
+  }
+}
+
+/// Le plus récent d'abord ; sans date, à la fin ; à date égale, l'ordre du serveur.
+List<RelectureChangement> sortChangements(Iterable<RelectureChangement> changements) {
+  final indexed = changements.toList().indexed.toList();
+  indexed.sort((a, b) {
+    final da = a.$2.faitLe;
+    final db = b.$2.faitLe;
+    if (da == null && db == null) return a.$1.compareTo(b.$1);
+    if (da == null) return 1;
+    if (db == null) return -1;
+    final byDate = db.compareTo(da);
+    return byDate != 0 ? byDate : a.$1.compareTo(b.$1);
+  });
+  return [for (final (_, changement) in indexed) changement];
+}
+
+class Relecture {
+  const Relecture({
+    this.propositions = const [],
+    this.changements = const [],
+    this.derniereRelecture,
+    this.lignesEcartees = 0,
+  });
+
+  static const empty = Relecture();
+
+  /// Dans l'ordre du serveur.
+  final List<RelectureProposition> propositions;
+
+  /// Le plus récent d'abord.
+  final List<RelectureChangement> changements;
+  final DateTime? derniereRelecture;
+
+  /// Lignes illisibles écartées (propositions et changements).
+  final int lignesEcartees;
+
+  factory Relecture.fromJson(Map<String, dynamic> json) {
+    var rejected = 0;
+    List<T> rows<T>(Object? value, T Function(Map<String, dynamic>) parse) {
+      if (value is! List) return const [];
+      final kept = <T>[];
+      var bad = 0;
+      for (final item in value) {
+        try {
+          if (item is! Map<String, dynamic>) throw const FormatException('Ligne illisible');
+          kept.add(parse(item));
+        } on FormatException {
+          bad++;
+        }
+      }
+      if (kept.isEmpty && bad > 0) throw const FormatException('Liste illisible');
+      rejected += bad;
+      return kept;
+    }
+
+    final propositions = uniqueById(rows(json['propositions'], RelectureProposition.fromJson), (p) => p.id);
+    final changements = uniqueById(rows(json['changements'], RelectureChangement.fromJson), (c) => c.id);
+    return Relecture(
+      propositions: propositions,
+      changements: sortChangements(changements),
+      derniereRelecture: _date(json['derniere_relecture']),
+      lignesEcartees: rejected,
+    );
+  }
+
+  Relecture copyWith({List<RelectureProposition>? propositions, List<RelectureChangement>? changements}) => Relecture(
+        propositions: propositions ?? this.propositions,
+        changements: changements ?? this.changements,
+        derniereRelecture: derniereRelecture,
+        lignesEcartees: lignesEcartees,
+      );
+}
+
+List<T> _list<T>(Object? value, T? Function(Object?) parse) =>
+    value is List ? value.map(parse).whereType<T>().toList() : const [];
+
+String? _string(Object? value) => value is String && value.trim().isNotEmpty ? value.trim() : null;
+
+DateTime? _date(Object? value) => value is String ? DateTime.tryParse(value) : null;
