@@ -0,0 +1,294 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+
+import 'package:omi/backend/http/api/relecture.dart';
+import 'package:omi/backend/schema/relecture.dart';
+import 'package:omi/pages/insights/insight_sources.dart';
+import 'package:omi/pages/insights/relecture_changements_page.dart';
+import 'package:omi/pages/insights/relecture_controller.dart';
+import 'package:omi/pages/insights/relecture_widgets.dart';
+import 'package:omi/ui/ui.dart';
+import 'package:omi/utils/l10n_extensions.dart';
+import 'package:omi/utils/other/temp.dart';
+
+/// Ouvre « À vérifier » par-dessus l'accueil ; se termine quand on en revient.
+Future<void> routeToRelecture(
+  BuildContext context,
+  RelectureController controller, {
+  InsightSourceOpener sources = const InsightSourceOpener(),
+}) =>
+    routeToPage(context, RelecturePage(controller: controller, sources: sources));
+
+/// Clone local : « À vérifier », les corrections proposées par la relecture de nuit. Une carte par proposition :
+/// ce qu'Omi a vu (titre, explication), avant → après, les extraits qui le montrent, ce qui est touché ; puis
+/// « Ignorer » ou « Accepter ». Rien ne change sans un de ces deux gestes. Accepter : la carte part, « Fait » avec
+/// « Annuler » quelques secondes (puis dans « Changements récents ») ; Ignorer : la carte part. Un refus du
+/// serveur (409 : déjà traitée, ou les données ont changé) affiche son message et relit la liste.
+class RelecturePage extends StatefulWidget {
+  const RelecturePage({super.key, required this.controller, this.sources = const InsightSourceOpener()});
+
+  final RelectureController controller;
+  final InsightSourceOpener sources;
+
+  @override
+  State<RelecturePage> createState() => _RelecturePageState();
+}
+
+class _RelecturePageState extends State<RelecturePage> {
+  RelectureController get _controller => widget.controller;
+
+  /// Le contexte de l'application : un « Annuler » touché après avoir quitté la page doit encore pouvoir dire
+  /// son résultat.
+  late BuildContext _appContext;
+
+  @override
+  void initState() {
+    super.initState();
+    // La carte de l'onglet a pu être lue il y a longtemps : relire en arrière-plan (ce qui est connu reste).
+    unawaited(_controller.load());
+  }
+
+  @override
+  void didChangeDependencies() {
+    super.didChangeDependencies();
+    _appContext = Navigator.of(context, rootNavigator: true).context;
+  }
+
+  /// Dit le résultat d'un geste : sur la page si elle est encore là, sinon sur l'application.
+  void _say(void Function(BuildContext context) say) {
+    if (mounted) {
+      say(context);
+    } else if (_appContext.mounted) {
+      say(_appContext);
+    }
+  }
+
+  Future<void> _accept(RelectureProposition proposition) async {
+    OmiHaptics.selection();
+    final outcome = await _controller.accept(proposition);
+    if (outcome == null) return;
+    _say((context) {
+      final l10n = context.l10n;
+      // Fait, et annulable : « Fait » avec « Annuler » quelques secondes (coche neutre).
+      if (outcome case RelectureDone(:final data?) when data.peutAnnuler) {
+        OmiHaptics.success();
+        unawaited(OmiFeedback.undo(
+          context,
+          l10n.relectureDone,
+          icon: Icons.check_rounded,
+          onUndo: () => unawaited(_undo(data)),
+        ));
+        return;
+      }
+      showRelectureOutcome(context, outcome, done: l10n.relectureDone, gone: l10n.relecturePropositionGone);
+    });
+  }
+
+  /// « Annuler » de la barre « Fait » : pas de confirmation, le geste vient d'être fait (et se fait même si la
+  /// page a été quittée entre-temps).
+  Future<void> _undo(RelectureChangement changement) async {
+    final outcome = await _controller.undo(changement);
+    if (outcome == null) return;
+    _say((context) => showRelectureUndoOutcome(context, outcome));
+  }
+
+  Future<void> _ignore(RelectureProposition proposition) async {
+    OmiHaptics.selection();
+    final outcome = await _controller.ignore(proposition);
+    if (outcome == null) return;
+    _say((context) => showRelectureOutcome(
+          context,
+          outcome,
+          done: context.l10n.relectureIgnored,
+          gone: context.l10n.relecturePropositionGone,
+        ));
+  }
+
+  void _openConversation(String id) => unawaited(widget.sources.openConversation(context, id));
+
+  void _openTasks() => unawaited(widget.sources.openTasks(context));
+
+  void _openChanges() => unawaited(routeToRelectureChanges(context, _controller, sources: widget.sources));
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = context.l10n;
+    return Scaffold(
+      appBar: AppBar(leading: const OmiBackButton(), title: Text(l10n.relectureTitle)),
+      body: ListenableBuilder(
+        listenable: _controller,
+        builder: (context, _) {
+          final data = _controller.data;
+          if (data == null) {
+            return _controller.problem == null
+                ? const OmiLoadingState()
+                : OmiErrorState(message: l10n.relectureListLoadError, onRetry: _controller.load);
+          }
+          final propositions = data.propositions;
+          final changesLink = data.changements.isEmpty
+              ? null
+              : OmiButton.tertiary(
+                  key: const ValueKey('relecture_changes_link'),
+                  label: l10n.relectureChangesTitle,
+                  icon: Icons.history_rounded,
+                  onPressed: _openChanges,
+                );
+          if (propositions.isEmpty) {
+            return RefreshIndicator(
+              onRefresh: _controller.load,
+              child: LayoutBuilder(
+                builder: (context, constraints) => SingleChildScrollView(
+                  physics: const AlwaysScrollableScrollPhysics(),
+                  child: ConstrainedBox(
+                    constraints: BoxConstraints(minHeight: constraints.maxHeight),
+                    child: OmiEmptyState(
+                      key: const ValueKey('relecture_all_done'),
+                      icon: Icons.fact_check_outlined,
+                      title: l10n.relectureAllDoneTitle,
+                      message: l10n.relectureAllDoneMessage,
+                      action: changesLink,
+                    ),
+                  ),
+                ),
+              ),
+            );
+          }
+          final lastRun = data.derniereRelecture;
+          return RefreshIndicator(
+            onRefresh: _controller.load,
+            child: ListView(
+              key: const ValueKey('relecture_list'),
+              physics: const AlwaysScrollableScrollPhysics(),
+              padding: EdgeInsets.fromLTRB(
+                OmiSpacing.md,
+                OmiSpacing.xs,
+                OmiSpacing.md,
+                OmiSpacing.xxl + MediaQuery.paddingOf(context).bottom,
+              ),
+              children: [
+                Padding(
+                  padding: const EdgeInsets.fromLTRB(OmiSpacing.xxs, 0, OmiSpacing.xxs, OmiSpacing.sm),
+                  child: Column(
+                    crossAxisAlignment: CrossAxisAlignment.start,
+                    children: [
+                      Text(l10n.relectureIntro, style: OmiType.subhead.copyWith(color: OmiColors.textTertiary)),
+                      if (lastRun != null) ...[
+                        const SizedBox(height: OmiSpacing.xxs),
+                        Text(
+                          l10n.relectureLastRun(OmiDateFormat.of(context).timestamp(lastRun.toLocal())),
+                          style: OmiType.footnote.copyWith(color: OmiColors.textTertiary),
+                        ),
+                      ],
+                    ],
+                  ),
+                ),
+                for (final proposition in propositions)
+                  Padding(
+                    padding: const EdgeInsets.only(bottom: OmiSpacing.sm),
+                    child: RelecturePropositionCard(
+                      key: ValueKey('relecture_proposition_${proposition.id}'),
+                      proposition: proposition,
+                      gesture: _controller.gestureOn(proposition.id),
+                      onAccept: () => unawaited(_accept(proposition)),
+                      onIgnore: () => unawaited(_ignore(proposition)),
+                      onOpenConversation: _openConversation,
+                      onOpenTasks: _openTasks,
+                    ),
+                  ),
+                if (changesLink != null) Center(child: changesLink),
+              ],
+            ),
+          );
+        },
+      ),
+    );
+  }
+}
+
+/// Une proposition : sa nature (icône et libellé), son titre en gras, l'explication, avant → après, les extraits,
+/// ce qui est touché, puis « Ignorer » et « Accepter ». Pendant un geste, son bouton tourne et l'autre attend.
+class RelecturePropositionCard extends StatelessWidget {
+  const RelecturePropositionCard({
+    super.key,
+    required this.proposition,
+    required this.gesture,
+    required this.onAccept,
+    required this.onIgnore,
+    required this.onOpenConversation,
+    required this.onOpenTasks,
+  });
+
+  final RelectureProposition proposition;
+
+  /// Le geste en cours sur elle, s'il y en a un.
+  final RelectureGesture? gesture;
+  final VoidCallback onAccept;
+  final VoidCallback onIgnore;
+  final ValueChanged<String> onOpenConversation;
+  final VoidCallback onOpenTasks;
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = context.l10n;
+    final p = proposition;
+    final idle = gesture == null;
+    final titre = p.titre;
+    final explication = p.explication;
+    return Material(
+      color: OmiColors.surface1,
+      borderRadius: OmiRadius.mdAll,
+      child: Padding(
+        padding: const EdgeInsets.fromLTRB(OmiSpacing.md, OmiSpacing.md, OmiSpacing.md, OmiSpacing.sm),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.stretch,
+          children: [
+            RelectureKindLine(type: p.type),
+            if (titre != null) ...[
+              const SizedBox(height: OmiSpacing.xs),
+              Semantics(header: true, child: Text(titre, style: OmiType.headline)),
+            ],
+            if (explication != null) ...[
+              const SizedBox(height: OmiSpacing.xxs),
+              Text(explication, style: OmiType.subhead),
+            ],
+            if (p.avant != null || p.apres != null) ...[
+              const SizedBox(height: OmiSpacing.sm),
+              RelectureDiff(before: p.avant, after: p.apres),
+            ],
+            if (p.extraits.isNotEmpty) ...[
+              const SizedBox(height: OmiSpacing.xxs),
+              RelectureQuotes(ownerId: p.id, extraits: p.extraits, onOpenConversation: onOpenConversation),
+            ],
+            if (p.cibles.isNotEmpty) ...[
+              const SizedBox(height: OmiSpacing.sm),
+              RelectureTargets(cibles: p.cibles, onOpenConversation: onOpenConversation, onOpenTasks: onOpenTasks),
+            ],
+            const SizedBox(height: OmiSpacing.sm),
+            Wrap(
+              alignment: WrapAlignment.end,
+              spacing: OmiSpacing.xs,
+              runSpacing: OmiSpacing.xs,
+              children: [
+                OmiButton.secondary(
+                  key: ValueKey('relecture_ignore_${p.id}'),
+                  label: l10n.relectureIgnore,
+                  size: OmiButtonSize.compact,
+                  isLoading: gesture == RelectureGesture.ignore,
+                  onPressed: idle || gesture == RelectureGesture.ignore ? onIgnore : null,
+                ),
+                OmiButton(
+                  key: ValueKey('relecture_accept_${p.id}'),
+                  label: l10n.relectureAccept,
+                  size: OmiButtonSize.compact,
+                  isLoading: gesture == RelectureGesture.accept,
+                  onPressed: idle || gesture == RelectureGesture.accept ? onAccept : null,
+                ),
+              ],
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+}
diff --git a/app/lib/pages/insights/relecture_widgets.dart b/app/lib/pages/insights/relecture_widgets.dart
new file mode 100644
index 0000000000..b0d339e047
--- /dev/null
+++ b/app/lib/pages/insights/relecture_widgets.dart
@@ -0,0 +1,415 @@
+import 'package:flutter/material.dart';
+
+import 'package:omi/backend/http/api/relecture.dart';
+import 'package:omi/backend/http/api_result.dart';
+import 'package:omi/backend/schema/relecture.dart';
+import 'package:omi/l10n/app_localizations.dart';
+import 'package:omi/pages/insights/insight_dossier_page.dart';
+import 'package:omi/pages/insights/relecture_controller.dart';
+import 'package:omi/ui/ui.dart';
+import 'package:omi/utils/l10n_extensions.dart';
+
+/// Clone local : les morceaux communs de la « Relecture de nuit » (carte de l'onglet, pages « À vérifier » et
+/// « Changements récents »). Mike est daltonien : jamais de rouge ni de vert pour dire avant / après ou bon /
+/// mauvais. Avant est barré, une flèche, après est en gras ; encres neutres (textPrimary, textTertiary : au moins
+/// 4,5:1 sur les cartes en thème clair).
+
+String relectureTypeLabel(AppLocalizations l10n, String type) => switch (type) {
+      'orthographe' => l10n.relectureTypeSpelling,
+      'tache_doublon' => l10n.relectureTypeDuplicateTasks,
+      'tache_terminee' => l10n.relectureTypeTaskDone,
+      'souvenir_doublon' => l10n.relectureTypeDuplicateMemories,
+      'personne_doublon' => l10n.relectureTypeDuplicatePeople,
+      '' => l10n.relectureTypeOther,
+      // Un type inconnu garde le mot du serveur, lisible.
+      _ => _capitalized(type.replaceAll('_', ' ')),
+    };
+
+/// Toujours montrée avec son libellé, jamais seule porteuse du sens.
+IconData relectureTypeIcon(String type) => switch (type) {
+      'orthographe' => Icons.spellcheck_rounded,
+      'tache_doublon' || 'souvenir_doublon' => Icons.call_merge_rounded,
+      'tache_terminee' => Icons.task_alt_rounded,
+      'personne_doublon' => Icons.people_outline_rounded,
+      _ => Icons.auto_fix_high_outlined,
+    };
+
+IconData relectureTargetIcon(String type) => switch (type) {
+      'conversation' => Icons.graphic_eq_rounded,
+      'tache' => Icons.check_box_outlined,
+      'souvenir' => Icons.lightbulb_outline_rounded,
+      'personne' => Icons.person_outline_rounded,
+      _ => Icons.label_outline_rounded,
+    };
+
+String relectureTargetLabel(AppLocalizations l10n, RelectureCible cible) =>
+    cible.titre ??
+    switch (cible.type) {
+      'conversation' => l10n.relectureTargetConversation,
+      'tache' => l10n.relectureTargetTask,
+      'souvenir' => l10n.relectureTargetMemory,
+      'personne' => l10n.relectureTargetPerson,
+      _ => cible.type.isEmpty ? l10n.relectureTypeOther : _capitalized(cible.type),
+    };
+
+String _capitalized(String word) => word.isEmpty ? word : word[0].toUpperCase() + word.substring(1);
+
+/// La nature d'une proposition ou d'un changement : icône ET libellé, puis (facultatif) une date.
+class RelectureKindLine extends StatelessWidget {
+  const RelectureKindLine({super.key, required this.type, this.trailing});
+
+  final String type;
+  final String? trailing;
+
+  @override
+  Widget build(BuildContext context) {
+    final label = [relectureTypeLabel(context.l10n, type), if (trailing != null) trailing!].join(' · ');
+    return Row(
+      children: [
+        ExcludeSemantics(child: Icon(relectureTypeIcon(type), size: 18, color: OmiColors.textTertiary)),
+        const SizedBox(width: OmiSpacing.xs),
+        Expanded(
+          child: Text(
+            label,
+            style: OmiType.footnote.copyWith(color: OmiColors.textTertiary, fontWeight: FontWeight.w600),
+          ),
+        ),
+      ],
+    );
+  }
+}
+
+/// Avant → après. Courts : sur une ligne avec une flèche ; longs : l'un sous l'autre. Avant barré (encre
+/// neutre), après en gras ; un seul des deux : « Avant : … » ou « Après : … ». Un lecteur d'écran entend
+/// « Avant : … Après : … ».
+class RelectureDiff extends StatelessWidget {
+  const RelectureDiff({super.key, this.before, this.after});
+
+  final String? before;
+  final String? after;
+
+  static const _inlineLimit = 40;
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = context.l10n;
+    final before = this.before;
+    final after = this.after;
+    if (before == null && after == null) return const SizedBox.shrink();
+    final beforeStyle = OmiType.subhead.copyWith(
+      color: OmiColors.textTertiary,
+      decoration: TextDecoration.lineThrough,
+      decorationColor: OmiColors.textTertiary,
+    );
+    final afterStyle = OmiType.subhead.copyWith(color: OmiColors.textPrimary, fontWeight: FontWeight.w700);
+    final String spoken;
+    final Widget body;
+    if (before != null && after != null) {
+      spoken = l10n.relectureDiffSemantics(before, after);
+      final short = before.length <= _inlineLimit &&
+          after.length <= _inlineLimit &&
+          !before.contains('\n') &&
+          !after.contains('\n');
+      final beforeText = Text(before, key: const ValueKey('relecture_before'), style: beforeStyle);
+      final afterText = Text(after, key: const ValueKey('relecture_after'), style: afterStyle);
+      body = short
+          ? Wrap(
+              crossAxisAlignment: WrapCrossAlignment.center,
+              spacing: OmiSpacing.xs,
+              runSpacing: OmiSpacing.xxs,
+              children: [
+                beforeText,
+                Icon(Icons.arrow_forward_rounded, size: 16, color: OmiColors.textTertiary),
+                afterText,
+              ],
+            )
+          : Column(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                beforeText,
+                Padding(
+                  padding: const EdgeInsets.symmetric(vertical: 2),
+                  child: Icon(Icons.arrow_downward_rounded, size: 16, color: OmiColors.textTertiary),
+                ),
+                afterText,
+              ],
+            );
+    } else if (before != null) {
+      spoken = l10n.relectureBefore(before);
+      body = Text(spoken,
+          key: const ValueKey('relecture_before'), style: OmiType.subhead.copyWith(color: OmiColors.textTertiary));
+    } else {
+      spoken = l10n.relectureAfter(after!);
+      body = Text(spoken, key: const ValueKey('relecture_after'), style: afterStyle);
+    }
+    return Semantics(
+      container: true,
+      label: spoken,
+      excludeSemantics: true,
+      child: Container(
+        width: double.infinity,
+        padding: const EdgeInsets.symmetric(horizontal: OmiSpacing.sm, vertical: OmiSpacing.xs),
+        decoration: BoxDecoration(color: OmiColors.surface0, borderRadius: OmiRadius.smAll),
+        child: body,
+      ),
+    );
+  }
+}
+
+/// Les extraits : citations courtes avec leur source ; toucher ouvre la conversation quand il y en a une.
+class RelectureQuotes extends StatelessWidget {
+  const RelectureQuotes({super.key, required this.ownerId, required this.extraits, required this.onOpenConversation});
+
+  /// L'id de la proposition (clés des extraits).
+  final String ownerId;
+  final List<RelectureExtrait> extraits;
+  final ValueChanged<String> onOpenConversation;
+
+  @override
+  Widget build(BuildContext context) {
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        for (final (index, extrait) in extraits.indexed) _quote(context, index, extrait),
+      ],
+    );
+  }
+
+  Widget _quote(BuildContext context, int index, RelectureExtrait extrait) {
+    final conversationId = extrait.conversationId;
+    final source = extrait.source;
+    final content = Container(
+      padding: const EdgeInsets.fromLTRB(OmiSpacing.sm, OmiSpacing.xxs, OmiSpacing.xxs, OmiSpacing.xxs),
+      decoration: BoxDecoration(border: Border(left: BorderSide(color: OmiColors.border, width: 3))),
+      child: Row(
+        children: [
+          Expanded(
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                Text(extrait.texte, style: OmiType.subhead.copyWith(fontStyle: FontStyle.italic)),
+                if (source != null)
+                  Padding(
+                    padding: const EdgeInsets.only(top: 2),
+                    child: Text('— $source', style: OmiType.footnote.copyWith(color: OmiColors.textTertiary)),
+                  ),
+              ],
+            ),
+          ),
+          if (conversationId != null)
+            ExcludeSemantics(child: Icon(Icons.chevron_right_rounded, size: 20, color: OmiColors.textTertiary)),
+        ],
+      ),
+    );
+    return Padding(
+      key: ValueKey('relecture_extrait_${ownerId}_$index'),
+      padding: const EdgeInsets.only(top: OmiSpacing.xs),
+      child: conversationId == null
+          ? content
+          : Semantics(
+              button: true,
+              child: InkWell(
+                borderRadius: OmiRadius.smAll,
+                onTap: () => onOpenConversation(conversationId),
+                child: ConstrainedBox(constraints: const BoxConstraints(minHeight: 44), child: content),
+              ),
+            ),
+    );
+  }
+}
