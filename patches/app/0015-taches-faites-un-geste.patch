+/// Une proposition que le serveur n'a pas pu appliquer lors d'une validation groupée, et pourquoi.
+class RelectureRefus {
+  const RelectureRefus({required this.id, this.raison});
+
+  final String id;
+  final String? raison;
+
+  static RelectureRefus? tryParse(Object? json) {
+    if (json is! Map) return null;
