diff --git a/app/test/unit/taches_faites_test.dart b/app/test/unit/taches_faites_test.dart
new file mode 100644
index 0000000000..535cce749c
--- /dev/null
+++ b/app/test/unit/taches_faites_test.dart
@@ -0,0 +1,245 @@
+// Clone local : tâches pensées faites, validées d'un seul geste (0015) — lecture de la nature (« faite » /
+// « passee ») et de la tâche visée, de la réponse de POST /v1/clone/relecture/taches-faites/valider (changement
+// groupé, compteurs, refusées ; tolérante), l'appel (adresse, corps exact accepter / ignorer, 400, 409, panne) et
+// l'état partagé (jamais deux envois, les traitées quittent la liste sauf les refusées, relue ensuite).
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+
+import 'package:omi/backend/http/api/relecture.dart';
+import 'package:omi/backend/http/api_result.dart';
+import 'package:omi/backend/schema/relecture.dart';
+import 'package:omi/pages/insights/relecture_controller.dart';
+
+Map<String, dynamic> _faite(String id, String tache, {String nature = 'faite'}) => {
+      'id': id,
+      'type': 'tache_terminee',
+      'nature': nature,
+      'titre': 'Tâche faite',
+      'explication': nature == 'passee' ? 'Le rendez-vous était hier.' : null,
+      'extraits': [
+        if (nature == 'faite') {'texte': 'c’est envoyé', 'source': 'Réunion du 20 oct.', 'conversation_id': 'c-1'},
+      ],
+      'cibles': [
+        {'type': 'conversation', 'id': 'c-1', 'titre': 'Réunion'},
+        {'type': 'tache', 'id': tache, 'titre': 'Tâche $tache'},
+      ],
+    };
+
+Map<String, dynamic> _groupe(String id) => {
+      'id': id,
+      'proposition_id': null,
+      'type': 'tache_terminee',
+      'titre': '2 tâches cochées d’un coup',
+      'details': [],
+      'fait_le': '2026-10-21T08:00:00+00:00',
+      'annulable': true,
+      'annule_le': null,
+    };
+
+http.Response _json(Object body, [int status = 200]) =>
+    http.Response(jsonEncode(body), status, headers: {'content-type': 'application/json; charset=utf-8'});
+
+void main() {
+  group('lecture', () {
+    test('une tâche pensée faite : sa nature et la tâche visée ; les autres types n’en ont pas', () {
+      final relecture = Relecture.fromJson({
+        'propositions': [
+          _faite('p-1', 't-1'),
+          _faite('p-2', 't-2', nature: 'passee'),
+          {'id': 'p-3', 'type': 'orthographe'},
+          {
+            'id': 'p-4',
+            'type': 'tache_terminee',
+            'cibles': [
+              {'type': 'conversation', 'id': 'c-9'}
+            ]
+          },
+        ],
+      });
+      final [p1, p2, p3, p4] = relecture.propositions;
+      expect(p1.tacheTerminee, isTrue);
+      expect(p1.nature, relectureNatureFaite);
+      expect(p1.tache?.id, 't-1');
+      expect(p1.tache?.titre, 'Tâche t-1');
+      expect(p1.extraits.first.texte, 'c’est envoyé');
+      expect(p2.nature, relectureNaturePassee);
+      expect(p3.tacheTerminee, isFalse);
+      expect(p3.nature, isNull);
+      expect(p3.tache, isNull);
+      expect(p4.tacheTerminee, isTrue);
+      expect(p4.tache, isNull, reason: 'sans cible tâche : rien à marquer dans l’onglet Tâches');
+    });
+
+    test('réponse de validation : changement groupé, compteurs, refusées ; tolérante', () {
+      final full = RelectureValidation.parse({
+        'changement': _groupe('g-1'),
+        'acceptees': 12,
+        'ignorees': 2,
+        'refusees': [
+          {'id': 'p-9', 'raison': 'La tâche a été supprimée.'},
+          {'raison': 'sans id'},
+          {'id': 'p-9', 'raison': 'en double'},
+        ],
+        'inconnu': true,
+      });
+      expect(full.changement?.id, 'g-1');
+      expect(full.changement?.peutAnnuler, isTrue);
+      expect(full.acceptees, 12);
+      expect(full.ignorees, 2);
+      expect(full.refusees.map((r) => (r.id, r.raison)), [('p-9', 'La tâche a été supprimée.')]);
+
+      final sansChangement = RelectureValidation.parse({'changement': null, 'acceptees': 0, 'ignorees': 3});
+      expect(sansChangement.changement, isNull);
+      expect(sansChangement.acceptees, 0);
+      expect(sansChangement.refusees, isEmpty);
+
+      final illisible = RelectureValidation.parse('pas un objet');
+      expect(illisible.changement, isNull);
+      expect(illisible.acceptees, isNull);
+      expect(RelectureValidation.parse({'acceptees': '12', 'refusees': 'non'}).acceptees, isNull);
+    });
+  });
+
+  group('API', () {
+    late List<http.Request> requests;
+    late http.Response Function(http.Request) answer;
+
+    RelectureApi api() => RelectureApi(
+          baseUrl: 'https://example.invalid/',
+          send: (request) async {
+            final sent = http.Request(request.method, Uri.parse(request.url))..body = request.body;
+            requests.add(sent);
+            return answer(sent);
+          },
+        );
+
+    setUp(() {
+      requests = [];
+      answer = (_) => _json({'changement': _groupe('g-1'), 'acceptees': 1, 'ignorees': 1, 'refusees': []});
+    });
+
+    test('valider : POST …/taches-faites/valider, corps exact {accepter, ignorer}', () async {
+      final outcome = await api().validateTachesFaites(accept: ['p-1', 'p-3'], ignore: ['p-2']);
+      final request = requests.single;
+      expect(request.method, 'POST');
+      expect(request.url.toString(), 'https://example.invalid/v1/clone/relecture/taches-faites/valider');
+      expect(jsonDecode(request.body), {
+        'accepter': ['p-1', 'p-3'],
+        'ignorer': ['p-2'],
+      });
+      final data = (outcome as RelectureDone<RelectureValidation>).data;
+      expect(data.changement?.id, 'g-1');
+      expect(data.acceptees, 1);
+
+      // Les autres gestes envoient toujours {}.
+      answer = (_) => _json({'ok': true});
+      await api().ignore('p-5');
+      expect(requests.last.body, '{}');
+    });
+
+    test('valider : 400 (trop d’ids), 409 (message du serveur), panne et 200 illisible restent distincts', () async {
+      answer = (_) => _json({'detail': 'Trop de propositions d’un coup (300 au plus).'}, 400);
+      final tooMany = await api().validateTachesFaites(accept: ['p-1'], ignore: []);
+      final problem = (tooMany as RelectureFailed).problem;
+      expect(problem.kind, ApiProblemKind.rejected);
+      expect(problem.statusCode, 400);
+
+      answer = (_) => _json({'detail': 'Déjà validées.'}, 409);
+      expect((await api().validateTachesFaites(accept: ['p-1'], ignore: []) as RelectureConflict).detail,
+          'Déjà validées.');
+
+      answer = (_) => _json({'detail': 'boom'}, 502);
+      expect((await api().validateTachesFaites(accept: ['p-1'], ignore: []) as RelectureFailed).problem.kind,
+          ApiProblemKind.server);
+
+      answer = (_) => http.Response('ok', 200);
+      final done = await api().validateTachesFaites(accept: ['p-1'], ignore: []);
+      expect((done as RelectureDone<RelectureValidation>).data.acceptees, isNull);
+    });
+  });
+
+  group('état partagé', () {
+    test(
+        'tâche → proposition ; valider retire les traitées (pas les refusées), ajoute le groupe, relit ; un seul envoi',
+        () async {
+      final hold = Completer<void>();
+      var posts = 0;
+      var reads = 0;
+      final controller = RelectureController(
+        api: RelectureApi(
+          baseUrl: 'https://example.invalid/',
+          send: (request) async {
+            if (request.method == 'GET') {
+              reads++;
+              return _json({
+                'propositions': [
+                  if (posts == 0) ...[_faite('p-1', 't-1'), _faite('p-2', 't-2', nature: 'passee')],
+                  _faite('p-3', 't-3'),
+                  {'id': 'p-4', 'type': 'orthographe'},
+                ],
+              });
+            }
+            posts++;
+            await hold.future;
+            return _json({
+              'changement': _groupe('g-1'),
+              'acceptees': 1,
+              'ignorees': 1,
+              'refusees': [
+                {'id': 'p-3', 'raison': 'La tâche a été supprimée.'}
+              ],
+            });
+          },
+        ),
+      );
+      addTearDown(controller.dispose);
+      await controller.load();
+      expect(controller.tachesFaites.map((p) => p.id), ['p-1', 'p-2', 'p-3']);
+      expect(controller.tachesFaitesParTache.keys, unorderedEquals(['t-1', 't-2', 't-3']));
+      expect(controller.tachesFaitesParTache['t-2']?.id, 'p-2');
+
+      final first = controller.validateTachesFaites(accept: ['p-1', 'p-3'], ignore: ['p-2']);
+      expect(controller.validating, isTrue);
+      expect(await controller.validateTachesFaites(accept: ['p-1'], ignore: []), isNull);
+      hold.complete();
+      final outcome = await first;
+      expect(outcome, isA<RelectureDone<RelectureValidation>>());
+      expect(posts, 1);
+      expect(controller.validating, isFalse);
+      // p-3 refusée : elle reste ; la relecture relue le confirme.
+      expect(controller.tachesFaites.map((p) => p.id), ['p-3']);
+      expect(controller.changements.first.id, 'g-1');
+      await controller.load();
+      expect(reads, 2);
+      expect(controller.propositions.map((p) => p.id), ['p-3', 'p-4']);
+    });
+
+    test('panne : rien n’est retiré, la liste est relue', () async {
+      var reads = 0;
+      final controller = RelectureController(
+        api: RelectureApi(
+          baseUrl: 'https://example.invalid/',
+          send: (request) async {
+            if (request.method == 'GET') {
+              reads++;
+              return _json({
+                'propositions': [_faite('p-1', 't-1')],
+              });
+            }
+            return _json({'detail': 'boom'}, 500);
+          },
+        ),
+      );
+      addTearDown(controller.dispose);
+      await controller.load();
+      final outcome = await controller.validateTachesFaites(accept: ['p-1'], ignore: []);
+      expect((outcome as RelectureFailed).problem.kind, ApiProblemKind.server);
+      expect(controller.tachesFaites.single.id, 'p-1');
+      await controller.load();
+      expect(reads, 2, reason: 'relue après la panne');
+    });
+  });
+}
