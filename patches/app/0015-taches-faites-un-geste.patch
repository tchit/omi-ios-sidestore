+// Clone local : tâches pensées faites, validées d'un seul geste (0015). Onglet Tâches : la tâche reste à sa place,
+// cochée par Omi sans être cachée (marque distincte par la forme + « Omi : faite ? »), la barre « Omi pense que
+// … · Vérifier » (cachée sans proposition), cocher soi-même reste immédiat. Feuille : tout pré-coché, décocher,
+// tout cocher / décocher, Valider (n) → corps exact, « n tâches cochées » + Annuler (le changement groupé), refusées,
+// panne, jamais deux envois. « À vérifier » : une seule carte pour les tâches pensées faites. Anglais.
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:provider/provider.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+import 'package:omi/backend/http/api/insights.dart';
+import 'package:omi/backend/http/api/relecture.dart';
+import 'package:omi/backend/http/api_result.dart';
+import 'package:omi/backend/preferences.dart';
+import 'package:omi/backend/schema/schema.dart';
+import 'package:omi/env/env.dart';
+import 'package:omi/l10n/app_localizations.dart';
+import 'package:omi/pages/action_items/action_items_page.dart';
+import 'package:omi/pages/action_items/widgets/task_row_parts.dart';
+import 'package:omi/pages/insights/insights_page.dart';
+import 'package:omi/pages/insights/relecture_controller.dart';
+import 'package:omi/pages/insights/taches_faites.dart';
+import 'package:omi/providers/action_items_provider.dart';
+import 'package:omi/providers/goals_provider.dart';
+import 'package:omi/providers/task_integration_provider.dart';
+import 'package:omi/ui/ui.dart';
+import 'package:omi/utils/platform/platform_manager.dart';
+
+Map<String, dynamic> _faite(String id, String tache, String titre) => {
+      'id': id,
+      'type': 'tache_terminee',
+      'nature': 'faite',
+      'titre': 'Tâche faite',
+      'extraits': [
+        {'texte': 'le devis est parti ce matin', 'source': 'Réunion du 20 oct.', 'conversation_id': 'c-1'},
+      ],
+      'cibles': [
+        {'type': 'tache', 'id': tache, 'titre': titre},
+      ],
+    };
+
+Map<String, dynamic> _passee(String id, String tache, String titre) => {
+      'id': id,
+      'type': 'tache_terminee',
+      'nature': 'passee',
+      'titre': 'Moment passé',
+      'explication': 'Le rendez-vous était hier à 10 h.',
+      'cibles': [
+        {'type': 'tache', 'id': tache, 'titre': titre},
+      ],
+    };
+
+Map<String, dynamic> _orthographe() => {
+      'id': 'p-o',
+      'type': 'orthographe',
+      'titre': 'Arnaud, pas Arnault',
+      'avant': 'Arnault',
+      'apres': 'Arnaud',
+    };
+
+/// Un faux serveur du clone : la relecture (lecture, validation groupée, annulation) et Insights (vide).
+class _Server {
+  final requests = <ApiRequest>[];
+  List<Map<String, dynamic>> propositions = [
+    _faite('p-1', 't-1', 'Envoyer le devis'),
+    _passee('p-2', 't-2', 'Rendez-vous chez le dentiste'),
+  ];
+  List<Map<String, dynamic>> changements = [];
+  int validateStatus = 200;
+  List<Map<String, dynamic>> refusees = [];
+  Completer<void>? hold;
+
+  static http.Response _json(Object body, [int status = 200]) =>
+      http.Response(jsonEncode(body), status, headers: {'content-type': 'application/json; charset=utf-8'});
+
+  int count(String method, String path) =>
+      requests.where((r) => r.method == method && Uri.parse(r.url).path == path).length;
+
+  Map<String, dynamic> lastBody(String path) =>
+      jsonDecode(requests.lastWhere((r) => Uri.parse(r.url).path == path).body) as Map<String, dynamic>;
+
+  Future<http.Response> send(ApiRequest request) async {
+    requests.add(request);
+    final segments = Uri.parse(request.url).pathSegments;
+    if (segments[1] == 'insights') {
+      return switch (segments[2]) {
+        'maintenant' => _json({'lignes': [], 'resume': null, 'maj': null, 'version': 0}),
+        'bilans' => _json({'bilans': []}),
+        _ => _json({'dossiers': []}),
+      };
+    }
+    if (segments.length == 3) {
+      return _json({'propositions': propositions, 'changements': changements, 'derniere_relecture': null});
+    }
+    final hold = this.hold;
+    if (hold != null) await hold.future;
+    if (segments[3] == 'taches-faites') {
+      if (validateStatus != 200) return _json({'detail': 'boom'}, validateStatus);
+      final body = jsonDecode(request.body) as Map<String, dynamic>;
+      final accept = (body['accepter'] as List).cast<String>();
+      final ignore = (body['ignorer'] as List).cast<String>();
+      final refused = {for (final r in refusees) r['id']};
+      propositions =
+          propositions.where((p) => refused.contains(p['id']) || !{...accept, ...ignore}.contains(p['id'])).toList();
+      final accepted = accept.where((id) => !refused.contains(id)).length;
+      final changement = accepted == 0
+          ? null
+          : {
+              'id': 'g-1',
+              'type': 'tache_terminee',
+              'titre': '$accepted tâches cochées d’un coup',
+              'details': [],
+              'fait_le': '2026-10-21T08:00:00+00:00',
+              'annulable': true,
+              'annule_le': null,
+            };
+      if (changement != null) changements = [changement, ...changements];
+      return _json({'changement': changement, 'acceptees': accepted, 'ignorees': ignore.length, 'refusees': refusees});
+    }
+    // …/changements/{id}/annuler
+    final index = changements.indexWhere((c) => c['id'] == segments[4]);
+    changements[index] = {...changements[index], 'annulable': false, 'annule_le': '2026-10-21T08:05:00+00:00'};
+    return _json({'changement': changements[index]});
+  }
+}
