+  static RelectureValidation parse(Object? json) {
+    if (json is! Map) return const RelectureValidation();
+    int? count(Object? value) => value is num && value >= 0 ? value.toInt() : null;
+    return RelectureValidation(
+      changement: RelectureChangement.tryParseEnvelope(json),
+      acceptees: count(json['acceptees']),
+      ignorees: count(json['ignorees']),
+      refusees: uniqueById(_list(json['refusees'], RelectureRefus.tryParse), (refus) => refus.id),
     );
   }
