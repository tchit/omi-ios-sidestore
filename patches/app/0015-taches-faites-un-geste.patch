+import 'dart:async';
+
+import 'package:flutter/material.dart';
+
+import 'package:provider/provider.dart';
+
+import 'package:omi/backend/http/api/relecture.dart';
+import 'package:omi/backend/http/api_result.dart';
+import 'package:omi/backend/schema/relecture.dart';
+import 'package:omi/l10n/app_localizations.dart';
+import 'package:omi/pages/action_items/widgets/task_row_parts.dart';
+import 'package:omi/pages/insights/relecture_controller.dart';
+import 'package:omi/pages/insights/relecture_widgets.dart';
+import 'package:omi/providers/action_items_provider.dart';
+import 'package:omi/ui/ui.dart';
+import 'package:omi/utils/l10n_extensions.dart';
+
+/// Clone local (0015) : les tâches qu'Omi pense faites (relecture de nuit, `tache_terminee`). Elles restent dans
+/// l'onglet Tâches, à leur place, « cochées sans être cachées » ; Mike les valide d'un seul geste dans une feuille où
+/// elles sont toutes pré-cochées : les cochées sont marquées faites, les décochées restent à faire (Omi ne les
+/// reproposera pas pour les mêmes raisons). Le tout fait UN changement, annulable d'un coup.
+
+/// Ce qu'on lit d'une tâche pensée faite : sa description (le titre de la tâche visée, sinon celui de la
+/// proposition).
+String tacheFaiteDescription(RelectureProposition proposition) =>
+    proposition.tache?.titre ?? proposition.titre ?? proposition.explication ?? '';
+
+/// La nature, en un mot : « Faite », « Moment passé », sinon « Semble faite ».
+String tacheFaiteNatureLabel(AppLocalizations l10n, String? nature) => switch (nature) {
+      relectureNatureFaite => l10n.tachesFaitesNatureDone,
+      relectureNaturePassee => l10n.tachesFaitesNaturePast,
+      _ => l10n.tachesFaitesNatureOther,
+    };
+
+/// La petite mention sous une tâche de l'onglet Tâches : « Omi : faite ? », « Omi : moment passé ? ».
+String tacheFaiteMention(AppLocalizations l10n, String? nature) =>
+    nature == relectureNaturePassee ? l10n.tachesFaitesMentionPast : l10n.tachesFaitesMentionDone;
+
+IconData tacheFaiteNatureIcon(String? nature) =>
+    nature == relectureNaturePassee ? Icons.schedule_rounded : Icons.format_quote_rounded;
+
+/// Ouvre la feuille de validation, centrée sur [focusId] s'il est donné. Validée : barre « 12 tâches cochées » avec
+/// « Annuler » (le changement groupé), la liste des tâches et la relecture relues.
+Future<void> showTachesFaitesSheet(BuildContext context, RelectureController controller, {String? focusId}) async {
+  OmiHaptics.selection();
+  final appContext = Navigator.of(context, rootNavigator: true).context;
+  final tasks = Provider.of<ActionItemsProvider?>(context, listen: false);
+  final result = await showOmiSheet<RelectureValidation>(
+    context: context,
+    title: context.l10n.tachesFaitesSheetTitle,
+    padding: EdgeInsets.zero,
+    builder: (_) => TachesFaitesSheet(controller: controller, focusId: focusId),
+  );
+  if (result == null) return;
+  unawaited(tasks?.forceRefreshActionItems());
+  final feedback = context.mounted ? context : appContext;
+  if (!feedback.mounted) return;
+  final l10n = feedback.l10n;
+  final checked = result.acceptees;
+  final message = [
+    checked == null ? l10n.relectureDone : l10n.tachesFaitesChecked(checked),
+    if (result.refusees.isNotEmpty) l10n.tachesFaitesRefused(result.refusees.length),
+  ].join(' · ');
+  final changement = result.changement;
+  OmiHaptics.success();
+  if (changement != null && changement.peutAnnuler) {
+    unawaited(OmiFeedback.undo(
+      feedback,
+      message,
+      icon: Icons.check_rounded,
+      onUndo: () => unawaited(_undo(appContext, controller, changement, tasks)),
+    ));
+  } else {
+    relectureConfirm(feedback, message);
+  }
+}
+
+/// « Annuler » de la barre : remet les tâches comme avant (le changement groupé), puis relit les tâches.
+Future<void> _undo(
+  BuildContext appContext,
+  RelectureController controller,
+  RelectureChangement changement,
+  ActionItemsProvider? tasks,
+) async {
+  final outcome = await controller.undo(changement);
+  if (outcome == null) return;
+  unawaited(tasks?.forceRefreshActionItems());
+  if (appContext.mounted) showRelectureUndoOutcome(appContext, outcome);
+}
+
+/// La feuille : toutes les tâches pensées faites, CHACUNE PRÉ-COCHÉE, avec leur nature (« Faite » et la citation
+/// qui le montre, ou « Moment passé » et l'explication) ; « Tout cocher / Tout décocher » ; « Valider (n) ».
+/// Validée, elle se ferme en rendant la réponse du serveur ; un refus ou une panne se dit dans la feuille (la liste
+/// est relue, les choix restent).
+class TachesFaitesSheet extends StatefulWidget {
+  const TachesFaitesSheet({super.key, required this.controller, this.focusId});
+
+  final RelectureController controller;
+  final String? focusId;
+
+  @override
+  State<TachesFaitesSheet> createState() => _TachesFaitesSheetState();
+}
+
+class _TachesFaitesSheetState extends State<TachesFaitesSheet> {
+  /// Les propositions décochées (toutes sont cochées d'avance).
+  final Set<String> _unchecked = {};
+  final GlobalKey _focusKey = GlobalKey();
+  String? _error;
+
+  RelectureController get _controller => widget.controller;
+
+  @override
+  void initState() {
+    super.initState();
+    if (widget.focusId != null) {
+      WidgetsBinding.instance.addPostFrameCallback((_) {
+        final target = _focusKey.currentContext;
+        if (target != null && target.mounted) {
+          unawaited(Scrollable.ensureVisible(target, alignment: 0.5, duration: Duration.zero));
+        }
+      });
+    }
+  }
+
+  void _toggle(String id) {
+    if (_controller.validating) return;
+    OmiHaptics.selection();
+    setState(() => _unchecked.contains(id) ? _unchecked.remove(id) : _unchecked.add(id));
+  }
+
+  void _setAll(List<RelectureProposition> items, {required bool checked}) {
+    if (_controller.validating) return;
+    OmiHaptics.selection();
+    setState(() => checked ? _unchecked.clear() : _unchecked.addAll(items.map((p) => p.id)));
+  }
+
+  Future<void> _validate(List<RelectureProposition> items) async {
+    final accept = [
+      for (final p in items)
+        if (!_unchecked.contains(p.id)) p.id
+    ];
+    final ignore = [
+      for (final p in items)
+        if (_unchecked.contains(p.id)) p.id
+    ];
+    setState(() => _error = null);
+    final outcome = await _controller.validateTachesFaites(accept: accept, ignore: ignore);
+    if (outcome == null || !mounted) return;
+    final l10n = context.l10n;
+    switch (outcome) {
+      case RelectureDone(:final data):
+        Navigator.of(context).pop(data);
+      case RelectureConflict(:final detail):
+        setState(() => _error = detail ?? l10n.relectureConflict);
+      case RelectureFailed(:final problem) when problem.kind == ApiProblemKind.notFound:
+        setState(() => _error = l10n.relecturePropositionGone);
+      case RelectureFailed():
+        setState(() => _error = l10n.relectureActionFailed);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return ListenableBuilder(
+      listenable: _controller,
+      builder: (context, _) {
+        final l10n = context.l10n;
+        final items = _controller.tachesFaites;
+        final busy = _controller.validating;
+        final checkedCount = items.where((p) => !_unchecked.contains(p.id)).length;
+        final allChecked = checkedCount == items.length;
+        final error = _error;
+        return Column(
+          mainAxisSize: MainAxisSize.min,
+          crossAxisAlignment: CrossAxisAlignment.stretch,
+          children: [
+            Padding(
+              padding: const EdgeInsets.fromLTRB(OmiSpacing.md, OmiSpacing.xxs, OmiSpacing.md, OmiSpacing.xs),
+              child: Text(
+                items.isEmpty ? l10n.relectureAllDoneMessage : l10n.tachesFaitesSheetIntro,
+                style: OmiType.subhead.copyWith(color: OmiColors.textTertiary),
+              ),
+            ),
+            if (items.isNotEmpty) ...[
+              Padding(
+                padding: const EdgeInsets.symmetric(horizontal: OmiSpacing.xxs),
+                child: Align(
+                  alignment: Alignment.centerLeft,
+                  child: OmiButton.tertiary(
+                    key: const ValueKey('taches_faites_all'),
+                    label: allChecked ? l10n.tachesFaitesUncheckAll : l10n.tachesFaitesCheckAll,
+                    icon: allChecked ? Icons.remove_done_rounded : Icons.done_all_rounded,
+                    size: OmiButtonSize.compact,
+                    onPressed: busy ? null : () => _setAll(items, checked: !allChecked),
+                  ),
+                ),
+              ),
+              Flexible(
+                child: SingleChildScrollView(
+                  key: const ValueKey('taches_faites_list'),
+                  padding: const EdgeInsets.symmetric(horizontal: OmiSpacing.xs),
+                  child: Column(
+                    crossAxisAlignment: CrossAxisAlignment.stretch,
+                    children: [
+                      for (final p in items)
+                        KeyedSubtree(
+                          key: p.id == widget.focusId ? _focusKey : null,
+                          child: TacheFaiteRow(
+                            key: ValueKey('taches_faites_row_${p.id}'),
+                            proposition: p,
+                            checked: !_unchecked.contains(p.id),
+                            focused: p.id == widget.focusId,
+                            onToggle: () => _toggle(p.id),
+                          ),
+                        ),
+                    ],
+                  ),
+                ),
+              ),
+            ],
+            Padding(
+              padding: const EdgeInsets.fromLTRB(OmiSpacing.md, OmiSpacing.sm, OmiSpacing.md, OmiSpacing.md),
+              child: Column(
+                crossAxisAlignment: CrossAxisAlignment.stretch,
+                children: [
+                  if (error != null) ...[
+                    Row(
+                      key: const ValueKey('taches_faites_error'),
+                      crossAxisAlignment: CrossAxisAlignment.start,
+                      children: [
+                        ExcludeSemantics(
+                          child: Icon(Icons.info_outline_rounded, size: 18, color: OmiColors.textTertiary),
+                        ),
+                        const SizedBox(width: OmiSpacing.xs),
+                        Expanded(child: Semantics(liveRegion: true, child: Text(error, style: OmiType.subhead))),
+                      ],
+                    ),
+                    const SizedBox(height: OmiSpacing.sm),
+                  ],
+                  if (items.isNotEmpty) ...[
+                    Text(l10n.tachesFaitesUncheckedNote,
+                        style: OmiType.footnote.copyWith(color: OmiColors.textTertiary)),
+                    const SizedBox(height: OmiSpacing.sm),
+                    OmiButton(
+                      key: const ValueKey('taches_faites_validate'),
+                      label: l10n.tachesFaitesValidate(checkedCount),
+                      expand: true,
+                      isLoading: busy,
+                      onPressed: () => _validate(items),
+                    ),
+                  ],
+                ],
+              ),
+            ),
+          ],
+        );
+      },
+    );
+  }
+}
+
+/// Une tâche de la feuille : sa case (carrée, pleine et cochée / vide : la forme dit l'état, jamais la couleur),
+/// sa description, sa nature et ce qui la justifie. Toucher la ligne coche ou décoche.
+class TacheFaiteRow extends StatelessWidget {
+  const TacheFaiteRow({
+    super.key,
+    required this.proposition,
+    required this.checked,
+    required this.onToggle,
+    this.focused = false,
+  });
+
+  final RelectureProposition proposition;
+  final bool checked;
+  final bool focused;
+  final VoidCallback onToggle;
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = context.l10n;
+    final p = proposition;
+    final quote = p.nature == relectureNaturePassee ? null : p.extraits.firstOrNull;
+    final explanation = p.nature == relectureNatureFaite && quote != null ? null : p.explication;
+    final source = quote?.source;
+    return MergeSemantics(
+      child: Semantics(
+        checked: checked,
+        child: Material(
+          color: focused ? OmiColors.surface2 : Colors.transparent,
+          borderRadius: OmiRadius.mdAll,
+          child: InkWell(
+            borderRadius: OmiRadius.mdAll,
+            onTap: onToggle,
+            child: Padding(
+              padding: const EdgeInsets.fromLTRB(OmiSpacing.xs, OmiSpacing.sm, OmiSpacing.sm, OmiSpacing.sm),
+              child: Row(
+                crossAxisAlignment: CrossAxisAlignment.start,
+                children: [
+                  SizedBox(
+                    width: 36,
+                    child: Padding(
+                      padding: const EdgeInsets.only(top: 1),
+                      // Centrée : la colonne de 36 pt ne doit pas étirer la case (carrée, 24 pt).
+                      child: Align(
+                        alignment: Alignment.topCenter,
+                        child: TacheFaiteCheckbox(key: ValueKey('taches_faites_check_${p.id}'), checked: checked),
+                      ),
+                    ),
+                  ),
+                  const SizedBox(width: OmiSpacing.xs),
+                  Expanded(
+                    child: Column(
+                      crossAxisAlignment: CrossAxisAlignment.start,
+                      children: [
+                        Text(tacheFaiteDescription(p), style: OmiType.callout.copyWith(fontWeight: FontWeight.w500)),
+                        const SizedBox(height: 2),
+                        Row(
+                          children: [
+                            ExcludeSemantics(
+                              child: Icon(tacheFaiteNatureIcon(p.nature), size: 14, color: OmiColors.textTertiary),
+                            ),
+                            const SizedBox(width: 4),
+                            Text(
+                              tacheFaiteNatureLabel(l10n, p.nature),
+                              key: ValueKey('taches_faites_nature_${p.id}'),
+                              style:
+                                  OmiType.footnote.copyWith(color: OmiColors.textTertiary, fontWeight: FontWeight.w600),
+                            ),
+                          ],
+                        ),
+                        if (quote != null) ...[
+                          const SizedBox(height: 2),
+                          Text(quote.texte, style: OmiType.footnote.copyWith(fontStyle: FontStyle.italic)),
+                          if (source != null)
+                            Text('— $source', style: OmiType.footnote.copyWith(color: OmiColors.textTertiary)),
+                        ],
+                        if (explanation != null) ...[
+                          const SizedBox(height: 2),
+                          Text(explanation, style: OmiType.footnote.copyWith(color: OmiColors.textTertiary)),
+                        ],
+                      ],
+                    ),
+                  ),
+                ],
+              ),
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+/// La case d'une tâche de la feuille : carré plein avec une coche (cochée) ou carré vide (décochée).
+class TacheFaiteCheckbox extends StatelessWidget {
+  const TacheFaiteCheckbox({super.key, required this.checked});
+
+  final bool checked;
+
+  @override
+  Widget build(BuildContext context) {
+    return AnimatedContainer(
+      duration: OmiMotion.of(context).quick,
+      width: 24,
+      height: 24,
+      decoration: BoxDecoration(
+        borderRadius: const BorderRadius.all(Radius.circular(6)),
+        border: Border.all(color: checked ? OmiColors.accent : OmiColors.textTertiary, width: 2),
+        color: checked ? OmiColors.accent : Colors.transparent,
+      ),
+      child: checked ? Icon(Icons.check_rounded, size: 16, color: OmiColors.onAccent) : null,
+    );
+  }
+}
+
+/// En haut de l'onglet Tâches : « Omi pense que 14 tâches sont faites · Vérifier » ; cachée s'il n'y en a pas.
+class TachesFaitesBar extends StatelessWidget {
+  const TachesFaitesBar({super.key, required this.count, required this.onReview});
+
+  final int count;
+  final VoidCallback onReview;
+
+  @override
+  Widget build(BuildContext context) {
+    if (count == 0) return const SizedBox.shrink();
+    final l10n = context.l10n;
+    return Semantics(
+      button: true,
+      child: Material(
+        key: const ValueKey('taches_faites_bar'),
+        color: OmiColors.surface1,
+        borderRadius: OmiRadius.mdAll,
+        clipBehavior: Clip.antiAlias,
+        child: InkWell(
+          onTap: onReview,
+          child: ConstrainedBox(
+            constraints: const BoxConstraints(minHeight: 52),
+            child: Padding(
+              padding: const EdgeInsets.symmetric(horizontal: OmiSpacing.md, vertical: OmiSpacing.xs),
+              child: Row(
+                children: [
+                  const ExcludeSemantics(child: TaskOmiDoneMark(size: 20)),
+                  const SizedBox(width: OmiSpacing.sm),
+                  Expanded(child: Text(l10n.tachesFaitesBar(count), style: OmiType.subhead)),
