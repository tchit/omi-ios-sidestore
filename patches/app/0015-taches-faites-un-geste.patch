+class _LoadedTaskIntegrationProvider extends TaskIntegrationProvider {
+  @override
+  bool get hasLoaded => true;
+}
+
+class _Tasks {
+  var fetches = 0;
+  final completions = <String, bool>{};
+  final items = const [
+    ActionItemWithMetadata(id: 't-1', description: 'Envoyer le devis', completed: false, sortOrder: 1000),
+    ActionItemWithMetadata(id: 't-2', description: 'Rendez-vous chez le dentiste', completed: false, sortOrder: 2000),
+    ActionItemWithMetadata(id: 't-3', description: 'Acheter du pain', completed: false, sortOrder: 3000),
+  ];
+
+  Future<ActionItemsResponse?> fetch({
+    int limit = 100,
+    int offset = 0,
+    bool? completed,
+    String? conversationId,
+    DateTime? startDate,
+    DateTime? endDate,
+    DateTime? dueStartDate,
+    DateTime? dueEndDate,
+  }) async {
+    fetches++;
+    return ActionItemsResponse(actionItems: items);
+  }
+}
