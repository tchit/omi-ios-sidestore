+          extrait: {'texte': 'on a fait la radio du doigt', 'source': 'Appel du 20 oct.', 'conversation_id': 'c-1'}),
+      _auto('ch-2', 't-b', 'Ravito de Pascal', 'Fait vendredi.'),
+    ];
