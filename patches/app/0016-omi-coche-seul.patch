+class _Tasks {
+  _Tasks(this.items);
+
+  List<ActionItemWithMetadata> items;
+  var fetches = 0;
+
+  Future<ActionItemsResponse?> fetch({
+    int limit = 100,
+    int offset = 0,
+    bool? completed,
+    String? conversationId,
+    DateTime? startDate,
+    DateTime? endDate,
+    DateTime? dueStartDate,
+    DateTime? dueEndDate,
+  }) async {
+    fetches++;
+    return ActionItemsResponse(actionItems: items);
+  }
+}
