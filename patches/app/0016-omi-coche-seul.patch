+http.Response _json(Object body, [int status = 200]) =>
+    http.Response(jsonEncode(body), status, headers: {'content-type': 'application/json; charset=utf-8'});
+
+/// Un faux serveur qui retient l'ordre des gestes et peut faire échouer une étape.
+class _Server {
+  final calls = <String>[];
+  final bodies = <String, Object?>{};
+  final failing = <String>{};
+  List<Map<String, dynamic>> autos = [
+    _auto('ch-1', 't-a',
+        extrait: {'texte': 'on a fait la radio', 'source': 'Appel du 20 oct.', 'conversation_id': 'c-1'}),
+    _auto('ch-2', 't-b'),
+  ];
+  List<Map<String, dynamic>> propositions = [_faite('p-1', 't-1'), _faite('p-2', 't-2')];
+
+  Future<http.Response> send(ApiRequest request) async {
+    final path = Uri.parse(request.url).path;
+    if (request.method == 'GET') {
+      return _json({'propositions': propositions, 'changements': [], 'cochees_auto': autos});
+    }
+    final step = path.split('/').sublist(4).join('/');
+    calls.add(step);
+    bodies[step] = jsonDecode(request.body);
+    if (failing.contains(step)) return _json({'detail': 'boom'}, 500);
+    switch (step) {
+      case 'taches/decocher':
+        final ids = ((bodies[step] as Map)['taches'] as List).cast<String>();
+        return _json({'decochees': ids, 'introuvables': []});
+      case 'taches-faites/valider':
+        final body = bodies[step] as Map;
+        final handled = {...(body['accepter'] as List), ...(body['ignorer'] as List)};
+        propositions = propositions.where((p) => !handled.contains(p['id'])).toList();
+        return _json(
+            {'changement': null, 'acceptees': (body['accepter'] as List).length, 'ignorees': 0, 'refusees': []});
+      case 'cochees-auto/vu':
+        final seen = ((bodies[step] as Map)['changements'] as List).toSet();
+        autos = autos.where((a) => !seen.contains(a['changement_id'])).toList();
+        return _json({'ok': true});
+    }
+    return _json({'detail': 'Not Found'}, 404);
+  }
+}
