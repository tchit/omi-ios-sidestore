+    getActionItems: tasks.fetch,
+    updateActionItemRequest: (id, {description, completed, dueAt}) async =>
+        ActionItemWithMetadata(id: id, description: id, completed: completed ?? false),
+  );
+  addTearDown(provider.dispose);
+  final relecture = RelectureController(api: RelectureApi(baseUrl: 'https://example.invalid/', send: server.send));
+  addTearDown(relecture.dispose);
