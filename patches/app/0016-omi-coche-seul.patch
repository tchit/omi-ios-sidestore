+/// Faux serveur du clone : la relecture (cochées par Omi, suggestions, décocher, valider, vu) et Insights (vide).
+class _Server {
+  final requests = <ApiRequest>[];
+  List<Map<String, dynamic>> autos = _defaultAutos();
+  List<Map<String, dynamic>> propositions = [];
+  final failing = <String>{};
+
+  static http.Response _json(Object body, [int status = 200]) =>
+      http.Response(jsonEncode(body), status, headers: {'content-type': 'application/json; charset=utf-8'});
+
+  /// Les gestes envoyés, dans l'ordre (« taches/decocher », « taches-faites/valider », « cochees-auto/vu »).
+  List<String> get steps => [
+        for (final r in requests)
+          if (r.method == 'POST') Uri.parse(r.url).pathSegments.sublist(3).join('/')
+      ];
+
+  Object? body(String step) => jsonDecode(
+      requests.lastWhere((r) => r.method == 'POST' && Uri.parse(r.url).pathSegments.sublist(3).join('/') == step).body);
+
+  Future<http.Response> send(ApiRequest request) async {
+    requests.add(request);
+    final segments = Uri.parse(request.url).pathSegments;
+    if (segments[1] == 'insights') {
+      return switch (segments[2]) {
+        'maintenant' => _json({'lignes': [], 'resume': null, 'maj': null, 'version': 0}),
+        'bilans' => _json({'bilans': []}),
+        _ => _json({'dossiers': []}),
+      };
+    }
+    if (request.method == 'GET') {
+      return _json({'propositions': propositions, 'changements': [], 'cochees_auto': autos});
+    }
+    final step = segments.sublist(3).join('/');
+    if (failing.contains(step)) return _json({'detail': 'boom'}, 500);
+    final body = jsonDecode(request.body) as Map<String, dynamic>;
+    switch (step) {
+      case 'taches/decocher':
+        return _json({'decochees': body['taches'], 'introuvables': []});
+      case 'taches-faites/valider':
+        final handled = {...(body['accepter'] as List), ...(body['ignorer'] as List)};
+        propositions = propositions.where((p) => !handled.contains(p['id'])).toList();
+        return _json({
+          'changement': null,
+          'acceptees': (body['accepter'] as List).length,
+          'ignorees': (body['ignorer'] as List).length,
+          'refusees': []
+        });
+      case 'cochees-auto/vu':
+        final seen = (body['changements'] as List).toSet();
+        autos = autos.where((a) => !seen.contains(a['changement_id'])).toList();
+        return _json({'ok': true});
+    }
+    return _json({'detail': 'Not Found'}, 404);
+  }
+}
