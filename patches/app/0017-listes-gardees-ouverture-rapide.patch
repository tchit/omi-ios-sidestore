diff --git a/app/test/perf/detail_can_display_seconds_test.dart b/app/test/perf/detail_can_display_seconds_test.dart
new file mode 100644
index 0000000000..0e53066324
--- /dev/null
+++ b/app/test/perf/detail_can_display_seconds_test.dart
@@ -0,0 +1,46 @@
+import 'dart:math';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:omi/backend/schema/transcript_segment.dart';
+
+// The pairwise definition canDisplaySeconds replaced (O(n²) on detail open).
+bool _pairwise(List<TranscriptSegment> s) {
+  for (var i = 0; i < s.length; i++) {
+    for (var j = i + 1; j < s.length; j++) {
+      if (s[i].start > s[j].end || s[i].end > s[j].start) return false;
+    }
+  }
+  return true;
+}
+
+TranscriptSegment _segment(int i, double start, double end) => TranscriptSegment(
+      id: 's$i',
+      text: 'line $i',
+      speaker: 'SPEAKER_00',
+      isUser: false,
+      personId: null,
+      start: start,
+      end: end,
+      translations: const [],
+    );
+
+void main() {
+  test('one-pass canDisplaySeconds matches the pairwise definition', () {
+    final random = Random(23);
+    const specials = [double.nan, double.infinity, double.negativeInfinity, 0.0];
+    double value(double base) => random.nextInt(20) == 0 ? specials[random.nextInt(specials.length)] : base;
+    for (var trial = 0; trial < 3000; trial++) {
+      final n = random.nextInt(12);
+      var t = 0.0;
+      final segments = <TranscriptSegment>[];
+      for (var i = 0; i < n; i++) {
+        // Mostly ordered, sometimes overlapping or out of order.
+        t += random.nextDouble() * 4 - (random.nextInt(6) == 0 ? 5 : 0);
+        segments.add(_segment(i, value(t), value(t + random.nextDouble() * 3)));
+      }
+      expect(TranscriptSegment.canDisplaySeconds(segments), _pairwise(segments), reason: 'trial $trial: $segments');
+    }
+    final ordered = [for (var i = 0; i < 1200; i++) _segment(i, i * 2.0, i * 2.0 + 1.5)];
+    expect(TranscriptSegment.canDisplaySeconds(ordered), isTrue);
+  });
+}
diff --git a/app/test/unit/preferences_string_list_restart_test.dart b/app/test/unit/preferences_string_list_restart_test.dart
new file mode 100644
index 0000000000..f34d49e51f
--- /dev/null
+++ b/app/test/unit/preferences_string_list_restart_test.dart
@@ -0,0 +1,43 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+import 'package:omi/backend/preferences.dart';
+
+/// After a restart, the platform channel hands every stored string list back as `List<Object?>`
+/// (StandardMessageCodec has no typed lists), and `SharedPreferences.get` returns it unconverted.
+/// `setMockInitialValues` with an `<Object?>` list reproduces exactly what a real device loads.
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  Iterable<String> archives(SharedPreferences prefs) => prefs.getKeys().where((k) => k.contains('.corrupt-'));
+
+  test('a string list saved before a restart is read back, not quarantined as a type mismatch', () async {
+    SharedPreferences.setMockInitialValues({
+      'cachedTranscriptionVocabulary': <Object?>['Omi', 'Tailscale'],
+    });
+    await SharedPreferencesUtil.init();
+
+    expect(SharedPreferencesUtil().getStringList('cachedTranscriptionVocabulary'), ['Omi', 'Tailscale']);
+
+    // The quarantine runs unawaited; give it the chance to have run.
+    await Future<void>.delayed(Duration.zero);
+    final prefs = await SharedPreferences.getInstance();
+    expect(prefs.getStringList('cachedTranscriptionVocabulary'), ['Omi', 'Tailscale'],
+        reason: 'the saved list was deleted on read');
+    expect(archives(prefs), isEmpty, reason: 'a valid list was archived as corrupt');
+  });
+
+  test('legacy pending uploads loaded at startup survive the boot schema check', () async {
+    // flash_page_pending_uploads is the pre-WAL Limitless upload queue that
+    // WalFileManager.migrateLegacyLimitlessFiles reads after init. Archived at boot, those
+    // recordings would never be migrated.
+    SharedPreferences.setMockInitialValues({
+      'flash_page_pending_uploads': <Object?>['/docs/audio_limitless_1.bin'],
+    });
+    await SharedPreferencesUtil.init();
+
+    final prefs = await SharedPreferences.getInstance();
+    expect(archives(prefs), isEmpty);
+    expect(SharedPreferencesUtil().getStringList('flash_page_pending_uploads'), ['/docs/audio_limitless_1.bin']);
+  });
+}
